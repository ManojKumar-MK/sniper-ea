//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_LEG                     = 1
BEARISH_LEG                     = 0

BULLISH                         = +1
BEARISH                         = -1

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical'
PRESENT                         = 'Present'

COLORED                         = 'Colored'
MONOCHROME                      = 'Monochrome'

ALL                             = 'All'
BOS                             = 'BOS'
CHOCH                           = 'CHoCH'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal

ATR                             = 'Atr'
RANGE                           = 'Cumulative Mean Range'

CLOSE                           = 'Close'
HIGHLOW                         = 'High/Low'

SOLID                           = '⎯⎯⎯'
DASHED                          = '----'
DOTTED                          = '····'

SMART_GROUP                     = 'Smart Money Concepts'
INTERNAL_GROUP                  = 'Real Time Internal Structure'
SWING_GROUP                     = 'Real Time Swing Structure'
BLOCKS_GROUP                    = 'Order Blocks'
EQUAL_GROUP                     = 'EQH/EQL'
GAPS_GROUP                      = 'Fair Value Gaps'
LEVELS_GROUP                    = 'Highs & Lows MTF'
ZONES_GROUP                     = 'Premium & Discount Zones'

modeTooltip                     = 'Allows to display historical Structure or only the recent ones'
styleTooltip                    = 'Indicator color theme'
showTrendTooltip                = 'Display additional candles with a color reflecting the current trend detected by structure'
showInternalsTooltip            = 'Display internal market structure'
internalFilterConfluenceTooltip = 'Filter non significant internal structure breakouts'
showStructureTooltip            = 'Display swing market Structure'
showSwingsTooltip               = 'Display swing point as labels on the chart'
showHighLowSwingsTooltip        = 'Highlight most recent strong and weak high/low points on the chart'
showInternalOrderBlocksTooltip  = 'Display internal order blocks on the chart\n\nNumber of internal order blocks to display on the chart'
showSwingOrderBlocksTooltip     = 'Display swing order blocks on the chart\n\nNumber of internal swing blocks to display on the chart'
orderBlockFilterTooltip         = 'Method used to filter out volatile order blocks \n\nIt is recommended to use the cumulative mean range method when a low amount of data is available'
orderBlockMitigationTooltip     = 'Select what values to use for order block mitigation'
showEqualHighsLowsTooltip       = 'Display equal highs and equal lows on the chart'
equalHighsLowsLengthTooltip     = 'Number of bars used to confirm equal highs and equal lows'
equalHighsLowsThresholdTooltip  = 'Sensitivity threshold in a range (0, 1) used for the detection of equal highs & lows\n\nLower values will return fewer but more pertinent results'
showFairValueGapsTooltip        = 'Display fair values gaps on the chart'
fairValueGapsThresholdTooltip   = 'Filter out non significant fair value gaps'
fairValueGapsTimeframeTooltip   = 'Fair value gaps timeframe'
fairValueGapsExtendTooltip      = 'Determine how many bars to extend the Fair Value Gap boxes on chart'
showPremiumDiscountZonesTooltip = 'Display premium, discount, and equilibrium zones on chart'

modeInput                       = input.string( HISTORICAL, 'Mode',                     group = SMART_GROUP,    tooltip = modeTooltip, options = [HISTORICAL, PRESENT])
styleInput                      = input.string( COLORED,    'Style',                    group = SMART_GROUP,    tooltip = styleTooltip,options = [COLORED, MONOCHROME])
showTrendInput                  = input(        false,      'Color Candles',            group = SMART_GROUP,    tooltip = showTrendTooltip)

showInternalsInput              = input(        true,       'Show Internal Structure',  group = INTERNAL_GROUP, tooltip = showInternalsTooltip)
showInternalBullInput           = input.string( ALL,        'Bullish Structure',        group = INTERNAL_GROUP, inline = 'ibull', options = [ALL,BOS,CHOCH])
internalBullColorInput          = input(        GREEN,      '',                         group = INTERNAL_GROUP, inline = 'ibull')
showInternalBearInput           = input.string( ALL,        'Bearish Structure' ,       group = INTERNAL_GROUP, inline = 'ibear', options = [ALL,BOS,CHOCH])
internalBearColorInput          = input(        RED,        '',                         group = INTERNAL_GROUP, inline = 'ibear')
internalFilterConfluenceInput   = input(        false,      'Confluence Filter',        group = INTERNAL_GROUP, tooltip = internalFilterConfluenceTooltip)
internalStructureSize           = input.string( TINY,       'Internal Label Size',      group = INTERNAL_GROUP, options = [TINY,SMALL,NORMAL])

showStructureInput              = input(        true,       'Show Swing Structure',     group = SWING_GROUP,    tooltip = showStructureTooltip)
showSwingBullInput              = input.string( ALL,        'Bullish Structure',        group = SWING_GROUP,    inline = 'bull',    options = [ALL,BOS,CHOCH])
swingBullColorInput             = input(        GREEN,      '',                         group = SWING_GROUP,    inline = 'bull')
showSwingBearInput              = input.string( ALL,        'Bearish Structure',        group = SWING_GROUP,    inline = 'bear',    options = [ALL,BOS,CHOCH])
swingBearColorInput             = input(        RED,        '',                         group = SWING_GROUP,    inline = 'bear')
swingStructureSize              = input.string( SMALL,      'Swing Label Size',         group = SWING_GROUP,    options = [TINY,SMALL,NORMAL])
showSwingsInput                 = input(        false,      'Show Swings Points',       group = SWING_GROUP,    tooltip = showSwingsTooltip,inline = 'swings')
swingsLengthInput               = input.int(    50,         '',                         group = SWING_GROUP,    minval = 10,                inline = 'swings')
showHighLowSwingsInput          = input(        true,       'Show Strong/Weak High/Low',group = SWING_GROUP,    tooltip = showHighLowSwingsTooltip)

showInternalOrderBlocksInput    = input(        true,       'Internal Order Blocks' ,   group = BLOCKS_GROUP,   tooltip = showInternalOrderBlocksTooltip,   inline = 'iob')
internalOrderBlocksSizeInput    = input.int(    5,          '',                         group = BLOCKS_GROUP,   minval = 1, maxval = 20,                    inline = 'iob')
showSwingOrderBlocksInput       = input(        false,      'Swing Order Blocks',       group = BLOCKS_GROUP,   tooltip = showSwingOrderBlocksTooltip,      inline = 'ob')
swingOrderBlocksSizeInput       = input.int(    5,          '',                         group = BLOCKS_GROUP,   minval = 1, maxval = 20,                    inline = 'ob') 
orderBlockFilterInput           = input.string( 'Atr',      'Order Block Filter',       group = BLOCKS_GROUP,   tooltip = orderBlockFilterTooltip,          options = [ATR, RANGE])
orderBlockMitigationInput       = input.string( HIGHLOW,    'Order Block Mitigation',   group = BLOCKS_GROUP,   tooltip = orderBlockMitigationTooltip,      options = [CLOSE,HIGHLOW])
internalBullishOrderBlockColor  = input.color(color.new(#3179f5, 80), 'Internal Bullish OB',    group = BLOCKS_GROUP)
internalBearishOrderBlockColor  = input.color(color.new(#f77c80, 80), 'Internal Bearish OB',    group = BLOCKS_GROUP)
swingBullishOrderBlockColor     = input.color(color.new(#1848cc, 80), 'Bullish OB',             group = BLOCKS_GROUP)
swingBearishOrderBlockColor     = input.color(color.new(#b22833, 80), 'Bearish OB',             group = BLOCKS_GROUP)
showOBBreakerInput              = input.bool(false, 'Breaker Blocks (OB break)', group = BLOCKS_GROUP, tooltip = 'When an order block is mitigated, keep it as a breaker recoloured with the break colours below instead of deleting it. Removed only once price fully closes back through the opposite side.')
bullishOBBreakColor             = input.color(color.new(#4785f9, 80), 'Bullish Break', group = BLOCKS_GROUP, inline = 'obbrk')
bearishOBBreakColor             = input.color(color.new(#f9ff57, 80), 'Bearish Break', group = BLOCKS_GROUP, inline = 'obbrk')
obStyleInput     = input.string('Box', 'Order Block Style', group = BLOCKS_GROUP, options = ['Box','Label','Box + Label'], tooltip = 'Box = classic zone rectangle (default, unchanged). Label = a compact OB+ / OB- tag at the block level instead of the rectangle. Box + Label = draw both. This is the enable/disable switch for the label style.')
obLabelBullText  = input.string('OB+', 'Bull / Bear OB label text', group = BLOCKS_GROUP, inline = 'oblbl')
obLabelBearText  = input.string('OB-', '', group = BLOCKS_GROUP, inline = 'oblbl')
obLabelSizeInput = input.string(size.small, 'OB Label Size', group = BLOCKS_GROUP, options = [size.tiny, size.small, size.normal, size.large, size.huge])
showEqualHighsLowsInput         = input(        true,       'Equal High/Low',           group = EQUAL_GROUP,    tooltip = showEqualHighsLowsTooltip)
equalHighsLowsLengthInput       = input.int(    3,          'Bars Confirmation',        group = EQUAL_GROUP,    tooltip = equalHighsLowsLengthTooltip,      minval = 1)
equalHighsLowsThresholdInput    = input.float(  0.1,        'Threshold',                group = EQUAL_GROUP,    tooltip = equalHighsLowsThresholdTooltip,   minval = 0, maxval = 0.5, step = 0.1)
equalHighsLowsSizeInput         = input.string( TINY,       'Label Size',               group = EQUAL_GROUP,    options = [TINY,SMALL,NORMAL])

showFairValueGapsInput          = input(        false,      'Fair Value Gaps',          group = GAPS_GROUP,     tooltip = showFairValueGapsTooltip)
fairValueGapsThresholdInput     = input(        true,       'Auto Threshold',           group = GAPS_GROUP,     tooltip = fairValueGapsThresholdTooltip)
fairValueGapsTimeframeInput     = input.timeframe('',       'Timeframe',                group = GAPS_GROUP,     tooltip = fairValueGapsTimeframeTooltip)
fairValueGapsBullColorInput     = input.color(color.new(#00ff68, 70), 'Bullish FVG' , group = GAPS_GROUP)
fairValueGapsBearColorInput     = input.color(color.new(#ff0008, 70), 'Bearish FVG' , group = GAPS_GROUP)
showFVGBreakInput               = input.bool(false, 'FVG Break (inverse FVG)', group = GAPS_GROUP, tooltip = 'When price trades through a fair value gap, recolour it with the break colours below (inverse FVG) instead of deleting it. Removed once price fully closes past the opposite side.')
fvgBullBreakColor               = input.color(color.new(#808000, 70), 'Bullish FVG Break', group = GAPS_GROUP, inline = 'fvgbrk')
fvgBearBreakColor               = input.color(color.new(#ff0000, 70), 'Bearish FVG Break', group = GAPS_GROUP, inline = 'fvgbrk')
fairValueGapsExtendInput        = input.int(    1,          'Extend FVG',               group = GAPS_GROUP,     tooltip = fairValueGapsExtendTooltip,       minval = 0)

showDailyLevelsInput            = input(        false,      'Daily',    group = LEVELS_GROUP,   inline = 'daily')
dailyLevelsStyleInput           = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'daily',   options = [SOLID,DASHED,DOTTED])
dailyLevelsColorInput           = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'daily')
showWeeklyLevelsInput           = input(        false,      'Weekly',   group = LEVELS_GROUP,   inline = 'weekly')
weeklyLevelsStyleInput          = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'weekly',  options = [SOLID,DASHED,DOTTED])
weeklyLevelsColorInput          = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'weekly')
showMonthlyLevelsInput          = input(        false,      'Monthly',   group = LEVELS_GROUP,   inline = 'monthly')
monthlyLevelsStyleInput         = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'monthly', options = [SOLID,DASHED,DOTTED])
monthlyLevelsColorInput         = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'monthly')
showMidLevelsInput              = input(        true,       '50% Midpoint (PD/PW/PM 50%)', group = LEVELS_GROUP, tooltip = 'Adds the equilibrium / 50% level of the previous day/week/month range (midpoint of PxH and PxL) as a dotted line.')

showPremiumDiscountZonesInput   = input(        false,      'Premium/Discount Zones',   group = ZONES_GROUP , tooltip = showPremiumDiscountZonesTooltip)
premiumZoneColorInput           = input.color(  RED,        'Premium Zone',             group = ZONES_GROUP)
equilibriumZoneColorInput       = input.color(  GRAY,       'Equilibrium Zone',         group = ZONES_GROUP)
discountZoneColorInput          = input.color(  GREEN,      'Discount Zone',            group = ZONES_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox
    bool broken = false

type trend
    int bias    

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime    
    int bias
    bool breaker = false

var pivot swingHigh                 = pivot.new(na,na,false)
var pivot swingLow                  = pivot.new(na,na,false)
var pivot internalHigh              = pivot.new(na,na,false)
var pivot internalLow               = pivot.new(na,na,false)
var pivot equalHigh                 = pivot.new(na,na,false)
var pivot equalLow                  = pivot.new(na,na,false)
var trend swingTrend                = trend.new(0)
var trend internalTrend             = trend.new(0)
var equalDisplay equalHighDisplay   = equalDisplay.new()
var equalDisplay equalLowDisplay    = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<float> parsedHighs        = array.new<float>()
var array<float> parsedLows         = array.new<float>()
var array<float> highs              = array.new<float>()
var array<float> lows               = array.new<float>()
var array<int> times                = array.new<int>()
var trailingExtremes trailing       = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks      = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks   = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes        = array.new<box>()
var array<box> internalOrderBlocksBoxes     = array.new<box>()
var array<label> swingOrderBlocksLabels    = array.new<label>()
var array<label> internalOrderBlocksLabels = array.new<label>()
var swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor        = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor        = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor                = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor               = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput 
varip int currentBarIndex           = bar_index
varip int lastBarIndex              = bar_index
alerts currentAlerts                = alerts.new()
var initialTime                     = time

// we create the needed boxes for displaying order blocks at the first execution
if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))

bearishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure                          = ta.atr(200)
volatilityMeasure                   = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr)/bar_index
highVolatilityBar                   = (high - low) >= (2 * volatilityMeasure)
parsedHigh                          = highVolatilityBar ? low : high
parsedLow                           = highVolatilityBar ? high : low

// we store current values into the arrays at each bar
parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
leg(int size) =>
    var leg     = 0    
    newLegHigh  = high[size] > ta.highest( size)
    newLegLow   = low[size]  < ta.lowest(  size)
    
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)      => ta.change(leg) != 0

startOfBearishLeg(int leg)  => ta.change(leg) == -1

startOfBullishLeg(int leg)  => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>    
    var label l_abel = na

    if modeInput == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    
    string tag          = 'EQL'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'EQH'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    if modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)
        
    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition           = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

getCurrentStructure(int size,bool equalHighLow = false, bool internal = false) =>        
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow    

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure                
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)            
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot,high[size],size,true)
                currentAlerts.equalHighs := true               

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)
                
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>    
    var line l_ine      = line.new(na,na,na,na,xloc = xloc.bar_time)
    var label l_abel    = label.new(na,na)

    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()

    l_ine   := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel  := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size = labelSize)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

    for [index,eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false
        
        if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true
        if crossedOderBlock and not showOBBreakerInput
            orderBlocks.remove(index)
            true
        else if crossedOderBlock and showOBBreakerInput
            eachOrderBlock.breaker := true
            true
        else if showOBBreakerInput and eachOrderBlock.breaker and ((eachOrderBlock.bias == BEARISH and close < eachOrderBlock.barLow) or (eachOrderBlock.bias == BULLISH and close > eachOrderBlock.barHigh))
            orderBlocks.remove(index)
            true

storeOrdeBlock(pivot p_ivot,bool internal = false,int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)

        array<float> a_rray = na
        int parsedIndex = na

        if bias == BEARISH
            a_rray      := parsedHighs.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())  
        else
            a_rray      := parsedLows.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())                        

        orderBlock o_rderBlock          = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex),bias)
        array<orderBlock> orderBlocks   = internal ? internalOrderBlocks : swingOrderBlocks
        
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()
    array<box>   b_oxes  = internal ? internalOrderBlocksBoxes  : swingOrderBlocksBoxes
    array<label> l_abels = internal ? internalOrderBlocksLabels : swingOrderBlocksLabels

    // Recreate boxes AND labels on every draw so they are the NEWEST drawing
    // objects (Pine GCs the oldest first when the 500 pools overflow). Runs only
    // on the last bar, so this is cheap.
    for b in b_oxes
        b.delete()
    b_oxes.clear()
    for lb in l_abels
        lb.delete()
    l_abels.clear()

    if orderBlocksSize > 0
        maxOrderBlocks                      = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks  = orderBlocks.slice(0, math.min(maxOrderBlocks,orderBlocksSize))

        bool drawBox   = obStyleInput == 'Box' or obStyleInput == 'Box + Label'
        bool drawLabel = obStyleInput == 'Label' or obStyleInput == 'Box + Label'

        for [index,eachOrderBlock] in parsedOrdeBlocks
            baseOBColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)
            orderBlockColor = (showOBBreakerInput and eachOrderBlock.breaker) ? (eachOrderBlock.bias == BULLISH ? bullishOBBreakColor : bearishOBBreakColor) : baseOBColor

            if drawBox
                box b_ox = box.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
                b_ox.set_top_left_point(    chart.point.new(eachOrderBlock.barTime,na,eachOrderBlock.barHigh))
                b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,eachOrderBlock.barLow))
                b_ox.set_border_color(      internal ? na : orderBlockColor)
                b_ox.set_bgcolor(           orderBlockColor)
                b_oxes.push(b_ox)

            if drawLabel
                bool   isBull   = eachOrderBlock.bias == BULLISH
                float  midPrice = math.avg(eachOrderBlock.barHigh, eachOrderBlock.barLow)
                string obTxt    = isBull ? obLabelBullText : obLabelBearText
                color  lblCol   = color.new(orderBlockColor, 0)   // solid version of the OB colour (strips the box transparency)
                // anchor at the ORIGIN candle of the block (start of the box); tag sits at that
                // candle with its pointer on the right, body to the left, so it marks the start.
                label lb = label.new(x = eachOrderBlock.barTime, y = midPrice, text = obTxt, xloc = xloc.bar_time, style = label.style_label_left, color = lblCol, textcolor = color.white, size = obLabelSizeInput)
                l_abels.push(lb)
displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    
    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize

    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    if ta.crossover(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBullishCHoCH  := tag == CHOCH
            currentAlerts.internalBullishBOS    := tag == BOS
        else
            currentAlerts.swingBullishCHoCH     := tag == CHOCH
            currentAlerts.swingBullishBOS       := tag == BOS

        p_ivot.crossed  := true
        t_rend.bias     := BULLISH

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition                        
            drawStructure(p_ivot,tag,bullishColor,lineStyle,label.style_label_down,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BULLISH)

    p_ivot          := internal ? internalLow : swingLow    
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if ta.crossunder(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBearishCHoCH  := tag == CHOCH
            currentAlerts.internalBearishBOS    := tag == BOS
        else
            currentAlerts.swingBearishCHoCH     := tag == CHOCH
            currentAlerts.swingBearishBOS       := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BEARISH

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        
        if displayCondition                        
            drawStructure(p_ivot,tag,bearishColor,lineStyle,label.style_label_up,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BEARISH)

fairValueGapBox(leftTime,rightTime,topPrice,bottomPrice,boxColor) => box.new(chart.point.new(leftTime,na,topPrice),chart.point.new(rightTime + fairValueGapsExtendInput * (time-time[1]),na,bottomPrice), xloc=xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

deleteFairValueGaps() =>
    for [index,eachFairValueGap] in fairValueGaps
        bool crossedFVG = (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
        if crossedFVG and showFVGBreakInput and not eachFairValueGap.broken
            eachFairValueGap.broken := true
            fvgBreakColor = eachFairValueGap.bias == BULLISH ? fvgBullBreakColor : fvgBearBreakColor
            eachFairValueGap.topBox.set_bgcolor(fvgBreakColor)
            eachFairValueGap.topBox.set_border_color(fvgBreakColor)
            eachFairValueGap.bottomBox.set_bgcolor(fvgBreakColor)
            eachFairValueGap.bottomBox.set_border_color(fvgBreakColor)
            true
        else if crossedFVG and not showFVGBreakInput
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)
            true
        else if showFVGBreakInput and eachFairValueGap.broken and ((eachFairValueGap.bias == BULLISH and close > eachFairValueGap.top) or (eachFairValueGap.bias == BEARISH and close < eachFairValueGap.bottom))
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)
            true
    // safety cap so active + broken gaps can't grow past the box budget
    while fairValueGaps.size() > 30
        oldFVG = fairValueGaps.pop()
        oldFVG.topBox.delete()
        oldFVG.bottomBox.delete()
    
drawFairValueGaps() => 
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]],lookahead = barmerge.lookahead_on)

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow,last2High,BULLISH,fairValueGapBox(lastTime,currentTime,currentLow,math.avg(currentLow,last2High),fairValueGapBullishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentLow,last2High),last2High,fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh,last2Low,BEARISH,fairValueGapBox(lastTime,currentTime,currentHigh,math.avg(currentHigh,last2Low),fairValueGapBearishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentHigh,last2Low),last2Low,fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time],lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel    

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray        = times.slice(leftIndex,rightIndex)
        array<float> topArray       = highs.slice(leftIndex,rightIndex)
        array<float> bottomArray    = lows.slice(leftIndex,rightIndex)

        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line midLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = line.style_dotted)
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label midLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}50%',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(    chart.point.new(parsedTopTime,na,parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))   
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))

    bottomLine.set_first_point( chart.point.new(parsedBottomTime,na,parsedBottom))    
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))

    // 50% / equilibrium midpoint of the previous period range
    float parsedMid = math.avg(parsedTop, parsedBottom)
    if showMidLevelsInput
        midLine.set_first_point(    chart.point.new(parsedLeftTime, na, parsedMid))
        midLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedMid))
        midLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedMid))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high,trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color=color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color=color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar            = last_bar_time + 20 * (time - time[1])

    topLine.set_first_point(    chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(          swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

    bottomLine.set_first_point( chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(       swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(    chart.point.new(trailing.barTime,na,top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))

    l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)

    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen,high,low,close,color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()

    if showHighLowSwingsInput
        drawHighLowSwings()

    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()

if showFairValueGapsInput
    deleteFairValueGaps()

getCurrentStructure(swingsLengthInput,false)
getCurrentStructure(5,false,true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput,true)

if showInternalsInput or showInternalOrderBlocksInput or showTrendInput
    displayStructure(true)

if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
    displayStructure()

if showInternalOrderBlocksInput
    deleteOrderBlocks(true)

if showSwingOrderBlocksInput
    deleteOrderBlocks()

if showFairValueGapsInput
    drawFairValueGaps()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput        
        drawOrderBlocks(true)
        
    if showSwingOrderBlocksInput        
        drawOrderBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D',timeframe.isdaily,dailyLevelsStyleInput,dailyLevelsColorInput)

    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W',timeframe.isweekly,weeklyLevelsStyleInput,weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M',timeframe.ismonthly,monthlyLevelsStyleInput,monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
//ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(currentAlerts.swingBullishBOS,           'Bullish BOS',                  'Internal Bullish BOS formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Bullish CHoCH',                'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.swingBearishBOS,           'Bearish BOS',                  'Bearish BOS formed')
alertcondition(currentAlerts.swingBearishCHoCH,         'Bearish CHoCH',                'Bearish CHoCH formed')

alertcondition(currentAlerts.internalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Price broke bearish swing OB')

alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')

alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')


//
//
//
//═════════════════════════════════════════════════════════════════════════════
//                    MODULE  —  KhanSaab Sniper V.02
//                    © KhanSaab 2026 — toggleable module
//                    + Trade Log (entry history)
//                    + Dashboard TP1→TP5 rows          (ADDED)
//                    + Trade Log SL column             (ADDED)
//                    + Day P/L — running daily pips     (ADDED)
//═════════════════════════════════════════════════════════════════════════════
SNIPER_GROUP     = 'Sniper Module ⚡'
enableSniper     = input.bool(false, 'Enable Sniper Module', group = SNIPER_GROUP, tooltip = 'Master switch for the KhanSaab Sniper layer (EMA-cross signals, SL/TP lines, score dashboard, EMA ribbon, VWAP).')

groupSniperInfo  = 'Sniper — Info & Disclaimer'
_sniperDisc      = input.text_area('Trading financial markets involves substantial risk of loss and is not suitable for every investor. The signals, indicators, and content provided by this module are purely for educational purposes and do not constitute financial or investment advice.', 'Disclaimer Notice', group = groupSniperInfo)
_sniperTfRec     = input.string('3 / 5 / 15 Minutes', 'Scalping Timeframe', group = groupSniperInfo, tooltip = 'Best suited for 3-minute, 5-minute, or 15-minute timeframes.')

groupSniperVis   = 'Sniper — Visuals & UI'
showSniperDash   = input.bool(true,  'Show Score Dashboard',  group = groupSniperVis)
showSniperRibbon = input.bool(true,  'Show EMA Ribbon (9/21/50)', group = groupSniperVis)
showSniperVwap   = input.bool(true,  'Show VWAP',             group = groupSniperVis)
showSniperTrades = input.bool(true,  'Show Signals & SL/TP',  group = groupSniperVis)
dashPosInput     = input.string('Top Right', 'Dashboard Position', options = ['Top Left','Top Right','Middle Left','Middle Right','Bottom Left','Bottom Right'], group = groupSniperVis)
dashTextSize     = input.string('small',  'Dashboard Font Size', options = ['tiny','small','normal','large','huge'], group = groupSniperVis)
tradeTextSize    = input.string('normal', 'Trade Label Size',    options = ['tiny','small','normal','large','huge'], group = groupSniperVis)
tradeDisplayInput = input.string('Dashboard', 'Entry/SL/TP levels', options = ['Chart','Dashboard','Both'], group = groupSniperVis, tooltip = 'Where to show the active trade Entry / SL / TP levels.')
sniperSignalSize = input.string(size.small, 'BUY / SELL Label Size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = groupSniperVis)
sniperSigStyle   = input.string('Label', 'BUY / SELL marker style', options = ['Label','Triangle'], group = groupSniperVis, tooltip = 'Label = BUY/SELL text tags. Triangle = a plain triangle below/above the bar.')
ribbonOpacity    = input.int(50, 'EMA Ribbon Opacity', minval = 0, maxval = 100, group = groupSniperVis)
labelOffsetBars  = input.int(10, 'Label Right Offset (Bars)', minval = 2, maxval = 100, group = groupSniperVis, tooltip = 'How far to the right of live candles the price tags project.')

groupSniperRisk  = 'Sniper — Risk Management'
atrMultiplier    = input.float(2.0, 'SL ATR Multiplier', minval = 0.1, step = 0.1, group = groupSniperRisk)

//───────────────────────────────────────────────────────────────────────────
// Trade Log settings
//───────────────────────────────────────────────────────────────────────────
LOG_GROUP        = 'Sniper — Trade Log 🧾'
showTradeLog     = input.bool(true, 'Show Trade Log', group = LOG_GROUP, tooltip = 'A running history of past entries: time, direction, entry price, stop and outcome (which TP or SL was hit). A trade is written to the log when a new signal replaces it, or when it closes on SL / TP5.')
logPosInput      = input.string('Bottom Right', 'Trade Log Position', options = ['Top Left','Top Right','Middle Left','Middle Right','Bottom Left','Bottom Right'], group = LOG_GROUP, tooltip = "Keep this different from the Dashboard position so the two tables don't overlap.")
logTextSize      = input.string('small', 'Trade Log Font Size', options = ['tiny','small','normal','large','huge'], group = LOG_GROUP)
logTz            = input.string('Asia/Kolkata', 'Trade Log timezone', options = ['Asia/Kolkata','America/New_York','Europe/London','Asia/Tokyo','UTC','Exchange'], group = LOG_GROUP, tooltip = "Timezone the log's Time column AND the Day P/L day-boundary are read in. 'Exchange' follows the symbol's own timezone. Default IST.")
logMaxRows       = input.int(8, 'Max Log Rows', minval = 1, maxval = 30, group = LOG_GROUP, tooltip = 'How many recent trades to display (most recent first).')
logShowLive      = input.bool(true, 'Show live trade at top', group = LOG_GROUP, tooltip = 'Pin the currently-open trade as the first row, marked ●.')
tagChartOutcome  = input.bool(true, 'Tag outcome on chart signal', group = LOG_GROUP, tooltip = 'Append a 💣 (SL) or 🚀 (TP5) icon onto the BUY/SELL label once that trade resolves.')
// enable / disable — columns
logColTime       = input.bool(true, 'Column: Time',  inline = 'lcol', group = LOG_GROUP)
logColEntry      = input.bool(true, 'Column: Entry', inline = 'lcol', group = LOG_GROUP)
logColSl         = input.bool(true, 'Column: SL',    inline = 'lcol', group = LOG_GROUP, tooltip = 'Direction and Result columns are always shown; Time, Entry, SL and Result value can each be turned off to make the log narrower.')  // ADDED
logColExit       = input.bool(true, 'Column: Result value (Exit price)', group = LOG_GROUP, tooltip = "Show the price of the level the Result refers to — the TP price for a TP result, the stop price for an SL, blank (—) for a flat/flip. Sits next to Entry and SL.")  // ADDED
logShowDaySum    = input.bool(true, 'Show Day P/L footer', group = LOG_GROUP, tooltip = 'Adds a footer row to the log summing the realized pips for the current day (net, with a win/loss count).')  // ADDED
// enable / disable — what gets logged
logResultFilter  = input.string('All', 'Log filter', options = ['All','Wins only','Losses only'], group = LOG_GROUP, tooltip = 'All = every logged trade. Wins only = trades that reached a TP with no stop-out. Losses only = trades that hit SL.')
logIncludeFlips  = input.bool(true, 'Log trades that flipped early', group = LOG_GROUP, tooltip = 'ON = also record a trade when a new signal replaces it before it hit SL or TP5. OFF = only record trades that actually closed on SL or TP5.')

//───────────────────────────────────────────────────────────────────────────
// ADDED — Day P/L settings
//───────────────────────────────────────────────────────────────────────────
DAY_GROUP        = 'Sniper — Day P/L 📈'
pipSize          = input.float(0.1, 'Pip size (price per pip)', minval = 0.0001, step = 0.01, group = DAY_GROUP, tooltip = 'Price distance that equals 1 pip — used to convert each trade result into pips. XAUUSD: 0.1 is common ($0.10 = 1 pip). Set 1.0 to count whole dollars, 0.01 for points/cents. FX majors ≈ 0.0001. Day boundary uses the Trade Log timezone.')

//───────────────────────────────────────────────────────────────────────────
// Signal Quality Filter (each condition is its own checkbox)
//───────────────────────────────────────────────────────────────────────────
QF_GROUP         = 'Sniper — Signal Quality Filter 🎯'
enableQFilter    = input.bool(false, 'Enable Signal Quality Filter', group = QF_GROUP, tooltip = 'Master switch. OFF = every EMA9/21 cross prints an arrow (original behaviour). ON = an arrow only prints when the ticked conditions below all agree, so the consolidation crosses are suppressed. Tick only the filters you want.')
qfTrend          = input.bool(true,  'Require trend — ADX ≥', inline = 'qf1', group = QF_GROUP, tooltip = 'STRONGEST filter. Blocks signals while the market is ranging (low ADX). This alone removes most consolidation noise.')
adxMin           = input.float(25.0, '', inline = 'qf1', minval = 0, group = QF_GROUP)
qfStruct         = input.bool(true,  'Require EMA structure — |EMA21−EMA50| ≥ ×ATR', inline = 'qf2', group = QF_GROUP, tooltip = 'Strong. In a range EMA21 and EMA50 sit on top of each other; this demands real separation (an actual trend), measured in ATRs.')
structMult       = input.float(0.5,  '', inline = 'qf2', minval = 0, step = 0.1, group = QF_GROUP)
qfEma50          = input.bool(true,  'Require price on trend side of EMA50', group = QF_GROUP, tooltip = 'Longs only when close is above EMA50, shorts only when below. Keeps you with the higher trend.')
qfVwap           = input.bool(true,  'Require VWAP alignment', group = QF_GROUP, tooltip = 'Longs only above VWAP, shorts only below. Good intraday filter for gold.')
qfBias           = input.bool(false, 'Require strong bias score ≥', inline = 'qf3', group = QF_GROUP, tooltip = 'Optional. Demands the dashboard B/S score strongly favour the signal side. Can be restrictive.')
biasMin          = input.float(70.0, '', inline = 'qf3', minval = 0, maxval = 100, group = QF_GROUP)
qfVolume         = input.bool(false, 'Require volume > average', group = QF_GROUP, tooltip = 'Optional. Only take crosses backed by above-average volume. Unreliable on some spot/FX feeds with poor volume data.')
qfCooldown       = input.bool(true,  'Cooldown — min bars since last signal', inline = 'qf4', group = QF_GROUP, tooltip = 'Stops rapid flip-flop: a new arrow cannot print within this many bars of the previous one.')
cooldownBars     = input.int(5,      '', inline = 'qf4', minval = 0, group = QF_GROUP)

DASHROWS_GROUP   = 'Dashboard — Rows (on/off)'
showBiasRow      = input.bool(true,  'BIAS',      inline = 'dr1', group = DASHROWS_GROUP)
showScoreRow     = input.bool(true,  'B / S %',   inline = 'dr1', group = DASHROWS_GROUP)
showStatusRow    = input.bool(true,  'Status',    inline = 'dr2', group = DASHROWS_GROUP)
showVwapRow      = input.bool(true,  'VWAP',      inline = 'dr2', group = DASHROWS_GROUP)
showRsiRow       = input.bool(true,  'RSI',       inline = 'dr3', group = DASHROWS_GROUP)
showMacdRow      = input.bool(true,  'MACD',      inline = 'dr3', group = DASHROWS_GROUP)
showEmaRow       = input.bool(true,  'EMA 9/21',  inline = 'dr4', group = DASHROWS_GROUP)
showAdxRow       = input.bool(true,  'ADX',       inline = 'dr4', group = DASHROWS_GROUP)
showAtrVolRow    = input.bool(true,  'ATR·Vol',   inline = 'dr5', group = DASHROWS_GROUP)
showNewsRow      = input.bool(true,  'News',      inline = 'dr5', group = DASHROWS_GROUP)
showTradeRow     = input.bool(true,  'Trade (Entry/SL/TP1-5)', inline = 'dr6', group = DASHROWS_GROUP)  // ALTERED label
showMarketRow    = input.bool(true,  'Market (regime)',        inline = 'dr6', group = DASHROWS_GROUP)
showDayRow       = input.bool(true,  'Day P/L (pips)',         inline = 'dr7', group = DASHROWS_GROUP)  // ADDED

NEWS_GROUP       = 'Dashboard — News (manual times)'
newsTz           = input.string('Asia/Kolkata', 'News timezone', options = ['Asia/Kolkata','America/New_York','Europe/London','Asia/Tokyo','UTC'], group = NEWS_GROUP, tooltip = 'Timezone the event windows below are read in. Default IST.')
newsShade        = input.bool(false, 'Shade chart background during a news window', group = NEWS_GROUP)
newsCss          = input.color(color.new(color.red, 90), 'News shade colour', group = NEWS_GROUP)
newsEn1          = input.bool(true,  'Event 1', inline = 'n1', group = NEWS_GROUP)
newsSess1        = input.session('1800-1815', '', inline = 'n1', group = NEWS_GROUP)
newsEn2          = input.bool(false, 'Event 2', inline = 'n2', group = NEWS_GROUP)
newsSess2        = input.session('2000-2015', '', inline = 'n2', group = NEWS_GROUP)
newsEn3          = input.bool(false, 'Event 3', inline = 'n3', group = NEWS_GROUP)
newsSess3        = input.session('2300-2315', '', inline = 'n3', group = NEWS_GROUP)

f_getDashPos(string _pos) =>
    switch _pos
        'Top Left'     => position.top_left
        'Top Right'    => position.top_right
        'Middle Left'  => position.middle_left
        'Middle Right' => position.middle_right
        'Bottom Left'  => position.bottom_left
        'Bottom Right' => position.bottom_right
        => position.top_right

f_addDashRow(table _table, int _row, string _title, string _val, color _col, string _size) =>
    table.cell(_table, 0, _row, _title, text_color = color.black, text_halign = text.align_left,  text_size = _size)
    table.cell(_table, 1, _row, _val,   text_color = _col,        text_halign = text.align_right, text_size = _size)

// turn a trade's hit-flags into a human-readable outcome string.
// SL shows how far it ran first, e.g. "SL 💣 (TP2)"; a clean win shows "TP5 🚀".
f_tradeResult(bool _sl, bool _t1, bool _t2, bool _t3, bool _t4, bool _t5) =>
    string _best = _t5 ? 'TP5' : _t4 ? 'TP4' : _t3 ? 'TP3' : _t2 ? 'TP2' : _t1 ? 'TP1' : ''
    _sl ? ('SL 💣' + (_best != '' ? ' (' + _best + ')' : '')) : (_t5 ? 'TP5 🚀' : (_best != '' ? _best : 'flat ↷'))

// ADDED — realized pips for one trade, in R-multiples × (risk / pipSize).
// Risk is recovered from |entry − SL|. SL takes priority (a stopped trade = −1R
// no matter how far it ran); otherwise credit the highest TP the result names.
f_tradePips(string _res, float _ent, float _sl, float _pip) =>
    float _R    = math.abs(_ent - _sl)
    float _mult = str.contains(_res, 'SL') ? -1.0 : str.contains(_res, 'TP5') ? 5.0 : str.contains(_res, 'TP4') ? 4.0 : str.contains(_res, 'TP3') ? 3.0 : str.contains(_res, 'TP2') ? 2.0 : str.contains(_res, 'TP1') ? 1.0 : 0.0
    _pip > 0.0 ? (_mult * _R / _pip) : 0.0

// ADDED — the price of the level a result refers to: SL price for a stop-out,
// the TPn price for a TP result (rebuilt from entry, risk and direction), or na
// for a flat/flipped trade that never hit a level.
f_resultPrice(string _res, float _ent, float _sl, int _dir) =>
    float _R = math.abs(_ent - _sl)
    float _n = str.contains(_res, 'TP5') ? 5.0 : str.contains(_res, 'TP4') ? 4.0 : str.contains(_res, 'TP3') ? 3.0 : str.contains(_res, 'TP2') ? 2.0 : str.contains(_res, 'TP1') ? 1.0 : 0.0
    str.contains(_res, 'SL') ? _sl : (_n > 0.0 ? (_dir == 1 ? _ent + _n * _R : _ent - _n * _R) : na)

// place a log cell only if its column is enabled (_col == -1 means off)
f_logCell(table _t, int _col, int _row, string _txt, color _tc, color _bg, string _sz, string _ha) =>
    if _col >= 0
        table.cell(_t, _col, _row, _txt, text_color = _tc, bgcolor = _bg, text_size = _sz, text_halign = _ha)

// does a trade's result pass the Log filter?
f_passFilter(string _res, string _filter) =>
    _filter == 'Wins only'   ? (str.contains(_res, 'TP') and not str.contains(_res, 'SL')) : _filter == 'Losses only' ? str.contains(_res, 'SL') : true

ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
vwapV  = ta.vwap(hlc3)
atr    = ta.atr(14)
rsiVal = ta.rsi(close, 14)
rsi5m  = request.security(syminfo.tickerid, '5', ta.rsi(close[1], 14), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

[m, s, macdHist]       = ta.macd(close, 12, 26, 9)
[plusDI, minusDI, adx] = ta.dmi(14, 14)
volAvg = ta.sma(volume, 20)

float bScore = 0.0
if close > vwapV
    bScore += 1.0
if rsiVal > 50
    bScore += 1.0
if m > s
    bScore += 1.0
if ema9 > ema21
    bScore += 1.0
if adx > 25 and close > ema9
    bScore += 1.0
if volume > volAvg and close > open
    bScore += 1.0
if rsi5m > 50
    bScore += 1.0
float bullPct = (bScore / 7.0) * 100.0

float rScore = 0.0
if close < vwapV
    rScore += 1.0
if rsiVal < 50
    rScore += 1.0
if m < s
    rScore += 1.0
if ema9 < ema21
    rScore += 1.0
if adx > 25 and close < ema9
    rScore += 1.0
if volume > volAvg and close < open
    rScore += 1.0
if rsi5m < 50
    rScore += 1.0
float bearPct = (rScore / 7.0) * 100.0

string biasText = (bullPct - bearPct) >= 40.0 ? 'STRONG BULL' : (bearPct - bullPct) >= 40.0 ? 'STRONG BEAR' : (bullPct > bearPct ? 'MILD BULL' : 'MILD BEAR')
color biasCol   = biasText == 'STRONG BULL' ? color.green : (biasText == 'STRONG BEAR' ? color.red : color.gray)

var int lastSignalState = 0
var int signalBarIdx    = 0
var int entryTime       = 0        // timestamp of the current entry (for the log)
var float entryP = 0.0
var float slP = 0.0
var float t1 = 0.0
var float t2 = 0.0
var float t3 = 0.0
var float t4 = 0.0
var float t5 = 0.0

// persistent reference to the current BUY/SELL chart label (for outcome tagging)
var label curSigLabel = na

// the trade log store (oldest → newest). Capped to keep memory bounded.
var array<int>    logTimeArr  = array.new_int()
var array<int>    logDirArr   = array.new_int()      //  1 = long, -1 = short
var array<float>  logEntryArr = array.new_float()
var array<float>  logSlArr    = array.new_float()    // ADDED — stop price per trade
var array<string> logResArr   = array.new_string()

buyCond     = ta.crossover(ema9, ema21)
sellCond    = ta.crossunder(ema9, ema21)

// Signal Quality Filter: each enabled condition must agree for the cross to
// count. A disabled condition (checkbox off) passes automatically.
bool _qTrend  = not qfTrend    or adx >= adxMin
bool _qStruct = not qfStruct   or math.abs(ema21 - ema50) >= (structMult * atr)
bool _qVolume = not qfVolume   or volume > volAvg
bool _qCool   = not qfCooldown or (bar_index - signalBarIdx) >= cooldownBars
bool _qCommon = _qTrend and _qStruct and _qVolume and _qCool
bool _qLong   = _qCommon and (not qfEma50 or close > ema50) and (not qfVwap or close > vwapV) and (not qfBias or bullPct >= biasMin)
bool _qShort  = _qCommon and (not qfEma50 or close < ema50) and (not qfVwap or close < vwapV) and (not qfBias or bearPct >= biasMin)
bool qualityLong  = not enableQFilter or _qLong
bool qualityShort = not enableQFilter or _qShort

triggerBuy  = buyCond and lastSignalState <= 0 and qualityLong
triggerSell = sellCond and lastSignalState >= 0 and qualityShort

// Hit-flags are declared here so the snapshot below can read the OUTGOING
// trade's final state before a fresh signal resets them further down.
var bool slHit = false
var bool t1Hit = false
var bool t2Hit = false
var bool t3Hit = false
var bool t4Hit = false
var bool t5Hit = false
var bool tradeClosed = false   // true once SL or TP5 first hits; freezes the trade

// snapshot the outgoing trade into the log BEFORE the new signal
// overwrites entryP / lastSignalState / hit-flags.
bool _outgoingResolved = slHit or t5Hit
if (triggerBuy or triggerSell) and lastSignalState != 0 and (logIncludeFlips or _outgoingResolved)
    array.push(logTimeArr,  entryTime)
    array.push(logDirArr,   lastSignalState)
    array.push(logEntryArr, entryP)
    array.push(logSlArr,    slP)                 // ADDED
    array.push(logResArr,   f_tradeResult(slHit, t1Hit, t2Hit, t3Hit, t4Hit, t5Hit))
    if array.size(logDirArr) > 60
        array.shift(logTimeArr)
        array.shift(logDirArr)
        array.shift(logEntryArr)
        array.shift(logSlArr)                    // ADDED
        array.shift(logResArr)

if triggerBuy or triggerSell
    lastSignalState := triggerBuy ? 1 : -1
    signalBarIdx    := bar_index
    entryTime       := time
    entryP          := close
    float risk      = atr * atrMultiplier
    slP := triggerBuy ? (entryP - risk) : (entryP + risk)
    t1  := triggerBuy ? (entryP + (risk * 1.0)) : (entryP - (risk * 1.0))
    t2  := triggerBuy ? (entryP + (risk * 2.0)) : (entryP - (risk * 2.0))
    t3  := triggerBuy ? (entryP + (risk * 3.0)) : (entryP - (risk * 3.0))
    t4  := triggerBuy ? (entryP + (risk * 4.0)) : (entryP - (risk * 4.0))
    t5  := triggerBuy ? (entryP + (risk * 5.0)) : (entryP - (risk * 5.0))

//-----------------------------------------------------------------------------}
// SL/TP hit detection: latch on FIRST real touch, trade closes on first SL or
// TP5 hit.
//-----------------------------------------------------------------------------{

// fresh signal clears everything for the new trade
if triggerBuy or triggerSell
    slHit := false, t1Hit := false, t2Hit := false
    t3Hit := false, t4Hit := false, t5Hit := false
    tradeClosed := false

// latch levels only while the trade is still live (TPs checked before SL, so an
// ambiguous bar that spans both still registers the TP, then closes the trade)
if not tradeClosed and lastSignalState == 1 and bar_index >= signalBarIdx
    if high >= t1
        t1Hit := true
    if high >= t2
        t2Hit := true
    if high >= t3
        t3Hit := true
    if high >= t4
        t4Hit := true
    if high >= t5
        t5Hit := true
    if low  <= slP
        slHit := true
    if slHit or t5Hit
        tradeClosed := true
else if not tradeClosed and lastSignalState == -1 and bar_index >= signalBarIdx
    if low  <= t1
        t1Hit := true
    if low  <= t2
        t2Hit := true
    if low  <= t3
        t3Hit := true
    if low  <= t4
        t4Hit := true
    if low  <= t5
        t5Hit := true
    if high >= slP
        slHit := true
    if slHit or t5Hit
        tradeClosed := true

// the moment a trade closes on SL/TP5, tag its chart label with an icon.
if enableSniper and tagChartOutcome and tradeClosed and not tradeClosed[1] and not na(curSigLabel)
    label.set_text(curSigLabel, label.get_text(curSigLabel) + (slHit ? ' 💣' : ' 🚀'))

bool nearEntry = math.abs(close - entryP) <= (atr * 1.0)
bool isRetest = nearEntry and ((lastSignalState == 1 and low <= ema9 and low > ema21) or (lastSignalState == -1 and high >= ema9 and high < ema21))

string dashStatus = 'WAIT'
color dashStatusColor = color.black

if triggerBuy or triggerSell
    dashStatus := 'ENTERED'
    dashStatusColor := color.blue
else if slHit or t5Hit
    dashStatus := 'EXIT'
    dashStatusColor := slHit ? color.red : color.green
else if lastSignalState != 0
    if isRetest or adx < 20
        dashStatus := 'EXHAUSTED'
        dashStatusColor := color.orange
    else
        dashStatus := 'HOLD'
        dashStatusColor := color.green

buySig  = enableSniper and showSniperTrades and triggerBuy
sellSig = enableSniper and showSniperTrades and triggerSell
buyStyle   = sniperSigStyle == 'Triangle' ? label.style_none : label.style_label_up
sellStyle  = sniperSigStyle == 'Triangle' ? label.style_none : label.style_label_down
buyTxt     = sniperSigStyle == 'Triangle' ? '▲' : 'BUY'
sellTxt    = sniperSigStyle == 'Triangle' ? '▼' : 'SELL'
buyTxtCol  = sniperSigStyle == 'Triangle' ? color.green : color.white
sellTxtCol = sniperSigStyle == 'Triangle' ? color.red   : color.white
buyBgCol   = sniperSigStyle == 'Triangle' ? na : color.green
sellBgCol  = sniperSigStyle == 'Triangle' ? na : color.red
if buySig
    curSigLabel := label.new(bar_index, na, buyTxt,  xloc = xloc.bar_index, yloc = yloc.belowbar, color = buyBgCol,  textcolor = buyTxtCol,  style = buyStyle,  size = sniperSignalSize)
if sellSig
    curSigLabel := label.new(bar_index, na, sellTxt, xloc = xloc.bar_index, yloc = yloc.abovebar, color = sellBgCol, textcolor = sellTxtCol, style = sellStyle, size = sniperSignalSize)

newsNow = (newsEn1 and not na(time(timeframe.period, newsSess1, newsTz))) or (newsEn2 and not na(time(timeframe.period, newsSess2, newsTz))) or (newsEn3 and not na(time(timeframe.period, newsSess3, newsTz)))

string regimeTxt = adx >= 25 ? (plusDI >= minusDI ? 'Trending ▲' : 'Trending ▼') : adx < 20 ? 'Choppy' : 'Transition'
color  regimeCol = adx >= 25 ? (plusDI >= minusDI ? color.green : color.red) : adx < 20 ? color.gray : color.orange

//───────────────────────────────────────────────────────────────────────────
// ADDED — Day P/L: realized pips from trades logged on the current day, plus
// the current trade if it has already resolved (SL/TP5) but not yet flipped
// into the log. Day boundary is read in the Trade Log timezone.
//───────────────────────────────────────────────────────────────────────────
string _dayTz  = logTz == 'Exchange' ? syminfo.timezone : logTz
float  dayPips = 0.0
int    dayWins = 0
int    dayLoss = 0
if enableSniper and barstate.islast
    string _todayKey = str.format_time(time, 'yyyy-MM-dd', _dayTz)
    if array.size(logDirArr) > 0
        for i = 0 to array.size(logDirArr) - 1
            if str.format_time(array.get(logTimeArr, i), 'yyyy-MM-dd', _dayTz) == _todayKey
                float _p = f_tradePips(array.get(logResArr, i), array.get(logEntryArr, i), array.get(logSlArr, i), pipSize)
                dayPips += _p
                dayWins := _p > 0.0 ? dayWins + 1 : dayWins
                dayLoss := _p < 0.0 ? dayLoss + 1 : dayLoss
    // current trade counted the moment it resolves, before it flips into the log
    if lastSignalState != 0 and tradeClosed and str.format_time(entryTime, 'yyyy-MM-dd', _dayTz) == _todayKey
        float _pc = f_tradePips(f_tradeResult(slHit, t1Hit, t2Hit, t3Hit, t4Hit, t5Hit), entryP, slP, pipSize)
        dayPips += _pc
        dayWins := _pc > 0.0 ? dayWins + 1 : dayWins
        dayLoss := _pc < 0.0 ? dayLoss + 1 : dayLoss
string dayPipsStr = (dayPips >= 0.0 ? '+' : '') + str.tostring(dayPips, '#.#') + ' p  (' + str.tostring(dayWins) + 'W/' + str.tostring(dayLoss) + 'L)'
color  dayPipsCol = dayPips > 0.0 ? color.green : dayPips < 0.0 ? color.red : color.gray

//───────────────────────────────────────────────────────────────────────────
//  KILLZONE RANGES  —  the high and low each session actually made
//
//  The layer further down SHADES the killzones. Shading tells you when; it
//  never tells you where, and where is the part you trade against: the Asian
//  range high and low are the pools London raids, and London's are what New
//  York runs. Those three pairs of numbers belong on the dashboard, not in a
//  colour wash you have to measure by eye.
//
//  Anchored to NEW YORK so US daylight saving is handled per bar. The windows
//  are the classic ICT ones; change them here and the dashboard follows.
//───────────────────────────────────────────────────────────────────────────
KZR_GROUP  = 'Killzone ranges (dashboard) 📐'
kzrOn      = input.bool(true, 'Show killzone highs / lows on the dashboard', group = KZR_GROUP, tooltip = 'Tracks the high and low each session made and prints them as three rows. Recording only - it places nothing and blocks nothing.')
kzrTz      = input.string('America/New_York', 'Read the windows in', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], group = KZR_GROUP, tooltip = 'One clock for all three windows, so they cannot drift apart. New York is the ICT convention and handles US daylight saving automatically.')
kzrAsSess  = input.session('1900-2400', 'Asian range',     group = KZR_GROUP, tooltip = '19:00-24:00 New York = 04:30-09:30 IST in US summer, 05:30-10:30 in US winter. Quiet accumulation; its high and low are the liquidity London raids.')
kzrLdnSess = input.session('0200-0500', 'London killzone', group = KZR_GROUP, tooltip = '02:00-05:00 New York = 11:30-14:30 IST summer, 12:30-15:30 winter.')
kzrNySess  = input.session('0700-1000', 'New York session',group = KZR_GROUP, tooltip = '07:00-10:00 New York = 16:30-19:30 IST summer, 17:30-20:30 winter. Widen to 0700-1600 if you want the whole cash session rather than the killzone.')
kzrMid     = input.bool(false, 'Also show the 50% of each range', group = KZR_GROUP, tooltip = 'The midpoint is the equilibrium of that session - ICT treats the Asian range 50% as the reference price the day opens around. Off by default to keep the panel short; it is always in the row tooltip.')
kzrDays    = input.int(5, 'Days of history to keep', minval = 1, maxval = 10, group = KZR_GROUP, tooltip = "How many completed sessions of each killzone to remember. 5 is a trading week.\n\nThe HIGHEST high and LOWEST low across those days are the week's levels - the ones worth calling major. A session high that is merely today's is taken several times a week and means little; the one that has stood all week is where the stops have had time to pile up.")
kzrShowWk  = input.bool(true, "Show the week's high / low too", group = KZR_GROUP, tooltip = 'Adds a second line per killzone with the extreme across all the days kept. Untick to keep the panel to three rows.')
kzrShowSw  = input.bool(true, 'Show the major-sweep log', group = KZR_GROUP, tooltip = 'Lists the most recent times a WEEKLY killzone level was taken - the event you would otherwise only notice by scrolling back. Reset when that level is replaced by a new extreme.')
kzrSwRows  = input.int(3, 'Sweep rows', minval = 1, maxval = 8, group = KZR_GROUP)

// in-session flags computed at TOP LEVEL: time() wants a simple session string,
// and passing one through a function parameter is where that breaks
bool kzrAsIn  = kzrOn and not na(time(timeframe.period, kzrAsSess,  kzrTz))
bool kzrLdnIn = kzrOn and not na(time(timeframe.period, kzrLdnSess, kzrTz))
bool kzrNyIn  = kzrOn and not na(time(timeframe.period, kzrNySess,  kzrTz))

//  Returns [high, low, sweptHigh, sweptLow]. The range is reset on the bar the
//  session OPENS and then held after it closes, so the numbers stay on screen
//  all day rather than blanking the moment the window ends - which is exactly
//  when you start trading against them.
//  _prev is passed in rather than read as _in[1] inside: the killzone helpers
//  further down do the same, and a history reference on a parameter only
//  advances on the bars the function is actually called.
f_kzRange(bool _in, bool _prev) =>
    var float _h  = na
    var float _l  = na
    var bool  _sh = false
    var bool  _sl = false
    if _in and not _prev
        _h  := high
        _l  := low
        _sh := false
        _sl := false
    else if _in
        _h := math.max(_h, high)
        _l := math.min(_l, low)
    else
        // after the close, record whether price has since taken either side
        if not na(_h) and high > _h
            _sh := true
        if not na(_l) and low  < _l
            _sl := true
    [_h, _l, _sh, _sl]

[kzrAsH,  kzrAsL,  kzrAsSH,  kzrAsSL ] = f_kzRange(kzrAsIn,  kzrAsIn[1])
[kzrLdnH, kzrLdnL, kzrLdnSH, kzrLdnSL] = f_kzRange(kzrLdnIn, kzrLdnIn[1])
[kzrNyH,  kzrNyL,  kzrNySH,  kzrNySL ] = f_kzRange(kzrNyIn,  kzrNyIn[1])

//───────────────────────────────────────────────────────────────────────────
//  A WEEK OF THEM  —  and which ones have actually been taken
//
//  One session's high is taken several times a week and means little. The high
//  that has stood across every session of that killzone for a week is where
//  the stops have had time to pile up, and taking THAT is the event worth
//  knowing about without scrolling back through the chart.
//
//  Each completed session is pushed into a small history; the weekly level is
//  the extreme across it. A level re-arms when a new session replaces it, so a
//  sweep is reported once per level rather than once per bar.
//───────────────────────────────────────────────────────────────────────────
var array<float> kzrDayH_As  = array.new_float()
var array<float> kzrDayL_As  = array.new_float()
var array<float> kzrDayH_Ldn = array.new_float()
var array<float> kzrDayL_Ldn = array.new_float()
var array<float> kzrDayH_Ny  = array.new_float()
var array<float> kzrDayL_Ny  = array.new_float()

// array.push mutates rather than reassigns, so this is legal inside a function
f_kzPush(array<float> _ah, array<float> _al, float _h, float _l, int _keep) =>
    if not na(_h) and not na(_l)
        array.push(_ah, _h)
        array.push(_al, _l)
        while array.size(_ah) > _keep
            array.shift(_ah)
            array.shift(_al)
    true

if kzrOn and not kzrAsIn  and kzrAsIn[1]
    f_kzPush(kzrDayH_As,  kzrDayL_As,  kzrAsH,  kzrAsL,  kzrDays)
if kzrOn and not kzrLdnIn and kzrLdnIn[1]
    f_kzPush(kzrDayH_Ldn, kzrDayL_Ldn, kzrLdnH, kzrLdnL, kzrDays)
if kzrOn and not kzrNyIn  and kzrNyIn[1]
    f_kzPush(kzrDayH_Ny,  kzrDayL_Ny,  kzrNyH,  kzrNyL,  kzrDays)

f_kzWkH(array<float> _a) => array.size(_a) > 0 ? array.max(_a) : na
f_kzWkL(array<float> _a) => array.size(_a) > 0 ? array.min(_a) : na

float kzrWkAsH  = f_kzWkH(kzrDayH_As)
float kzrWkAsL  = f_kzWkL(kzrDayL_As)
float kzrWkLdnH = f_kzWkH(kzrDayH_Ldn)
float kzrWkLdnL = f_kzWkL(kzrDayL_Ldn)
float kzrWkNyH  = f_kzWkH(kzrDayH_Ny)
float kzrWkNyL  = f_kzWkL(kzrDayL_Ny)

// slots 0-5 = Asia H, Asia L, London H, London L, NY H, NY L
var array<bool>   kzrArmed = array.new_bool(6, false)   // level seen, not yet taken
var array<float>  kzrLvl   = array.new_float(6, na)     // the level each slot is watching
var array<int>    kzrEvT   = array.new_int()            // when it was taken
var array<string> kzrEvS   = array.new_string()         // what was taken

f_kzSweep(int _i, float _lvl, bool _up, string _name) =>
    if not na(_lvl)
        // A new extreme replaces the old one: re-arm, because this is a
        // different level and taking it is a different event.
        //
        // Except when price is ALREADY past it. The weekly level can FALL when
        // the oldest session drops out of the history, and arming that blindly
        // would log a sweep of a level the market had left behind days ago -
        // an event that never happened.
        if na(array.get(kzrLvl, _i)) or array.get(kzrLvl, _i) != _lvl
            array.set(kzrLvl,   _i, _lvl)
            array.set(kzrArmed, _i, _up ? high <= _lvl : low >= _lvl)
        if array.get(kzrArmed, _i) and (_up ? high > _lvl : low < _lvl)
            array.set(kzrArmed, _i, false)
            array.push(kzrEvT, time)
            array.push(kzrEvS, _name)
            while array.size(kzrEvT) > 20
                array.shift(kzrEvT)
                array.shift(kzrEvS)
    true

if kzrOn
    f_kzSweep(0, kzrWkAsH,  true,  'Asia H')
    f_kzSweep(1, kzrWkAsL,  false, 'Asia L')
    f_kzSweep(2, kzrWkLdnH, true,  'London H')
    f_kzSweep(3, kzrWkLdnL, false, 'London L')
    f_kzSweep(4, kzrWkNyH,  true,  'NY H')
    f_kzSweep(5, kzrWkNyL,  false, 'NY L')

f_kzWkTxt(float _h, float _l, int _n) =>
    na(_h) or na(_l) ? '—' :
      str.tostring(_h, format.mintick) + ' / ' + str.tostring(_l, format.mintick)
      + '  ' + str.tostring(_n) + 'd'

//  "4361.20 / 4342.10  ●"   ● = live, ⇑/⇓ = that side has been taken since
f_kzrTxt(float _h, float _l, bool _in, bool _sh, bool _sl) =>
    na(_h) or na(_l) ? 'no session yet' :
      str.tostring(_h, format.mintick) + ' / ' + str.tostring(_l, format.mintick)
      + (kzrMid ? '  ½ ' + str.tostring(math.avg(_h, _l), format.mintick) : '')
      + (_in ? '  ●' : (_sh and _sl ? '  ⇕' : _sh ? '  ⇑' : _sl ? '  ⇓' : ''))

f_kzrWhy(string _nm, string _sess, float _h, float _l, bool _in, bool _sh, bool _sl) =>
    na(_h) or na(_l) ? (_nm + '\nNo ' + _nm + ' session has completed on this chart yet.') :
      _nm + '  ' + _sess + '  ' + kzrTz + '\n\n'
      + 'High   ' + str.tostring(_h, format.mintick) + (_sh ? '   TAKEN since the close' : '') + '\n'
      + 'Low    ' + str.tostring(_l, format.mintick) + (_sl ? '   TAKEN since the close' : '') + '\n'
      + '50%    ' + str.tostring(math.avg(_h, _l), format.mintick) + '\n'
      + 'Range  ' + str.tostring(_h - _l, format.mintick) + '\n\n'
      + (_in ? 'The session is OPEN - these are the extremes so far and can still widen.\n\n'
             : 'The session has closed, so these numbers are final until it next opens.\n\n')
      + 'The high and the low are where stops rest. A wick through one that closes\n'
      + 'back inside is the raid; a close beyond it is a break, which reads the\n'
      + 'other way round.'

var table d = table.new(f_getDashPos(dashPosInput), 2, 44, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 70))
if enableSniper and showSniperDash and barstate.islast
    table.clear(d, 0, 0, 1, 43)
    table.set_position(d, f_getDashPos(dashPosInput))
    int rw = 0
    if showBiasRow
        table.cell(d, 0, rw, 'BIAS',   text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, biasText, text_color = color.white, bgcolor = biasCol,                   text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
    if showScoreRow
        f_addDashRow(d, rw, 'B / S %', str.tostring(bullPct, '#') + ' / ' + str.tostring(bearPct, '#'), bullPct >= bearPct ? color.green : color.red, dashTextSize)
        rw += 1
    if showMarketRow
        table.cell(d, 0, rw, 'Market',   text_color = color.black, text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, regimeTxt,  text_color = color.white, bgcolor = regimeCol, text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
    if showVwapRow
        f_addDashRow(d, rw, 'VWAP', close > vwapV ? 'Above' : 'Below', close > vwapV ? color.green : color.red, dashTextSize)
        rw += 1
    if showRsiRow
        f_addDashRow(d, rw, 'RSI', str.tostring(rsiVal, '#.#'), rsiVal > 50 ? color.green : color.red, dashTextSize)
        rw += 1
    if showMacdRow
        f_addDashRow(d, rw, 'MACD', m > s ? 'Bull' : 'Bear', m > s ? color.green : color.red, dashTextSize)
        rw += 1
    if showEmaRow
        f_addDashRow(d, rw, 'EMA 9/21', ema9 > ema21 ? 'Bull' : 'Bear', ema9 > ema21 ? color.green : color.red, dashTextSize)
        rw += 1
    if showAdxRow
        f_addDashRow(d, rw, 'ADX', str.tostring(adx, '#') + (adx > 25 ? ' Strong' : ' Weak'), adx > 25 ? color.green : color.gray, dashTextSize)
        rw += 1
    if showAtrVolRow
        f_addDashRow(d, rw, 'ATR·Vol', str.tostring(atr, '#.##') + ' · ' + (volume > volAvg ? 'Hi' : 'Lo'), volume > volAvg ? color.green : color.gray, dashTextSize)
        rw += 1
    if showNewsRow
        table.cell(d, 0, rw, 'News', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize)
        table.cell(d, 1, rw, newsNow ? '⚠ NEWS' : 'Clear', text_color = color.white, bgcolor = newsNow ? color.red : color.new(color.green, 20), text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
    // ── KILLZONES: the three ranges the day is traded against ───────────
    if kzrOn
        table.cell(d, 0, rw, 'KILLZONE', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = dashTextSize)
        table.cell(d, 1, rw, 'high / low', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
        table.cell(d, 0, rw, 'Asia', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = f_kzrWhy('Asian range', kzrAsSess, kzrAsH, kzrAsL, kzrAsIn, kzrAsSH, kzrAsSL))
        table.cell(d, 1, rw, f_kzrTxt(kzrAsH, kzrAsL, kzrAsIn, kzrAsSH, kzrAsSL), text_color = kzrAsIn ? color.new(#2157f3, 0) : color.new(color.gray, 0), text_halign = text.align_right, text_size = dashTextSize, tooltip = f_kzrWhy('Asian range', kzrAsSess, kzrAsH, kzrAsL, kzrAsIn, kzrAsSH, kzrAsSL))
        rw += 1
        table.cell(d, 0, rw, 'London', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = f_kzrWhy('London killzone', kzrLdnSess, kzrLdnH, kzrLdnL, kzrLdnIn, kzrLdnSH, kzrLdnSL))
        table.cell(d, 1, rw, f_kzrTxt(kzrLdnH, kzrLdnL, kzrLdnIn, kzrLdnSH, kzrLdnSL), text_color = kzrLdnIn ? color.new(#2157f3, 0) : color.new(color.gray, 0), text_halign = text.align_right, text_size = dashTextSize, tooltip = f_kzrWhy('London killzone', kzrLdnSess, kzrLdnH, kzrLdnL, kzrLdnIn, kzrLdnSH, kzrLdnSL))
        rw += 1
        table.cell(d, 0, rw, 'New York', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = f_kzrWhy('New York session', kzrNySess, kzrNyH, kzrNyL, kzrNyIn, kzrNySH, kzrNySL))
        table.cell(d, 1, rw, f_kzrTxt(kzrNyH, kzrNyL, kzrNyIn, kzrNySH, kzrNySL), text_color = kzrNyIn ? color.new(#2157f3, 0) : color.new(color.gray, 0), text_halign = text.align_right, text_size = dashTextSize, tooltip = f_kzrWhy('New York session', kzrNySess, kzrNyH, kzrNyL, kzrNyIn, kzrNySH, kzrNySL))
        rw += 1

        // ── the week's extremes: the levels worth calling major ──────────
        if kzrShowWk
            string _wkTip = 'THE WEEK\'S LEVELS\n\nThe highest high and lowest low each killzone has made across the\nlast ' + str.tostring(kzrDays) + ' completed sessions, with the count of sessions actually held.\n\nOne session\'s high is taken several times a week and means little.\nThe high that has stood all week is where the stops have had time\nto pile up, which is why only these count as a major sweep.'
            f_addDashRow(d, rw, '  wk Asia',   f_kzWkTxt(kzrWkAsH,  kzrWkAsL,  array.size(kzrDayH_As)),  color.new(color.gray, 20), dashTextSize)
            rw += 1
            f_addDashRow(d, rw, '  wk London', f_kzWkTxt(kzrWkLdnH, kzrWkLdnL, array.size(kzrDayH_Ldn)), color.new(color.gray, 20), dashTextSize)
            rw += 1
            table.cell(d, 0, rw, '  wk NY', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = _wkTip)
            table.cell(d, 1, rw, f_kzWkTxt(kzrWkNyH, kzrWkNyL, array.size(kzrDayH_Ny)), text_color = color.new(color.gray, 20), text_halign = text.align_right, text_size = dashTextSize, tooltip = _wkTip)
            rw += 1

        // ── MAJOR SWEEPS: what has actually been taken, and when ─────────
        if kzrShowSw
            string _swTz  = logTz == 'Exchange' ? syminfo.timezone : logTz
            int    _swN   = array.size(kzrEvT)
            string _swTip = 'MAJOR SWEEPS\n\nEach line is a WEEKLY killzone level that price has taken:\nthe high or low that had stood across every session kept.\n\n⇑ the high was taken   ⇓ the low was taken\n\nReported once per level. When a new session prints a new extreme\nthe level is replaced and re-armed, so the same event is not\nlogged twice.\n\nTimes are ' + _swTz + '.\n\nWhat it does NOT say: whether the sweep was rejected. A wick\nthrough that closes back inside is the raid; a close beyond it is\na break, and those read opposite ways.'
            table.cell(d, 0, rw, 'MAJOR SWEEPS', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = dashTextSize, tooltip = _swTip)
            table.cell(d, 1, rw, _swN > 0 ? str.tostring(_swN) + ' kept' : '', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_right, text_size = dashTextSize, tooltip = _swTip)
            rw += 1
            if _swN == 0
                f_addDashRow(d, rw, '  none yet', 'no weekly level taken', color.new(color.gray, 30), dashTextSize)
                rw += 1
            else
                int _from = math.max(0, _swN - kzrSwRows)
                for _k = _swN - 1 to _from
                    string _nm  = array.get(kzrEvS, _k)
                    bool   _isH = str.endswith(_nm, 'H')
                    f_addDashRow(d, rw, '  ' + str.format_time(array.get(kzrEvT, _k), 'dd HH:mm', _swTz),
                                 _nm + (_isH ? '  ⇑' : '  ⇓'),
                                 _isH ? color.new(#f23645, 0) : color.new(#089981, 0), dashTextSize)
                    rw += 1

    // ALTERED — full Entry / SL / TP1 → TP5 ladder (was TP5 only)
    if showTradeRow and tradeDisplayInput != 'Chart' and lastSignalState != 0
        table.cell(d, 0, rw, 'TRADE', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, lastSignalState == 1 ? 'LONG' : 'SHORT', text_color = color.white, bgcolor = lastSignalState == 1 ? color.green : color.red, text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'Entry', str.tostring(entryP, '#.##'), color.blue, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'SL',  str.tostring(slP, '#.##') + (slHit ? ' 💣' : ''), color.red,   dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP1', str.tostring(t1, '#.##')  + (t1Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP2', str.tostring(t2, '#.##')  + (t2Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP3', str.tostring(t3, '#.##')  + (t3Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP4', str.tostring(t4, '#.##')  + (t4Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP5', str.tostring(t5, '#.##')  + (t5Hit ? ' 🚀' : ''), color.green, dashTextSize)
        rw += 1
    // ADDED — running daily pip total
    if showDayRow
        f_addDashRow(d, rw, 'Day P/L', dayPipsStr, dayPipsCol, dashTextSize)
        rw += 1
    if showStatusRow
        table.cell(d, 0, rw, 'Status',   text_color = color.black, text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, dashStatus, text_color = color.white, bgcolor = dashStatusColor, text_halign = text.align_right, text_size = dashTextSize)
        rw += 1

//───────────────────────────────────────────────────────────────────────────
// Trade Log table (entry history: Time / Dir / Entry / SL / Result + Day footer)
//───────────────────────────────────────────────────────────────────────────
var table logT = table.new(f_getDashPos(logPosInput), 6, 40, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 70))
if enableSniper and showTradeLog and barstate.islast
    table.clear(logT, 0, 0, 5, 39)
    table.set_position(logT, f_getDashPos(logPosInput))

    // dynamic column indices — Dir & Result always on; Time, Entry & SL optional
    int _ci = 0
    int idxTime = logColTime ? _ci : -1
    _ci := logColTime ? _ci + 1 : _ci
    int idxDir = _ci
    _ci += 1
    int idxEntry = logColEntry ? _ci : -1
    _ci := logColEntry ? _ci + 1 : _ci
    int idxSl = logColSl ? _ci : -1               // ADDED
    _ci := logColSl ? _ci + 1 : _ci               // ADDED
    int idxExit = logColExit ? _ci : -1           // ADDED
    _ci := logColExit ? _ci + 1 : _ci             // ADDED
    int idxResult = _ci

    color _hdrBg = color.new(color.black, 0)
    string _logTz = logTz == 'Exchange' ? syminfo.timezone : logTz
    // header row
    f_logCell(logT, idxTime,   0, 'Time',   color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxDir,    0, 'Dir',    color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxEntry,  0, 'Entry',  color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxSl,     0, 'SL',     color.white, _hdrBg, logTextSize, text.align_left)   // ADDED
    f_logCell(logT, idxExit,   0, 'Exit',   color.white, _hdrBg, logTextSize, text.align_left)   // ADDED
    f_logCell(logT, idxResult, 0, 'Result', color.white, _hdrBg, logTextSize, text.align_right)

    int _r = 1

    // live/open trade pinned at top (not affected by the Log filter)
    if logShowLive and lastSignalState != 0
        string _lres = tradeClosed ? f_tradeResult(slHit, t1Hit, t2Hit, t3Hit, t4Hit, t5Hit) : ('● ' + f_tradeResult(false, t1Hit, t2Hit, t3Hit, t4Hit, false))
        color  _lcol = str.contains(_lres, 'SL') ? color.red : str.contains(_lres, 'TP') ? color.green : color.gray
        f_logCell(logT, idxTime,   _r, str.format_time(entryTime, 'HH:mm', _logTz), color.gray, na, logTextSize, text.align_left)
        f_logCell(logT, idxDir,    _r, lastSignalState == 1 ? 'LONG' : 'SHORT', color.white, lastSignalState == 1 ? color.new(color.green, 20) : color.new(color.red, 20), logTextSize, text.align_left)
        f_logCell(logT, idxEntry,  _r, str.tostring(entryP, '#.##'), color.blue, na, logTextSize, text.align_left)
        f_logCell(logT, idxSl,     _r, str.tostring(slP, '#.##') + (slHit ? ' 💣' : ''), color.red, na, logTextSize, text.align_left)   // ADDED
        float _lexit = f_resultPrice(_lres, entryP, slP, lastSignalState)   // ADDED
        f_logCell(logT, idxExit,   _r, na(_lexit) ? '—' : str.tostring(_lexit, '#.##'), _lcol, na, logTextSize, text.align_left)   // ADDED
        f_logCell(logT, idxResult, _r, _lres, _lcol, na, logTextSize, text.align_right)
        _r += 1

    int _n = array.size(logDirArr)
    int _shown = 0
    if _n > 0
        for i = _n - 1 to 0
            if _shown >= logMaxRows
                break
            string _res = array.get(logResArr, i)
            if f_passFilter(_res, logResultFilter)
                int   _dir = array.get(logDirArr,   i)
                float _ent = array.get(logEntryArr, i)
                float _sl  = array.get(logSlArr,    i)         // ADDED
                int   _tm  = array.get(logTimeArr,  i)
                color _rc  = str.contains(_res, 'SL') ? color.red : str.contains(_res, 'TP') ? color.green : color.gray
                f_logCell(logT, idxTime,   _r, str.format_time(_tm, 'HH:mm', _logTz), color.gray, na, logTextSize, text.align_left)
                f_logCell(logT, idxDir,    _r, _dir == 1 ? 'LONG' : 'SHORT', _dir == 1 ? color.green : color.red, na, logTextSize, text.align_left)
                f_logCell(logT, idxEntry,  _r, str.tostring(_ent, '#.##'), color.black, na, logTextSize, text.align_left)
                f_logCell(logT, idxSl,     _r, str.tostring(_sl, '#.##'), color.red, na, logTextSize, text.align_left)   // ADDED
                float _ex = f_resultPrice(_res, _ent, _sl, _dir)   // ADDED
                f_logCell(logT, idxExit,   _r, na(_ex) ? '—' : str.tostring(_ex, '#.##'), _rc, na, logTextSize, text.align_left)   // ADDED
                f_logCell(logT, idxResult, _r, _res, _rc, na, logTextSize, text.align_right)
                _r    += 1
                _shown += 1
    if _shown == 0 and not (logShowLive and lastSignalState != 0)
        table.cell(logT, 0, _r, logResultFilter == 'All' ? 'No trades yet' : 'No trades match filter', text_color = color.gray, text_size = logTextSize, text_halign = text.align_left)
        _r += 1

    // ADDED — Day P/L footer (net realized pips for the current day)
    if logShowDaySum
        table.cell(logT, 0,         _r, 'DAY ▸',    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = logTextSize, text_halign = text.align_left)
        table.cell(logT, idxResult, _r, dayPipsStr, text_color = dayPipsCol,  text_size = logTextSize, text_halign = text.align_right)

pFast = plot(enableSniper and showSniperRibbon ? ema9  : na, color = color.new(color.green, 20), title = 'Fast EMA')
pMid  = plot(enableSniper and showSniperRibbon ? ema21 : na, color = color.new(color.red, 20),   title = 'Mid EMA')
pSlow = plot(enableSniper and showSniperRibbon ? ema50 : na, color = color.blue, linewidth = 2,  title = 'Slow EMA')

fill(pFast, pMid, color = (enableSniper and showSniperRibbon) ? (ema9 > ema21 ? color.new(color.green, 100 - ribbonOpacity) : color.new(color.red, 100 - ribbonOpacity)) : na)

barcolor((enableSniper and showSniperTrades) ? ((triggerBuy or triggerSell) ? color.black : (isRetest ? color.orange : na)) : na)

var line lE = na
var line lSL = na
var line lT5 = na
var label lbE   = na
var label lbSL  = na
var label lbT5  = na

if enableSniper and showSniperTrades and tradeDisplayInput != 'Dashboard' and (triggerBuy or triggerSell)
    line.delete(lE)
    line.delete(lSL)
    line.delete(lT5)
    label.delete(lbE)
    label.delete(lbSL)
    label.delete(lbT5)
    int rightMarginX = bar_index + labelOffsetBars
    lE  := line.new(signalBarIdx, entryP, rightMarginX, entryP, color = color.blue,  width = 2, style = line.style_solid)
    lSL := line.new(signalBarIdx, slP,    rightMarginX, slP,    color = color.red,   width = 2, style = line.style_solid)
    lT5 := line.new(signalBarIdx, t5,     rightMarginX, t5,     color = color.green, width = 2, style = line.style_solid)
    lbE  := label.new(rightMarginX, entryP, 'ENTRY: ' + str.tostring(entryP, '#.##'), color = color.blue,  textcolor = color.white, style = label.style_label_left, size = tradeTextSize)
    lbSL := label.new(rightMarginX, slP,    'SL: '    + str.tostring(slP, '#.##'),     color = color.red,   textcolor = color.white, style = label.style_label_left, size = tradeTextSize)
    lbT5 := label.new(rightMarginX, t5,     'TP5: '   + str.tostring(t5, '#.##'),      color = color.green, textcolor = color.white, style = label.style_label_left, size = tradeTextSize)

if enableSniper and showSniperTrades and tradeDisplayInput != 'Dashboard' and lastSignalState != 0
    int targetX = barstate.islast ? (bar_index + labelOffsetBars) : (bar_index + 1)
    line.set_x2(lE, targetX)
    line.set_x2(lSL, targetX)
    line.set_x2(lT5, targetX)
    label.set_x(lbE, targetX)
    label.set_x(lbSL, targetX)
    label.set_text(lbSL, 'SL: ' + str.tostring(slP, '#.##') + (slHit ? ' 💣' : ''))
    label.set_x(lbT5, targetX)
    label.set_text(lbT5, 'TP5: ' + str.tostring(t5, '#.##') + (t5Hit ? ' 🚀' : ''))

plot(enableSniper and showSniperVwap ? vwapV : na, color = close > vwapV ? color.green : color.red, linewidth = 2, title = 'VWAP')

bgcolor(enableSniper and newsShade and newsNow ? newsCss : na, title = 'News window', editable = false)

alertcondition(enableSniper and triggerBuy,  'Sniper Buy',  'Sniper EMA9/21 bullish cross — BUY')
alertcondition(enableSniper and triggerSell, 'Sniper Sell', 'Sniper EMA9/21 bearish cross — SELL')


