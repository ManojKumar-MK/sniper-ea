// --- Sweep (prev candle liquidity) & Equilibrium (50% / CE) lines ---
string group_sweep              = "HTF ▸ Sweep & Equilibrium  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
enableSweep                     = input.bool(false, 'Show Sweep lines (prev candle High/Low)', group = group_sweep, tooltip = 'Draws the previous completed HTF candle High and Low as resting-liquidity levels. When the developing candle trades beyond a level (takes the liquidity), that line switches to the "swept" style/colour.')
sweepColor                      = input.color(color.new(color.orange, 0), 'Unswept level', group = group_sweep, inline = 'sw')
sweptColor                      = input.color(color.new(color.gray, 35),  'Swept level',   group = group_sweep, inline = 'sw')
enableEQ                        = input.bool(false, 'Show Equilibrium (50% / CE) line', group = group_sweep)
eqColor                         = input.color(color.new(color.blue, 0), 'Equilibrium line', group = group_sweep)
eqMode                          = input.string('High/Low', 'Equilibrium basis', options = ['High/Low', 'Open/Close'], group = group_sweep, tooltip = 'High/Low = midpoint of the full candle range. Open/Close = midpoint of the body (consequent encroachment).')
seExtend                        = input.int(60, 'Sweep/EQ line left extension (bars)', minval = 1, maxval = 500, group = group_sweep)

//+------------------------------------------------------------------------------------------------------------+//
//+--- Variables                                                                                            ---+//
//+------------------------------------------------------------------------------------------------------------+//

Helper helper = Helper.new()
var Trace trace = Trace.new()
color color_transparent = #ffffff00

//+------------------------------------------------------------------------------------------------------------+//
//+--- Internal Functions                                                                                   ---+//
//+------------------------------------------------------------------------------------------------------------+//

method LineStyle(Helper helper, string style) =>
    helper.name := style
    out = switch style
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid
    out

method DayofWeek(Helper helper, int index) =>
    helper.name := 'DOW'
    switch
        index == 1 => 'M'
        index == 2 => 'T'
        index == 3 => 'W'
        index == 4 => 'T'
        index == 5 => 'F'
        index == 6 => 'S'
        index == 7 => 'S'
        na(index) => ''

method ValidTimeframe(Helper helper, string HTF) =>
    helper.name := HTF
    if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and timeframe.in_seconds(HTF) > timeframe.in_seconds()
        true
    else
        n1 = timeframe.in_seconds()
        n2 = timeframe.in_seconds(HTF)
        n3 = n1 % n2
        n1 < n2 and math.round(n2 / n1) == n2 / n1

method RemainingTime(Helper helper, string HTF) =>
    helper.name := HTF
    if barstate.isrealtime
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)

        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
            r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
            r
        if days > 0
            r := str.tostring(days) + 'D ' + r
            r
        r
    else
        'n/a'

method HTFName(Helper helper, string HTF) =>
    helper.name := 'HTFName'
    formatted = HTF

    seconds = timeframe.in_seconds(HTF)
    if seconds < 60
        formatted := str.tostring(seconds) + 's'
        formatted
    else if seconds / 60 < 60
        formatted := str.tostring(seconds / 60) + 'm'
        formatted
    else if seconds / 60 / 60 < 24
        formatted := str.tostring(seconds / 60 / 60) + 'H'
        formatted
    formatted

method HTFEnabled(Helper helper) =>
    helper.name := 'HTFEnabled'
    int enabled = 0
    enabled := enabled + (htf1.settings.show ? 1 : 0)
    enabled := enabled + (htf2.settings.show ? 1 : 0)
    enabled := enabled + (htf3.settings.show ? 1 : 0)
    enabled := enabled + (htf4.settings.show ? 1 : 0)
    enabled := enabled + (htf5.settings.show ? 1 : 0)
    enabled := enabled + (htf6.settings.show ? 1 : 0)
    int last = math.min(enabled, settings.max_sets)

    last

method CandleSetHigh(Helper helper, array<Candle> candles, float h) =>
    helper.name := 'CandlesSetHigh'
    float _h = h
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > _h
                _h := c.h
                _h
    _h

method CandleSetLow(Helper helper, array<Candle> candles, float l) =>
    helper.name := 'CandlesSetLow'
    float _l = l
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < _l
                _l := c.l
                _l
    _l

method CandlesHigh(Helper helper, array<Candle> candles) =>
    helper.name := 'CandlesHigh'
    h = 0.0
    int cnt = 0
    int last = helper.HTFEnabled()

    if htf1.settings.show and helper.ValidTimeframe(htf1.settings.htf)
        h := helper.CandleSetHigh(htf1.candles, h)
        cnt := cnt + 1
    if htf2.settings.show and helper.ValidTimeframe(htf2.settings.htf) and cnt < last
        h := helper.CandleSetHigh(htf2.candles, h)
        cnt := cnt + 1
    if htf3.settings.show and helper.ValidTimeframe(htf3.settings.htf) and cnt < last
        h := helper.CandleSetHigh(htf3.candles, h)
        cnt := cnt + 1
    if htf4.settings.show and helper.ValidTimeframe(htf4.settings.htf) and cnt < last
        h := helper.CandleSetHigh(htf4.candles, h)
        cnt := cnt + 1
    if htf5.settings.show and helper.ValidTimeframe(htf5.settings.htf) and cnt < last
        h := helper.CandleSetHigh(htf5.candles, h)
        cnt := cnt + 1
    if htf6.settings.show and helper.ValidTimeframe(htf6.settings.htf) and cnt < last
        h := helper.CandleSetHigh(htf6.candles, h)

    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.h > h
                h := c.h
    h

method CandlesLow(Helper helper, array<Candle> candles, float h) =>
    helper.name := 'CandlesLow'
    l = h
    int cnt = 0
    int last = helper.HTFEnabled()

    if htf1.settings.show and helper.ValidTimeframe(htf1.settings.htf)
        l := helper.CandleSetLow(htf1.candles, l)
        cnt := cnt + 1
    if htf2.settings.show and helper.ValidTimeframe(htf2.settings.htf) and cnt < last
        l := helper.CandleSetLow(htf2.candles, l)
        cnt := cnt + 1
    if htf3.settings.show and helper.ValidTimeframe(htf3.settings.htf) and cnt < last
        l := helper.CandleSetLow(htf3.candles, l)
        cnt := cnt + 1
    if htf4.settings.show and helper.ValidTimeframe(htf4.settings.htf) and cnt < last
        l := helper.CandleSetLow(htf4.candles, l)
        cnt := cnt + 1
    if htf5.settings.show and helper.ValidTimeframe(htf5.settings.htf) and cnt < last
        l := helper.CandleSetLow(htf5.candles, l)
        cnt := cnt + 1
    if htf6.settings.show and helper.ValidTimeframe(htf6.settings.htf) and cnt < last
        l := helper.CandleSetLow(htf6.candles, l)

    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1 by 1
            Candle c = array.get(candles, i)
            if c.l < l
                l := c.l
    l

method UpdateTime(CandleSet candleSet, int offset) =>
    if settings.htf_timer_show and (barstate.isrealtime or barstate.islast)
        string tmr = '(' + helper.RemainingTime(candleSet.settings.htf) + ')'

        if not na(candleSet.tfTimerTop)
            candleSet.tfTimerTop.set_text(tmr)

        if not na(candleSet.tfTimerBottom)
            candleSet.tfTimerBottom.set_text(tmr)
    candleSet

method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()

    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)

            if settings.daily_name
                if not na(candle.dow_label)
                    candle.dow_label.set_y(candle.h)
                    candle.dow_label.set_x(bar_index + settings.width / 2 + t_buffer)
                    candle.dow_label.set_text(candle.dow)
                else
                    candle.dow_label := label.new(bar_index + settings.width / 2 + t_buffer, candle.h, candle.dow, color = color_transparent, textcolor = settings.dow_color, style = label.style_label_down, size = settings.dow_size)

    top = 0.0
    bottom = 0.0

    if settings.label_alignment == 'Align'
        top := helper.CandlesHigh(candleSet.candles)
        bottom := helper.CandlesLow(candleSet.candles, top)
    if settings.label_alignment == 'Follow Candles'
        top := helper.CandleSetHigh(candleSet.candles, 0)
        bottom := helper.CandleSetLow(candleSet.candles, top)

    left = bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2

    if settings.htf_label_show
        string lblt = helper.HTFName(candleSet.settings.htf)
        string lbll = lblt
        if settings.htf_timer_show
            lblt := lblt + '\n'
            lbll := '\n' + lbll
        if settings.daily_name
            lblt := lblt + '\n'

        string tmr = '(' + helper.RemainingTime(candleSet.settings.htf) + ')' + (settings.daily_name ? '\n' : '')
        if settings.label_position == 'Both' or settings.label_position == 'Top'

            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
            else
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerTop)
                    candleSet.tfTimerTop.set_xy(left, top)
                else
                    candleSet.tfTimerTop := label.new(left, top, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_down, size = settings.htf_timer_size)

        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
            else
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size)
            if settings.htf_timer_show
                if settings.htf_timer_show
                    if not na(candleSet.tfTimerBottom)
                        candleSet.tfTimerBottom.set_xy(left, bottom)
                    else
                        candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_up, size = settings.htf_timer_size)

    candleSet

method FindImbalance(CandleSet candleSet) =>
    if barstate.isrealtime or barstate.islast
        if candleSet.imbalances.size() > 0
            for i = candleSet.imbalances.size() - 1 to 0 by 1
                Imbalance del = candleSet.imbalances.get(i)
                box.delete(del.b)
                candleSet.imbalances.pop()

        if candleSet.candles.size() > 3 and settings.fvg_show
            for i = 0 to candleSet.candles.size() - 3 by 1
                candle1 = candleSet.candles.get(i)
                candle2 = candleSet.candles.get(i + 2)
                candle3 = candleSet.candles.get(i + 1)

                if candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_left(candle2.body), candle2.h, box.get_right(candle1.body), candle1.l, bgcolor = settings.fvg_color, border_color = color_transparent, xloc = xloc.bar_index)
                    candleSet.imbalances.push(imb)
                if candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_right(candle1.body), candle1.h, box.get_left(candle2.body), candle2.l, bgcolor = settings.fvg_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
                box temp = box.copy(candle3.body)
                box.delete(candle3.body)
                candle3.body := temp
                candle3.body

        if candleSet.candles.size() > 2 and settings.vi_show
            for i = 0 to candleSet.candles.size() - 2 by 1
                candle1 = candleSet.candles.get(i)
                candle2 = candleSet.candles.get(i + 1)
                if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_left(candle2.body), math.min(candle1.o, candle1.c), box.get_right(candle1.body), math.max(candle2.o, candle2.c), bgcolor = settings.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
                if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_right(candle1.body), math.min(candle2.o, candle2.c), box.get_left(candle2.body), math.max(candle1.o, candle1.c), bgcolor = settings.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
    candleSet

// ta.change/time detection extracted here so it runs UNCONDITIONALLY every bar (called for all sets before drawing)
method IsNewCandle(CandleSet candleSet) =>
    HTFBarTime = time(candleSet.settings.htf, 'america/New_York')
    isNewHTFCandle = ta.change(HTFBarTime) > 0

    if settings.use_custom_daily
        int _830 = 0
        if isNewHTFCandle
            _830 := timestamp("America/New_York", year(time), month(time), dayofmonth(time), 0, 0) + 30600000
        if candleSet.settings.htf == '1D'
            if settings.custom_daily == 'Midnight'
                isNewHTFCandle := dayofweek(time, 'America/New_York') != dayofweek(time - (time - time[1]), 'America/New_York')
            if settings.custom_daily == '8:30'
                isNewHTFCandle := not na(time(timeframe.period, "0830-0831:123456", 'America/New_York')) and na(time(timeframe.period, "0830-0831:123456", 'America/New_York')[1])
            if settings.custom_daily == '9:30'
                isNewHTFCandle := not na(time(timeframe.period, "0930-0931:123456", 'America/New_York')) and na(time(timeframe.period, "0930-0931:123456", 'America/New_York')[1])
    isNewHTFCandle

method Monitor(CandleSet candleSet, bool isNewHTFCandle) =>
    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.dow := switch
            candleSet.settings.htf == '1D' =>
                helper.DayofWeek(dayofweek(time_tradingday, "America/New_York"))
            str.tonumber(candleSet.settings.htf) < 60 =>
                str.format_time(candle.o_time, 'm', 'America/New_York')
            str.tonumber(candleSet.settings.htf) >= 60 =>
                str.format_time(candle.o_time, 'H', 'America/New_York')
            candleSet.settings.htf == '1M' =>
                str.format_time(candle.o_time, 'M', 'America/New_York')
            =>
                ''
        log.info('dow: {1} |{0}|', candle.dow, candleSet.settings.htf)
        bull = candle.c > candle.o

        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = bull ? settings.bull_body : settings.bear_body)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = bull ? settings.bull_wick : settings.bear_wick)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = bull ? settings.bull_wick : settings.bear_wick)

        candleSet.candles.unshift(candle)

        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            delCandle.dow_label.delete()

    candleSet

method Update(CandleSet candleSet, int offset, bool showTrace) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index

        bull = candle.c > candle.o

        box.set_top(candle.body, candle.o)
        box.set_bottom(candle.body, candle.c)
        box.set_bgcolor(candle.body, bull ? settings.bull_body : settings.bear_body)
        box.set_border_color(candle.body, bull ? settings.bull_border : settings.bear_border)
        line.set_color(candle.wick_up, bull ? settings.bull_wick : settings.bear_wick)
        line.set_color(candle.wick_down, bull ? settings.bull_wick : settings.bear_wick)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))

        if barstate.isrealtime or barstate.islast
            candleSet.Reorder(offset)
            if settings.trace_show and showTrace
                if bar_index - candle.o_idx < 5000
                    if na(trace.o)
                        trace.o := line.new(candle.o_idx, candle.o, box.get_left(candle.body), candle.o, xloc = xloc.bar_index, color = settings.trace_o_color, style = helper.LineStyle(settings.trace_o_style), width = settings.trace_o_size)
                        trace.o
                    else
                        line.set_xy1(trace.o, candle.o_idx, candle.o)
                        line.set_xy2(trace.o, box.get_left(candle.body), candle.o)

                    if settings.label_show
                        if na(trace.o_l)
                            trace.o_l := label.new(box.get_right(candle.body), candle.o, str.tostring(candle.o), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                            trace.o_l
                        else
                            label.set_xy(trace.o_l, box.get_right(candle.body), candle.o)
                            label.set_text(trace.o_l, str.tostring(candle.o))

                if bar_index - candle.c_idx < 5000
                    if na(trace.c)
                        trace.c := line.new(candle.c_idx, candle.c, box.get_left(candle.body), candle.c, xloc = xloc.bar_index, color = settings.trace_c_color, style = helper.LineStyle(settings.trace_c_style), width = settings.trace_c_size)
                        trace.c
                    else
                        line.set_xy1(trace.c, candle.c_idx, candle.c)
                        line.set_xy2(trace.c, box.get_left(candle.body), candle.c)

                    if settings.label_show
                        if na(trace.c_l)
                            trace.c_l := label.new(box.get_right(candle.body), candle.c, str.tostring(candle.c), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                            trace.c_l
                        else
                            label.set_xy(trace.c_l, box.get_right(candle.body), candle.c)
                            label.set_text(trace.c_l, str.tostring(candle.c))

                if bar_index - candle.h_idx < 5000
                    if na(trace.h)
                        trace.h := line.new(candle.h_idx, candle.h, line.get_x1(candle.wick_up), candle.h, xloc = xloc.bar_index, color = settings.trace_h_color, style = helper.LineStyle(settings.trace_h_style), width = settings.trace_h_size)
                        trace.h
                    else
                        line.set_xy1(trace.h, candle.h_idx, candle.h)
                        line.set_xy2(trace.h, line.get_x1(candle.wick_up), candle.h)

                    if settings.label_show
                        if na(trace.h_l)
                            trace.h_l := label.new(box.get_right(candle.body), candle.h, str.tostring(candle.h), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                            trace.h_l
                        else
                            label.set_xy(trace.h_l, box.get_right(candle.body), candle.h)
                            label.set_text(trace.h_l, str.tostring(candle.h))

                if bar_index - candle.l_idx < 5000
                    if na(trace.l)
                        trace.l := line.new(candle.l_idx, candle.l, line.get_x1(candle.wick_down), candle.l, xloc = xloc.bar_index, color = settings.trace_l_color, style = helper.LineStyle(settings.trace_l_style), width = settings.trace_l_size)
                        trace.l
                    else
                        line.set_xy1(trace.l, candle.l_idx, candle.l)
                        line.set_xy2(trace.l, line.get_x1(candle.wick_down), candle.l)

                    if settings.label_show
                        if na(trace.l_l)
                            trace.l_l := label.new(box.get_right(candle.body), candle.l, str.tostring(candle.l), textalign = text.align_center, style = label.style_label_left, size = settings.label_size, color = color_transparent, textcolor = settings.label_color)
                            trace.l_l
                        else
                            label.set_xy(trace.l_l, box.get_right(candle.body), candle.l)
                            label.set_text(trace.l_l, str.tostring(candle.l))
    candleSet

// --- ADDED: Sweep lines (prev candle H/L liquidity) + Equilibrium (50% / CE) line ---
// Anchored to each HTF set's last COMPLETED candle (index 1). A level is "swept" once the
// developing candle (index 0) trades beyond it, at which point the line switches style/colour.
method DrawSweepEQ(CandleSet candleSet) =>
    if candleSet.settings.show and (enableSweep or enableEQ) and (barstate.islast or barstate.isrealtime)
        int n = candleSet.candles.size()
        if n > 1
            Candle prev = candleSet.candles.get(1)
            Candle cur  = candleSet.candles.get(0)
            int leftX   = math.max(0, bar_index - seExtend)
            int rightX  = bar_index + settings.offset
            string nm   = helper.HTFName(candleSet.settings.htf)

            if enableSweep
                bool hiSwept = cur.h > prev.h
                bool loSwept = cur.l < prev.l
                color hiCol  = hiSwept ? sweptColor : sweepColor
                color loCol  = loSwept ? sweptColor : sweepColor
                string hiSty = hiSwept ? '····' : '⎯⎯⎯'
                string loSty = loSwept ? '····' : '⎯⎯⎯'

                if na(candleSet.sweep_hi)
                    candleSet.sweep_hi     := line.new(leftX, prev.h, rightX, prev.h, xloc = xloc.bar_index, color = hiCol, style = helper.LineStyle(hiSty), width = 1)
                    candleSet.sweep_hi_lbl := label.new(rightX, prev.h, nm + ' SWH', xloc = xloc.bar_index, color = color_transparent, textcolor = hiCol, style = label.style_label_left, size = size.tiny)
                else
                    candleSet.sweep_hi.set_xy1(leftX, prev.h)
                    candleSet.sweep_hi.set_xy2(rightX, prev.h)
                    candleSet.sweep_hi.set_color(hiCol)
                    candleSet.sweep_hi.set_style(helper.LineStyle(hiSty))
                    candleSet.sweep_hi_lbl.set_xy(rightX, prev.h)
                    candleSet.sweep_hi_lbl.set_textcolor(hiCol)
                    candleSet.sweep_hi_lbl.set_text(nm + (hiSwept ? ' SWH ✓' : ' SWH'))

                if na(candleSet.sweep_lo)
                    candleSet.sweep_lo     := line.new(leftX, prev.l, rightX, prev.l, xloc = xloc.bar_index, color = loCol, style = helper.LineStyle(loSty), width = 1)
                    candleSet.sweep_lo_lbl := label.new(rightX, prev.l, nm + ' SWL', xloc = xloc.bar_index, color = color_transparent, textcolor = loCol, style = label.style_label_left, size = size.tiny)
                else
                    candleSet.sweep_lo.set_xy1(leftX, prev.l)
                    candleSet.sweep_lo.set_xy2(rightX, prev.l)
                    candleSet.sweep_lo.set_color(loCol)
                    candleSet.sweep_lo.set_style(helper.LineStyle(loSty))
                    candleSet.sweep_lo_lbl.set_xy(rightX, prev.l)
                    candleSet.sweep_lo_lbl.set_textcolor(loCol)
                    candleSet.sweep_lo_lbl.set_text(nm + (loSwept ? ' SWL ✓' : ' SWL'))

            if enableEQ
                float eq = eqMode == 'Open/Close' ? math.avg(prev.o, prev.c) : math.avg(prev.h, prev.l)
                if na(candleSet.eq_line)
                    candleSet.eq_line := line.new(leftX, eq, rightX, eq, xloc = xloc.bar_index, color = eqColor, style = line.style_dashed, width = 1)
                    candleSet.eq_lbl  := label.new(rightX, eq, nm + ' EQ', xloc = xloc.bar_index, color = color_transparent, textcolor = eqColor, style = label.style_label_left, size = size.tiny)
                else
                    candleSet.eq_line.set_xy1(leftX, eq)
                    candleSet.eq_line.set_xy2(rightX, eq)
                    candleSet.eq_lbl.set_xy(rightX, eq)
    candleSet

// master gate: when the HTF module is off, disable every HTF set so nothing renders and the engine stays idle
if not enableHTF
    htf1.settings.show := false
    htf2.settings.show := false
    htf3.settings.show := false
    htf4.settings.show := false
    htf5.settings.show := false
    htf6.settings.show := false

// detect new HTF candles UNCONDITIONALLY every bar (keeps ta.change/time consistent — fixes CW10003 for Monitor)
bool isNew_1 = htf1.IsNewCandle()
bool isNew_2 = htf2.IsNewCandle()
bool isNew_3 = htf3.IsNewCandle()
bool isNew_4 = htf4.IsNewCandle()
bool isNew_5 = htf5.IsNewCandle()
bool isNew_6 = htf6.IsNewCandle()

int cnt = 0
int last = helper.HTFEnabled()

int offset = settings.offset
if htf1.settings.show and helper.ValidTimeframe(htf1.settings.htf)
    bool showTrace = false
    if settings.trace_anchor == 'First Timeframe'
        showTrace := true
        showTrace
    if settings.trace_anchor == 'Last Timeframe' and settings.max_sets == 1
        showTrace := true
        showTrace
    htf1.UpdateTime(offset)
    htf1.Monitor(isNew_1).Update(offset, showTrace).FindImbalance().DrawSweepEQ()
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf1.candles.size() * settings.width + (htf1.candles.size() > 0 ? (htf1.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf2.settings.show and helper.ValidTimeframe(htf2.settings.htf) and cnt < last
    bool showTrace = false
    if settings.trace_anchor == 'First Timeframe' and cnt == 0
        showTrace := true
        showTrace
    if settings.trace_anchor == 'Last Timeframe' and cnt == last - 1
        showTrace := true
        showTrace
    htf2.UpdateTime(offset)
    htf2.Monitor(isNew_2).Update(offset, showTrace).FindImbalance().DrawSweepEQ()
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf2.candles.size() * settings.width + (htf2.candles.size() > 0 ? (htf2.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf3.settings.show and helper.ValidTimeframe(htf3.settings.htf) and cnt < last
    bool showTrace = false
    if settings.trace_anchor == 'First Timeframe' and cnt == 0
        showTrace := true
        showTrace
    if settings.trace_anchor == 'Last Timeframe' and cnt == last - 1
        showTrace := true
        showTrace
    htf3.UpdateTime(offset)
    htf3.Monitor(isNew_3).Update(offset, showTrace).FindImbalance().DrawSweepEQ()
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf3.candles.size() * settings.width + (htf3.candles.size() > 0 ? (htf3.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf4.settings.show and helper.ValidTimeframe(htf4.settings.htf) and cnt < last
    bool showTrace = false
    if settings.trace_anchor == 'First Timeframe' and cnt == 0
        showTrace := true
        showTrace
    if settings.trace_anchor == 'Last Timeframe' and cnt == last - 1
        showTrace := true
        showTrace
    htf4.UpdateTime(offset)
    htf4.Monitor(isNew_4).Update(offset, showTrace).FindImbalance().DrawSweepEQ()
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf4.candles.size() * settings.width + (htf4.candles.size() > 0 ? (htf4.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf5.settings.show and helper.ValidTimeframe(htf5.settings.htf) and cnt < last
    bool showTrace = false
    if settings.trace_anchor == 'First Timeframe' and cnt == 0
        showTrace := true
        showTrace
    if settings.trace_anchor == 'Last Timeframe' and cnt == last - 1
        showTrace := true
        showTrace
    htf5.UpdateTime(offset)
    htf5.Monitor(isNew_5).Update(offset, showTrace).FindImbalance().DrawSweepEQ()
    cnt := cnt + 1
    offset := offset + (cnt > 0 ? htf5.candles.size() * settings.width + (htf5.candles.size() > 0 ? (htf5.candles.size() - 1) * settings.buffer : 0) + settings.htf_buffer : 0)
    offset
if htf6.settings.show and helper.ValidTimeframe(htf6.settings.htf) and cnt < last
    bool showTrace = false
    if settings.trace_anchor == 'First Timeframe' and cnt == 0
        showTrace := true
        showTrace
    if settings.trace_anchor == 'Last Timeframe'
        showTrace := true
        showTrace
    htf6.UpdateTime(offset)
    htf6.Monitor(isNew_6).Update(offset, showTrace).FindImbalance().DrawSweepEQ()

//═════════════════════════════════════════════════════════════════════════════
//                    FOURTH LAYER  —  ICT Killzones (session shading)
//  Concept from ICT Concepts [LuxAlgo] (CC BY-NC-SA 4.0); reimplemented for v6.
//  Background shading only — uses bgcolor (no boxes/lines, tiny label footprint).
//  Six sessions: New York Open/Close, London Open/Close, Asian Open/Close.
//  Every session has: enable • editable label text • colour • session window • own timezone.
//═════════════════════════════════════════════════════════════════════════════
KZ_GROUP    = 'Killzones (ICT) 🕐'
kzEnable    = input.bool(false, '● Enable Killzones', group = KZ_GROUP, tooltip = 'Shades the ICT killzone sessions in the chart background. Each session has its OWN timezone (below), so daylight-saving is handled automatically and the New York / London / Asian windows always land correctly.')
kzShowNames = input.bool(true, 'Show session names on chart', group = KZ_GROUP, tooltip = 'Prints each session name (editable per session below) at the top of the session as it begins. Only the most recent few per session are kept, to save drawing objects.')
kzShowShade = input.bool(true, 'Shade session background', group = KZ_GROUP, tooltip = 'Paints the killzone window in the chart background. Turn OFF (with session names ON) to mark sessions with just labels, no background colour.')
kzNameSize  = input.string(size.small, 'Session name label size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = KZ_GROUP, tooltip = 'Font size for the session-name labels printed on the chart.')
kzNameKeep  = input.int(5, 'Session names kept (each)', minval = 1, maxval = 30, group = KZ_GROUP, tooltip = 'How many recent name labels to keep PER session. Lower = fewer label objects used (labels share the 500 cap with SMC/Turtle-Soup layers).')

// ── Vertical open/close lines ────────────────────────────────────────────────
kzShowVlines = input.bool(false, 'Show open/close vertical lines', group = KZ_GROUP, tooltip = 'Draws a vertical line at each session Open and/or Close, in that session colour. Automatically hidden on Daily / Weekly / Monthly charts, because intraday session boundaries do not apply there.')
kzVlineOpen  = input.bool(true,  'Mark Open',  inline = 'kzvl', group = KZ_GROUP)
kzVlineClose = input.bool(true,  'Mark Close', inline = 'kzvl', group = KZ_GROUP)
kzVlineLbl   = input.bool(true,  'Label the vertical lines', group = KZ_GROUP, tooltip = 'Prints the session name at each vertical line: at the top for the Open line, at the bottom for the Close line.')
kzVlineStyle = input.string('Dashed', 'Vertical line style', options = ['Solid','Dashed','Dotted'], group = KZ_GROUP)
kzVlineWidth = input.int(1, 'Vertical line thickness', minval = 1, maxval = 4, group = KZ_GROUP)
kzVlineKeep  = input.int(6, 'Vertical lines kept (each session)', minval = 1, maxval = 40, group = KZ_GROUP, tooltip = 'How many recent open+close lines to keep PER session (shares the 500-line cap with other layers).')


// ── New York Open ────────────────────────────────────────────────────────────
kzShowNyO = input.bool(true,  'New York Open', inline = 'nyo1', group = KZ_GROUP)
kzNyOName = input.string('NY Open', '',        inline = 'nyo1', group = KZ_GROUP)
kzNyOCss  = input.color(color.new(#ff5d00, 80), '', inline = 'nyo1', group = KZ_GROUP)
kzNyOSess = input.session('0700-0900', '',     inline = 'nyo2', group = KZ_GROUP)
kzNyOTz   = input.string('America/New_York', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'nyo2', group = KZ_GROUP, tooltip = 'NY AM killzone. Classic = 07:00-09:00 New York time (auto-DST). Some traders use 08:30-11:00.')

// ── New York Close ───────────────────────────────────────────────────────────
kzShowNyC = input.bool(true,  'New York Close', inline = 'nyc1', group = KZ_GROUP)
kzNyCName = input.string('NY Close', '',         inline = 'nyc1', group = KZ_GROUP)
kzNyCCss  = input.color(color.new(#ffb300, 80), '', inline = 'nyc1', group = KZ_GROUP)
kzNyCSess = input.session('1330-1600', '',       inline = 'nyc2', group = KZ_GROUP)
kzNyCTz   = input.string('America/New_York', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'nyc2', group = KZ_GROUP, tooltip = 'NY PM killzone. Default 13:30-16:00 New York time (auto-DST).')

// ── London Open ──────────────────────────────────────────────────────────────
kzShowLdnO = input.bool(true,  'London Open', inline = 'ldo1', group = KZ_GROUP)
kzLdnOName = input.string('LDN Open', '',     inline = 'ldo1', group = KZ_GROUP)
kzLdnOCss  = input.color(color.new(#00bcd4, 80), '', inline = 'ldo1', group = KZ_GROUP)
kzLdnOSess = input.session('0700-1000', '',   inline = 'ldo2', group = KZ_GROUP)
kzLdnOTz   = input.string('Europe/London', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'ldo2', group = KZ_GROUP, tooltip = 'Read in Europe/London (auto-DST). Classic London Open killzone = 07:00-10:00 London time.')

// ── London Close ─────────────────────────────────────────────────────────────
kzShowLdnC = input.bool(true,  'London Close', inline = 'ldc1', group = KZ_GROUP)
kzLdnCName = input.string('LDN Close', '',      inline = 'ldc1', group = KZ_GROUP)
kzLdnCCss  = input.color(color.new(#2157f3, 80), '', inline = 'ldc1', group = KZ_GROUP)
kzLdnCSess = input.session('1500-1700', '',     inline = 'ldc2', group = KZ_GROUP)
kzLdnCTz   = input.string('Europe/London', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'ldc2', group = KZ_GROUP, tooltip = 'Read in Europe/London (auto-DST). Classic London Close killzone = 15:00-17:00 London time.')

// ── Asian Open ───────────────────────────────────────────────────────────────
kzShowAsO = input.bool(true,  'Asian Open', inline = 'aso1', group = KZ_GROUP)
kzAsOName = input.string('Asia Open', '',    inline = 'aso1', group = KZ_GROUP)
kzAsOCss  = input.color(color.new(#e91e63, 80), '', inline = 'aso1', group = KZ_GROUP)
kzAsOSess = input.session('1000-1200', '',   inline = 'aso2', group = KZ_GROUP)
kzAsOTz   = input.string('Asia/Tokyo', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'aso2', group = KZ_GROUP, tooltip = 'Read in Asia/Tokyo (Japan has no DST). Default first half of the Asian range = 10:00-12:00 Tokyo (~06:30-08:30 IST).')

// ── Asian Close ──────────────────────────────────────────────────────────────
kzShowAsC = input.bool(true,  'Asian Close', inline = 'asc1', group = KZ_GROUP)
kzAsCName = input.string('Asia Close', '',    inline = 'asc1', group = KZ_GROUP)
kzAsCCss  = input.color(color.new(#9c27b0, 80), '', inline = 'asc1', group = KZ_GROUP)
kzAsCSess = input.session('1200-1400', '',    inline = 'asc2', group = KZ_GROUP)
kzAsCTz   = input.string('Asia/Tokyo', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'asc2', group = KZ_GROUP, tooltip = 'Read in Asia/Tokyo (no DST). Default second half of the Asian range = 12:00-14:00 Tokyo.')

// active-now flags (each read in its own timezone)
kzNyO  = kzEnable and kzShowNyO  and not na(time(timeframe.period, kzNyOSess,  kzNyOTz))
kzNyC  = kzEnable and kzShowNyC  and not na(time(timeframe.period, kzNyCSess,  kzNyCTz))
kzLdnO = kzEnable and kzShowLdnO and not na(time(timeframe.period, kzLdnOSess, kzLdnOTz))
kzLdnC = kzEnable and kzShowLdnC and not na(time(timeframe.period, kzLdnCSess, kzLdnCTz))
kzAsO  = kzEnable and kzShowAsO  and not na(time(timeframe.period, kzAsOSess,  kzAsOTz))
kzAsC  = kzEnable and kzShowAsC  and not na(time(timeframe.period, kzAsCSess,  kzAsCTz))

// session-name label at the top of each session's first bar (own capped registry per call site)
f_kzName(bool active, bool activePrev, string nm, color css) =>
    var array<label> arr = array.new<label>()
    if kzEnable and kzShowNames and active and not activePrev
        arr.push(label.new(bar_index, high, nm, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(css, 15), textcolor = color.white, size = kzNameSize))
        while arr.size() > kzNameKeep
            label.delete(arr.shift())

f_kzVstyle(string s) => s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

// vertical line at a session Open and/or Close (own capped registry per call site).
// Hidden on Daily+ timeframes. Session name shown at top for Open, bottom for Close.
f_kzVline(bool active, bool activePrev, string nm, color css) =>
    var array<line>  vl  = array.new<line>()
    var array<label> vlb = array.new<label>()
    color solidCss = color.new(css, 0)   // session colours carry 80 transparency (for shading); make the line solid
    if kzEnable and kzShowVlines and timeframe.isintraday
        if kzVlineOpen and active and not activePrev
            vl.push(line.new(bar_index, high, bar_index, low, xloc = xloc.bar_index, extend = extend.both, color = solidCss, style = f_kzVstyle(kzVlineStyle), width = kzVlineWidth))
            if kzVlineLbl
                vlb.push(label.new(bar_index, high, nm, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(css, 20), textcolor = color.white, size = kzNameSize))
        if kzVlineClose and not active and activePrev
            vl.push(line.new(bar_index, high, bar_index, low, xloc = xloc.bar_index, extend = extend.both, color = solidCss, style = f_kzVstyle(kzVlineStyle), width = kzVlineWidth))
            if kzVlineLbl
                vlb.push(label.new(bar_index, low, nm, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(css, 20), textcolor = color.white, size = kzNameSize))
        while vl.size() > kzVlineKeep
            line.delete(vl.shift())
        while vlb.size() > kzVlineKeep
            label.delete(vlb.shift())

f_kzName(kzNyO,  kzNyO[1],  kzNyOName,  kzNyOCss)
f_kzName(kzNyC,  kzNyC[1],  kzNyCName,  kzNyCCss)
f_kzName(kzLdnO, kzLdnO[1], kzLdnOName, kzLdnOCss)
f_kzName(kzLdnC, kzLdnC[1], kzLdnCName, kzLdnCCss)
f_kzName(kzAsO,  kzAsO[1],  kzAsOName,  kzAsOCss)
f_kzName(kzAsC,  kzAsC[1],  kzAsCName,  kzAsCCss)

f_kzVline(kzNyO,  kzNyO[1],  kzNyOName,  kzNyOCss)
f_kzVline(kzNyC,  kzNyC[1],  kzNyCName,  kzNyCCss)
f_kzVline(kzLdnO, kzLdnO[1], kzLdnOName, kzLdnOCss)
f_kzVline(kzLdnC, kzLdnC[1], kzLdnCName, kzLdnCCss)
f_kzVline(kzAsO,  kzAsO[1],  kzAsOName,  kzAsOCss)
f_kzVline(kzAsC,  kzAsC[1],  kzAsCName,  kzAsCCss)

bgcolor((kzShowShade and kzNyO)  ? kzNyOCss  : na, title = 'Killzone — New York Open',  editable = false)
bgcolor((kzShowShade and kzNyC)  ? kzNyCCss  : na, title = 'Killzone — New York Close', editable = false)
bgcolor((kzShowShade and kzLdnO) ? kzLdnOCss : na, title = 'Killzone — London Open',    editable = false)
bgcolor((kzShowShade and kzLdnC) ? kzLdnCCss : na, title = 'Killzone — London Close',   editable = false)
bgcolor((kzShowShade and kzAsO)  ? kzAsOCss  : na, title = 'Killzone — Asian Open',     editable = false)
bgcolor((kzShowShade and kzAsC)  ? kzAsCCss  : na, title = 'Killzone — Asian Close',    editable = false)

// optional: shade the chart background while inside a manual news window (Sniper layer)
bgcolor(enableSniper and newsShade and newsNow ? newsCss : na, title = 'News window', editable = false)


//═════════════════════════════════════════════════════════════════════════════
//                    FIFTH LAYER  —  Turtle Soup + Market Structure
//  Engine © mickes (PriceAction library + Turtle soup indicator),
//  Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/)
//  Library inlined (export/library/import scaffolding stripped) and every
//  public type / function PA_-prefixed to avoid clashing with the base
//  LuxAlgo layer (which already owns `pivot`, `trend`, `Pivot()`, etc.),
//  the Sniper layer (owns `atr`) and the HTF layer.
//  Master switch: enableTS (default OFF). HEAVY — consumes boxes/lines/labels.
//═════════════════════════════════════════════════════════════════════════════

// ============================================================================
// --- MASTER TOGGLE + INPUTS ---
// ============================================================================
TS_GROUP        = 'Turtle Soup + Structure 🐢'
enableTS        = input.bool(false, '● Enable Turtle Soup Module', group = TS_GROUP, tooltip = 'Master switch for the mickes PriceAction + Turtle Soup engine (swing market structure, BOS/CHoCH/CHoCH+, equal high/low zones, liquidity $$$ sweeps, and turtle-soup boxes). When OFF nothing renders and the engine stays idle. HEAVY layer — enabling it with SMC order blocks/FVGs + HTF candles can exceed the Pine 500 box/line/label caps.')

TS_MS_GROUP     = 'TS ▸ Market structure'
ts_msLeft       = input.int(5, 'Pivot', inline = 'ts_pivot', group = TS_MS_GROUP)
ts_msRight      = input.int(5, '', inline = 'ts_pivot', group = TS_MS_GROUP, tooltip = 'Set the left and right pivot lengths for the market structure that decides the trend.')
ts_showPivots   = input.bool(true, 'Show pivot labels (H/L/EQ)', group = TS_MS_GROUP)
ts_showBOS      = input.bool(true, 'Show BOS', inline = 'ts_bc', group = TS_MS_GROUP)
ts_showCHoCH    = input.bool(true, 'Show CHoCH', inline = 'ts_bc', group = TS_MS_GROUP)

TS_EQ_GROUP     = 'TS ▸ Equal highs / lows'
ts_showEqual    = input.bool(true, 'Show equal high/low zones', group = TS_EQ_GROUP)
ts_eqFactor     = input.float(10.0, 'Equal factor (% of ATR14)', minval = 0, step = 1, group = TS_EQ_GROUP, tooltip = 'A pivot is "equal" to a previous one if it sits within this fraction (percent) of ATR14 of it.')
ts_eqExtend     = input.bool(false, 'Extend equal zones right', group = TS_EQ_GROUP)
ts_eqColor      = input.color(color.new(color.blue, 0), 'Equal zone color', group = TS_EQ_GROUP)

TS_LIQ_GROUP    = 'TS ▸ Liquidity ($$$)'
ts_showLiq      = input.bool(true, 'Show liquidity sweeps', group = TS_LIQ_GROUP)
ts_liqConfirm   = input.int(3, 'Confirmation bars', minval = 0, group = TS_LIQ_GROUP, tooltip = 'Bars required to confirm a liquidity grab is valid.')
ts_liqLookback  = input.int(5, 'Pivots lookback', minval = 1, group = TS_LIQ_GROUP)

TS_SOUP_GROUP   = 'TS ▸ Turtle soup liquidity'
ts_soupLeft     = input.int(1, 'Pivot', inline = 'ts_soup', group = TS_SOUP_GROUP)
ts_soupRight    = input.int(1, '', inline = 'ts_soup', group = TS_SOUP_GROUP, tooltip = 'Pivot lengths (left/right) that can be a target for a turtle soup.')
ts_soupLookback = input.int(5, 'Lookback (pivots)', group = TS_SOUP_GROUP, tooltip = 'How many pivots back can be a turtle-soup target.')
ts_soupTf       = input.timeframe('', 'Timeframe', group = TS_SOUP_GROUP, tooltip = 'Higher timeframe for pivots that can be a turtle-soup target.')
ts_soupColor    = input.color(color.new(color.orange, 70), 'Color', group = TS_SOUP_GROUP)
ts_soupConfirm  = input.bool(true, 'Confirmation', group = TS_SOUP_GROUP, tooltip = '• ENABLED — the turtle soup must be followed by a CHoCH in the opposite direction.\n\n• DISABLED — all potential turtle soups shown (even wrong-direction ones from HTF fetch lag).')

TS_DISP_GROUP   = 'TS ▸ Display & alerts'
ts_fontSize     = input.int(7, 'Structure font size', group = TS_DISP_GROUP)
ts_alertFreq    = input.string(alert.freq_once_per_bar_close, 'Alert frequency', [alert.freq_all, alert.freq_once_per_bar, alert.freq_once_per_bar_close], group = TS_DISP_GROUP)
ts_alertMS      = input.bool(false, 'Alert BOS/CHoCH', inline = 'ts_al', group = TS_DISP_GROUP)
ts_alertEq      = input.bool(false, 'Alert equal H/L', inline = 'ts_al', group = TS_DISP_GROUP)
ts_screenerKeep = input.int(5, 'Screener keep (bars)', group = TS_DISP_GROUP, tooltip = 'Bars the "Turtle soup" plot stays high after a confirmed soup (for the Pine Screener).')

// ============================================================================
// --- TYPES (inlined from mickes/PriceAction, PA_-prefixed) ---
// ============================================================================
type PA_StructureBreak
    line Line
    label Label

type PA_Pivot
    float Price
    int BarIndex
    int Type // -1 = low, 1 = high
    int Time
    bool BreakOfStructureBroken
    bool LiquidityBroken
    bool ChangeOfCharacterBroken

enum PA_Type
    Internal = 'internal'
    Swing = 'swing'

type PA_Structure
    int LeftLength
    int RightLength
    PA_Type Type
    int Trend // -1 = downtrend, 1 = uptrend
    float EqualPivotsFactor
    bool ExtendEqualPivotsZones
    string ExtendEqualPivotsStyle
    color ExtendEqualPivotsColor
    array<box> EqualHighs
    array<box> EqualLows
    array<PA_StructureBreak> BreakOfStructures
    array<PA_Pivot> Pivots
    int FontSize
    bool AlertChangeOfCharacter
    bool AlertBreakOfStructure
    bool AlerEqualPivots

type PA_Liquidity
    array<PA_Pivot> LiquidityPivotsHigh
    array<PA_Pivot> LiquidityPivotsLow
    int LiquidityConfirmationBars
    int LiquidityPivotsLookback
    int FontSize

type PA_PriceAction
    PA_Liquidity Liquidity
    PA_Structure Swing
    PA_Structure Internal

type PA_TurtleSoupSettings
    int PivotLeftLenght
    int PivotRightLenght
    int Lookback
    bool Confirmation
    color Color
    int ScreenerKeep
    string AlertFrequency

type PA_TurtleSoup
    line Line
    box Box
    int Start
    int End
    PA_Pivot Pivot
    bool Visible
    float Deepest

type PA_Screener
    int TurtleSoupUntilBarIndex

type PA_TurtleSoups
    array<PA_Pivot> Highs
    array<PA_Pivot> Lows
    array<PA_TurtleSoup> Bullish
    array<PA_TurtleSoup> Bearish
    varip array<string> AlertMessages

// ATR used by the equal-zone logic (renamed to avoid the base `atrMeasure` and Sniper `atr`)
pa_atr = ta.atr(14)

// ============================================================================
// --- FUNCTIONS (inlined, export stripped, PA_-prefixed) ---
// ============================================================================
method SetBarIndex(PA_Pivot pivot, int barTime) =>
    barIndex = 0
    i = 0
    while true
        timeBack = time[i]
        if timeBack < barTime or na(timeBack)
            barIndex := bar_index - (i - 1)
            break
        i += 1
    pivot.BarIndex := barIndex

pa_SetBarIndices(PA_Pivot pivotHigh, PA_Pivot pivotLow) =>
    if not na(pivotHigh) and na(pivotHigh.BarIndex)
        pivotHigh.SetBarIndex(pivotHigh.Time)
    if not na(pivotLow) and na(pivotLow.BarIndex)
        pivotLow.SetBarIndex(pivotLow.Time)

pa_alertFire(string message, string frequency) =>
    switch frequency
        alert.freq_all => alert(message, alert.freq_all)
        alert.freq_once_per_bar => alert(message, alert.freq_once_per_bar)
        alert.freq_once_per_bar_close => alert(message, alert.freq_once_per_bar_close)

pa_alertOnce(string message) =>
    alert(message, alert.freq_once_per_bar_close)

pa_TurtleSoupAlert(string message, PA_TurtleSoup turtleSoup, PA_TurtleSoupSettings settings) =>
    direction = switch turtleSoup.Pivot.Type
        -1 => 'bullish'
        1 => 'bearish'
    fullMessage = str.format('{0} ({1} of {2} bars, {3} bars ago and with a pivot from {4} bars ago (from the turtle soup start))', message, direction, turtleSoup.End - turtleSoup.Start, bar_index - turtleSoup.End, turtleSoup.Start - turtleSoup.Pivot.BarIndex)
    fullMessage

pa_AlertContext(PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings) =>
    if turtleSoupsContext.AlertMessages.size() > 0
        pa_alertFire(turtleSoupsContext.AlertMessages.join('\n'), settings.AlertFrequency)
        turtleSoupsContext.AlertMessages.clear()

pa_VisualizeTurtleSoups(array<PA_Pivot> pivots, array<PA_TurtleSoup> turtleSoups, PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings) =>
    reversedPivots = pivots.copy()
    reversedPivots.reverse()
    for pivot in reversedPivots
        if not pivot.LiquidityBroken
            confirmed = switch pivot.Type
                -1 => low > pivot.Price and low[1] <= pivot.Price
                1 => high < pivot.Price and high[1] >= pivot.Price
            if confirmed
                i = 2
                deepest = switch pivot.Type
                    -1 => low[1]
                    1 => high[1]
                while true
                    price = switch pivot.Type
                        -1 => low[i]
                        1 => high[i]
                    swept = switch pivot.Type
                        -1 => price <= pivot.Price
                        1 => price >= pivot.Price
                    if swept
                        i += 1
                        newDeepest = switch pivot.Type
                            -1 => price < deepest
                            1 => price > deepest
                        if newDeepest
                            deepest := price
                    else
                        break
                if i == 2
                    continue
                pivot.LiquidityBroken := true
                start = bar_index - i
                end = bar_index - 1
                boxColor = settings.Confirmation ? na : settings.Color
                lineColor = settings.Confirmation ? na : color.new(settings.Color, 0)
                turtleSoup = PA_TurtleSoup.new(
                  line.new(pivot.Time, pivot.Price, time[1], pivot.Price, xloc = xloc.bar_time, color = lineColor, style = line.style_dotted),
                  box.new(bar_index - i, pivot.Price, bar_index - 1, deepest, border_width = 0, bgcolor = boxColor, text = '🐢', text_color = boxColor),
                  start,
                  end,
                  pivot,
                  settings.Confirmation ? false : true,
                  deepest)
                removeTurtleSoupIndices = array.new<int>()
                for [j, previousTurtleSoup] in turtleSoups
                    if previousTurtleSoup.Start >= turtleSoup.Start and previousTurtleSoup.End <= turtleSoup.End
                        removeTurtleSoupIndices.unshift(j)
                for removeTurtleSoupIndex in removeTurtleSoupIndices
                    removeTurtleSoup = turtleSoups.get(removeTurtleSoupIndex)
                    removeTurtleSoup.Box.set_text('')
                    if turtleSoup.Start > removeTurtleSoup.Start
                        removeTurtleSoup.Line.set_x2(turtleSoup.Start)
                if turtleSoups.size() >= 5
                    turtleSoups.pop()
                turtleSoups.unshift(turtleSoup)
                if not settings.Confirmation
                    turtleSoupsContext.AlertMessages.unshift(pa_TurtleSoupAlert('Turtle soup (NOT confirmed)', turtleSoup, settings))

pa_GetPivots(PA_TurtleSoupSettings settings) =>
    PA_Pivot pivotHigh = na
    PA_Pivot pivotLow = na
    pivotHighPrice = ta.pivothigh(settings.PivotLeftLenght, settings.PivotRightLenght)
    pivotLowPrice = ta.pivotlow(settings.PivotLeftLenght, settings.PivotRightLenght)
    if not na(pivotHighPrice)
        pivotHigh := PA_Pivot.new(pivotHighPrice, Type = 1, Time = time[settings.PivotRightLenght])
    if not na(pivotLowPrice)
        pivotLow := PA_Pivot.new(pivotLowPrice, Type = -1, Time = time[settings.PivotRightLenght])
    [pivotHigh, pivotLow]

pa_SetPivots(PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings, PA_Pivot pivotHigh, PA_Pivot pivotLow) =>
    if not na(pivotHigh)
        if turtleSoupsContext.Highs.size() >= settings.Lookback
            turtleSoupsContext.Highs.pop()
        turtleSoupsContext.Highs.unshift(pivotHigh)
    if not na(pivotLow)
        if turtleSoupsContext.Lows.size() >= settings.Lookback
            turtleSoupsContext.Lows.pop()
        turtleSoupsContext.Lows.unshift(pivotLow)

pa_Confirm(array<PA_TurtleSoup> turtleSoups, PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings, int earliest, int latest, PA_Screener screener) =>
    for turtleSoup in turtleSoups
        if not turtleSoup.Visible and turtleSoup.End >= earliest and turtleSoup.End <= latest and turtleSoup.Pivot.BarIndex >= earliest
            turtleSoup.Line.set_color(color.new(settings.Color, 0))
            turtleSoup.Box.set_bgcolor(settings.Color)
            turtleSoup.Box.set_text_color(settings.Color)
            turtleSoup.Visible := true
            turtleSoupsContext.AlertMessages.unshift(pa_TurtleSoupAlert('Turtle soup (confirmed)', turtleSoup, settings))
            screener.TurtleSoupUntilBarIndex := bar_index + settings.ScreenerKeep

pa_Liquidation(PA_Liquidity liquidity, PA_Pivot pivot) =>
    switch pivot.Type
        -1 =>
            if low[liquidity.LiquidityConfirmationBars] <= pivot.Price and close[liquidity.LiquidityConfirmationBars] >= pivot.Price
                if liquidity.LiquidityConfirmationBars > 0
                    confirmed = true
                    for i = liquidity.LiquidityConfirmationBars - 1 to 0
                        if close[i] < pivot.Price
                            confirmed := false
                            break
                    confirmed
                else
                    true
        1 =>
            if high[liquidity.LiquidityConfirmationBars] >= pivot.Price and close[liquidity.LiquidityConfirmationBars] <= pivot.Price
                if liquidity.LiquidityConfirmationBars > 0
                    confirmed = true
                    for i = liquidity.LiquidityConfirmationBars - 1 to 0
                        if close[i] > pivot.Price
                            confirmed := false
                            break
                    confirmed
                else
                    true

method VisualizeLiquidations(array<PA_Pivot> pivots, PA_Liquidity liquidity) =>
    for pivot in pivots
        if bar_index < pivot.BarIndex + liquidity.LiquidityConfirmationBars + 1
            continue
        if not pivot.LiquidityBroken
            if pa_Liquidation(liquidity, pivot)
                limitLine = line.new(pivot.BarIndex, pivot.Price, bar_index - liquidity.LiquidityConfirmationBars, pivot.Price, color = color.orange, style = line.style_dotted)
                breakLine = switch pivot.Type
                    -1 => line.new(pivot.BarIndex, low[liquidity.LiquidityConfirmationBars], bar_index - liquidity.LiquidityConfirmationBars, low[liquidity.LiquidityConfirmationBars], color = na)
                    1 => line.new(pivot.BarIndex, high[liquidity.LiquidityConfirmationBars], bar_index - liquidity.LiquidityConfirmationBars, high[liquidity.LiquidityConfirmationBars], color = na)
                linefill.new(limitLine, breakLine, color.new(color.orange, 80))
                switch pivot.Type
                    -1 => label.new(bar_index - liquidity.LiquidityConfirmationBars - ((bar_index - liquidity.LiquidityConfirmationBars - pivot.BarIndex) / 2), pivot.Price, '$$$', size = liquidity.FontSize, color = color(na), textcolor = color.new(color.orange, 30), style = label.style_label_up)
                    1 => label.new(bar_index - liquidity.LiquidityConfirmationBars - ((bar_index - liquidity.LiquidityConfirmationBars - pivot.BarIndex) / 2), pivot.Price, '$$$', size = liquidity.FontSize, color = color(na), textcolor = color.new(color.orange, 30))
                pivot.LiquidityBroken := true
            else
                switch pivot.Type
                    -1 =>
                        if close < pivot.Price
                            pivot.LiquidityBroken := true
                    1 =>
                        if close > pivot.Price
                            pivot.LiquidityBroken := true

pa_Liqudity(PA_Liquidity liquidity) =>
    if barstate.isconfirmed
        liquidity.LiquidityPivotsHigh.VisualizeLiquidations(liquidity)
        liquidity.LiquidityPivotsLow.VisualizeLiquidations(liquidity)
    pivotHigh = ta.pivothigh(1, 1)
    pivotLow = ta.pivotlow(1, 1)
    if not na(pivotHigh)
        if liquidity.LiquidityPivotsHigh.size() >= liquidity.LiquidityPivotsLookback
            liquidity.LiquidityPivotsHigh.pop()
        liquidity.LiquidityPivotsHigh.unshift(PA_Pivot.new(pivotHigh, bar_index - 1, 1))
    if not na(pivotLow)
        if liquidity.LiquidityPivotsLow.size() >= liquidity.LiquidityPivotsLookback
            liquidity.LiquidityPivotsLow.pop()
        liquidity.LiquidityPivotsLow.unshift(PA_Pivot.new(pivotLow, bar_index - 1, -1))

method BrokenByBar(PA_Pivot pivot) =>
    broken = false
    for i = 1 to bar_index - 1 - pivot.BarIndex
        switch pivot.Type
            1 =>
                if low[i] > pivot.Price
                    broken := true
                    break
            -1 =>
                if high[i] < pivot.Price
                    broken := true
                    break
    broken

method BrokenByBarZone(box zone, int type) =>
    broken = false
    for i = 1 to bar_index - 1 - zone.get_left()
        switch type
            1 =>
                if low[i] > zone.get_top()
                    broken := true
                    break
            -1 =>
                if high[i] < zone.get_bottom()
                    broken := true
                    break
    broken

pa_InLimits(float highLimit, float lowLimit, float price) =>
    price >= lowLimit and price <= highLimit

pa_Pivot(PA_Structure structure) =>
    pivotHigh = ta.pivothigh(structure.LeftLength, structure.RightLength)
    pivotLow = ta.pivotlow(structure.LeftLength, structure.RightLength)
    if not na(pivotHigh)
        if structure.Pivots.size() > 5
            structure.Pivots.pop()
        structure.Pivots.unshift(PA_Pivot.new(pivotHigh, bar_index - structure.RightLength, 1, time[structure.RightLength]))
    if not na(pivotLow)
        if structure.Pivots.size() > 5
            structure.Pivots.pop()
        structure.Pivots.unshift(PA_Pivot.new(pivotLow, bar_index - structure.RightLength, -1, time[structure.RightLength]))

pa_PivotLabels(PA_Structure structure) =>
    txt = ''
    for pivot in structure.Pivots
        if pivot.BarIndex == bar_index - structure.RightLength
            for i = 1 to structure.Pivots.size() - 1
                if structure.Pivots.size() == 1
                    break
                previousPivot = structure.Pivots.get(i)
                if previousPivot.Type != pivot.Type or previousPivot.BarIndex == pivot.BarIndex
                    continue
                if pivot.Price == previousPivot.Price
                    txt := 'EQ'
                else if pivot.Price > previousPivot.Price
                    txt := 'H'
                else if pivot.Price < previousPivot.Price
                    txt := 'L'
                break
            transparency = switch structure.Type
                PA_Type.Internal => 60
                PA_Type.Swing => 20
            switch pivot.Type
                -1 => txt += 'L', label.new(pivot.BarIndex, pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.teal, transparency), style = label.style_label_up)
                1 => txt += 'H', label.new(pivot.BarIndex, pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.red, transparency))

pa_EqualHighOrLow(PA_Structure structure) =>
    retestHigh = high < high[1] and high[1] > high[2]
    retestLow = low > low[1] and low[1] < low[2]
    if retestHigh
        for equalPivot in structure.EqualHighs
            price = high[1]
            lowLimit = equalPivot.get_bottom() - (pa_atr * (structure.EqualPivotsFactor / 100.))
            highLimit = equalPivot.get_top()
            if pa_InLimits(highLimit, lowLimit, price)
                if not equalPivot.BrokenByBarZone(1)
                    if price < equalPivot.get_bottom()
                        equalPivot.set_rightbottom(bar_index - 1, price)
                    else
                        equalPivot.set_right(bar_index - 1)
                        equalPivot.set_top(price)
                    label.new(bar_index - 1, price, style = structure.ExtendEqualPivotsStyle, size = structure.FontSize, color = color.new(structure.ExtendEqualPivotsColor, 70))
                    if structure.AlerEqualPivots
                        pa_alertOnce('Added bar to existing equal high')
    if retestLow
        for equalPivot in structure.EqualLows
            price = low[1]
            lowLimit = equalPivot.get_bottom()
            highLimit = equalPivot.get_top() + (pa_atr * (structure.EqualPivotsFactor / 100.))
            if pa_InLimits(highLimit, lowLimit, price)
                if not equalPivot.BrokenByBarZone(-1)
                    if price < equalPivot.get_bottom()
                        equalPivot.set_rightbottom(bar_index - 1, price)
                    else
                        equalPivot.set_right(bar_index - 1)
                        equalPivot.set_top(price)
                    label.new(bar_index - 1, price, style = structure.ExtendEqualPivotsStyle, size = structure.FontSize, color = color.new(structure.ExtendEqualPivotsColor, 70))
                    if structure.AlerEqualPivots
                        pa_alertOnce('Added bar to existing equal low')
    for pivot in structure.Pivots
        price = 0., lowLimit = 0., highLimit = 0.
        switch pivot.Type
            -1 =>
                if not retestLow
                    continue
                price := low[1]
                lowLimit := pivot.Price
                highLimit := pivot.Price + (pa_atr * (structure.EqualPivotsFactor / 100.))
            1 =>
                if not retestHigh
                    continue
                price := high[1]
                lowLimit := pivot.Price - (pa_atr * (structure.EqualPivotsFactor / 100.))
                highLimit := pivot.Price
        if pa_InLimits(highLimit, lowLimit, price)
            if not pivot.BrokenByBar()
                left = pivot.BarIndex, right = bar_index - 1, top = math.max(price, pivot.Price), bottom = math.min(price, pivot.Price)
                exactSamePivotPrice = pivot.Price == price
                equalPivotsBox = box.new(left, top, right, bottom, bgcolor = color.new(structure.ExtendEqualPivotsColor, 70), text = 'Equal low', text_color = structure.ExtendEqualPivotsColor, border_width = exactSamePivotPrice ? 1 : 0, border_color = structure.ExtendEqualPivotsColor, extend = structure.ExtendEqualPivotsZones ? extend.right : extend.none)
                label.new(bar_index - 1, price, size = structure.FontSize, style = structure.ExtendEqualPivotsStyle, color = color.new(structure.ExtendEqualPivotsColor, 70))
                label.new(pivot.BarIndex, pivot.Price, size = structure.FontSize, style = structure.ExtendEqualPivotsStyle, color = color.new(structure.ExtendEqualPivotsColor, 70))
                switch pivot.Type
                    -1 =>
                        equalPivotsBox.set_text('Equal low')
                        structure.EqualLows.unshift(equalPivotsBox)
                        if structure.AlerEqualPivots
                            pa_alertOnce('Equal low appeared')
                    1 =>
                        equalPivotsBox.set_text('Equal high')
                        structure.EqualHighs.unshift(equalPivotsBox)
                        if structure.AlerEqualPivots
                            pa_alertOnce('Equal high appeared')

pa_BreakOfStructure(PA_Structure structure) =>
    var alerMessageFormat = 'BOS on {0} on {1} market structure'
    PA_Pivot breakOfStructureOccured = na
    lineStyle = switch structure.Type
        PA_Type.Swing => line.style_solid
        PA_Type.Internal => line.style_dashed
    for pivot in structure.Pivots
        if structure.Trend == 1 and pivot.Type == 1 and close > pivot.Price and not pivot.BreakOfStructureBroken
            create = true
            for breakOfStructure in structure.BreakOfStructures
                barIndex = breakOfStructure.Line.get_x1()
                if barIndex > pivot.BarIndex
                    price = breakOfStructure.Line.get_y1()
                    if price < pivot.Price
                        breakOfStructure.Line.delete()
                        breakOfStructure.Label.delete()
                    else
                        create := false
                        break
            if create
                structure.BreakOfStructures.unshift(PA_StructureBreak.new(
                  line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.teal, style = lineStyle),
                  label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, 'BOS', size = structure.FontSize, color = color(na), textcolor = color.new(color.teal, 30))))
                pivot.BreakOfStructureBroken := true
                switch structure.Type
                    PA_Type.Internal =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'an uptrend', 'internal'))
                    PA_Type.Swing =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'an uptrend', 'swing'))
                breakOfStructureOccured := pivot
                break
        else if structure.Trend == -1 and pivot.Type == -1 and close < pivot.Price and not pivot.BreakOfStructureBroken
            create = true
            for breakOfStructure in structure.BreakOfStructures
                barIndex = breakOfStructure.Line.get_x1()
                if barIndex > pivot.BarIndex
                    price = breakOfStructure.Line.get_y1()
                    if price > pivot.Price
                        breakOfStructure.Line.delete()
                        breakOfStructure.Label.delete()
                    else
                        create := false
                        break
            if create
                structure.BreakOfStructures.unshift(PA_StructureBreak.new(
                  line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.red, style = lineStyle),
                  label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, 'BOS', size = structure.FontSize, color = color(na), textcolor = color.new(color.red, 30), style = label.style_label_up)))
                pivot.BreakOfStructureBroken := true
                switch structure.Type
                    PA_Type.Internal =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'a downtrend', 'internal'))
                    PA_Type.Swing =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'a downtrend', 'swing'))
                breakOfStructureOccured := pivot
                break
    breakOfStructureOccured

pa_ChangeOfCharacter(PA_Structure structure) =>
    var alerMessageFormat = '{0} to {1} on {2} market structure'
    PA_Pivot changeOfCharacterOccured = na
    lineStyle = switch structure.Type
        PA_Type.Internal => line.style_dashed
        PA_Type.Swing => line.style_solid
    for pivot in structure.Pivots
        if structure.Trend <= 0 and pivot.Type == 1 and close > pivot.Price and close[1] < pivot.Price and not(pivot.ChangeOfCharacterBroken)
            pivot.ChangeOfCharacterBroken := true
            txt = 'CHoCH'
            if structure.Pivots.size() >= 2 and structure.Trend != 0
                for i = 0 to structure.Pivots.size() - 2
                    latestPivot = structure.Pivots.get(i)
                    if latestPivot.Type == -1
                        for j = i + 1 to structure.Pivots.size() - 2
                            nextLatestPivot = structure.Pivots.get(j)
                            if nextLatestPivot.Type == -1
                                if latestPivot.Price > nextLatestPivot.Price
                                    txt := 'CHoCH+'
                                break
                        break
            line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.teal, style = lineStyle)
            label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.teal, 30))
            structure.Trend := 1
            structure.EqualHighs.clear(), structure.EqualLows.clear()
            structure.BreakOfStructures.clear()
            remove = array.new<int>()
            for [i, p] in structure.Pivots
                if p.BarIndex <= pivot.BarIndex
                    remove.push(i)
                else
                    p.BreakOfStructureBroken := true
            for [i, r] in remove
                structure.Pivots.remove(r - i)
            for p in structure.Pivots
                if p.BarIndex != pivot.BarIndex
                    p.ChangeOfCharacterBroken := false
            switch structure.Type
                PA_Type.Internal =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'an uptrend', 'internal'))
                PA_Type.Swing =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'an uptrend', 'swing'))
            changeOfCharacterOccured := pivot
            break
        else if structure.Trend >= 0 and pivot.Type == -1 and close < pivot.Price and close[1] > pivot.Price and not(pivot.ChangeOfCharacterBroken)
            pivot.ChangeOfCharacterBroken := true
            txt = 'CHoCH'
            if structure.Pivots.size() >= 2 and structure.Trend != 0
                for i = 0 to structure.Pivots.size() - 2
                    latestPivot = structure.Pivots.get(i)
                    if latestPivot.Type == 1
                        for j = i + 1 to structure.Pivots.size() - 2
                            nextLatestPivot = structure.Pivots.get(j)
                            if nextLatestPivot.Type == 1
                                if latestPivot.Price < nextLatestPivot.Price
                                    txt := 'CHoCH+'
                                break
                        break
            line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.red, style = lineStyle)
            label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.red, 30), style = label.style_label_up)
            structure.Trend := -1
            structure.EqualHighs.clear(), structure.EqualLows.clear()
            structure.BreakOfStructures.clear()
            remove = array.new<int>()
            for [i, p] in structure.Pivots
                if p.BarIndex <= pivot.BarIndex
                    remove.push(i)
                else
                    p.BreakOfStructureBroken := true
            for [i, r] in remove
                structure.Pivots.remove(r - i)
            for p in structure.Pivots
                if p.BarIndex != pivot.BarIndex
                    p.ChangeOfCharacterBroken := false
            switch structure.Type
                PA_Type.Internal =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'a downtrend', 'internal'))
                PA_Type.Swing =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'a downtrend', 'swing'))
            changeOfCharacterOccured := pivot
            break
    changeOfCharacterOccured

// ============================================================================
// --- STATE (var-initialised once) ---
// ============================================================================
var PA_PriceAction ts_priceAction = PA_PriceAction.new(Swing = PA_Structure.new(ts_msLeft, ts_msRight, PA_Type.Swing, 0, ts_eqFactor, ts_eqExtend, label.style_label_down, ts_eqColor, array.new<box>(), array.new<box>(), array.new<PA_StructureBreak>(), array.new<PA_Pivot>(), ts_fontSize, ts_alertMS, ts_alertMS, ts_alertEq))
var PA_Liquidity ts_liquidity = PA_Liquidity.new(array.new<PA_Pivot>(), array.new<PA_Pivot>(), ts_liqConfirm, ts_liqLookback, ts_fontSize)
var PA_TurtleSoupSettings ts_settings = PA_TurtleSoupSettings.new(ts_soupLeft, ts_soupRight, ts_soupLookback, ts_soupConfirm, ts_soupColor, ts_screenerKeep, ts_alertFreq)
var PA_TurtleSoups ts_context = PA_TurtleSoups.new(array.new<PA_Pivot>(), array.new<PA_Pivot>(), array.new<PA_TurtleSoup>(), array.new<PA_TurtleSoup>(), array.new<string>())
var PA_Screener ts_screener = PA_Screener.new()

// ============================================================================
// --- HTF pivots fetched UNCONDITIONALLY (request.security cannot be gated) ---
// ============================================================================
[ts_pivotHigh, ts_pivotLow] = request.security(syminfo.tickerid, ts_soupTf, pa_GetPivots(ts_settings))

// ============================================================================
// --- EXECUTION (gated by enableTS) ---
// ============================================================================
var int ts_previousStructureBreakBarIndex = na

if enableTS
    // market-structure pivots + labels
    pa_Pivot(ts_priceAction.Swing)
    if ts_showPivots
        pa_PivotLabels(ts_priceAction.Swing)

    // turtle soups on confirmed bars
    if barstate.isconfirmed
        pa_VisualizeTurtleSoups(ts_context.Highs, ts_context.Bearish, ts_context, ts_settings)
        pa_VisualizeTurtleSoups(ts_context.Lows, ts_context.Bullish, ts_context, ts_settings)

    // structure breaks
    ts_choch = false
    ts_bos   = false
    if barstate.isconfirmed
        if ts_showCHoCH
            ts_choch := not na(pa_ChangeOfCharacter(ts_priceAction.Swing))
        if ts_showBOS
            ts_bos := not na(pa_BreakOfStructure(ts_priceAction.Swing))

    // confirmed turtle-soup validation
    if ts_settings.Confirmation
        if ts_choch and not na(ts_previousStructureBreakBarIndex)
            switch ts_priceAction.Swing.Trend
                -1 => pa_Confirm(ts_context.Bearish, ts_context, ts_settings, ts_previousStructureBreakBarIndex, bar_index, ts_screener)
                1  => pa_Confirm(ts_context.Bullish, ts_context, ts_settings, ts_previousStructureBreakBarIndex, bar_index, ts_screener)
        if ts_choch or ts_bos
            ts_previousStructureBreakBarIndex := bar_index

    // equal high/low zones
    if ts_showEqual
        pa_EqualHighOrLow(ts_priceAction.Swing)

    // liquidity sweeps ($$$)
    if ts_showLiq
        pa_Liqudity(ts_liquidity)

    // register HTF soup pivots
    pa_SetBarIndices(ts_pivotHigh, ts_pivotLow)
    pa_SetPivots(ts_context, ts_settings, ts_pivotHigh, ts_pivotLow)

    // fire queued alerts
    pa_AlertContext(ts_context, ts_settings)

// Pine Screener plot (kept outside the gate — plot() must be top-level)
plot(enableTS and bar_index <= ts_screener.TurtleSoupUntilBarIndex ? 1 : 0, 'Turtle soup', display = display.none, precision = 0)

//═════════════════════════════════════════════════════════════════════════════
//                    SIXTH LAYER  —  OTE (Optimal Trade Entry)
//  ORIGINAL implementation of the publicly-taught ICT OTE / golden-pocket /
//  Fibonacci-retracement concepts. NOT derived from any closed-source script —
//  written from scratch: confirmed-pivot swing engine, ATR-scaled leg filter,
//  golden-pocket (0.618–0.66) box, CE midline, 7-level adjustable fib grid,
//  and body-close invalidation with adjustable tolerance.
//  Master switch: enableOTE (default OFF). Draws the single most-recent
//  qualifying leg's zone (light object footprint, recreated at draw time).
//═════════════════════════════════════════════════════════════════════════════

// ============================================================================
// --- MASTER TOGGLE + GENERAL INPUTS ---
// ============================================================================
OTE_GROUP     = 'OTE (Optimal Trade Entry) 🎯'
enableOTE     = input.bool(false, '● Enable OTE Module', group = OTE_GROUP, tooltip = 'Original OTE / golden-pocket tool. Finds the most recent qualifying swing leg, draws the 0.618–0.66 golden pocket, a CE midline, and an adjustable 7-level Fibonacci grid. Educational visual aid only — no signals. Draws one zone at a time (light on objects).')
oteSensitivity = input.string('Normal', 'Sensitivity', options = ['Sensitive','Normal','Strict'], group = OTE_GROUP, tooltip = 'Sets pivot lookback AND the ATR leg-size filter together.\nSensitive = pivots 5, leg ≥ 1×ATR (more zones).\nNormal = pivots 8, leg ≥ 2×ATR.\nStrict = pivots 12, leg ≥ 3×ATR (fewer, cleaner zones).')
oteInvalTol   = input.string('Normal', 'Invalidation tolerance', options = ['Strict','Normal','Loose'], group = OTE_GROUP, tooltip = 'Buffer beyond the 0.786 level before a zone is considered broken, as a multiple of the golden-pocket box width.\nStrict = 0× (breaks immediately past 0.786).\nNormal = 0.5×.\nLoose = 1×.')
oteExtend     = input.int(10, 'Extend right (bars)', minval = 1, maxval = 100, group = OTE_GROUP)
oteLineWidth  = input.int(1, 'Line thickness', minval = 1, maxval = 4, group = OTE_GROUP)

OTE_BOX_GROUP = 'OTE ▸ Box, CE & Label'
oteShowBox    = input.bool(true,  'Golden-pocket box (0.618–0.66)', group = OTE_BOX_GROUP)
oteBullCss    = input.color(color.new(#089981, 80), 'Bullish box', inline = 'obx', group = OTE_BOX_GROUP)
oteBearCss    = input.color(color.new(#f23645, 80), 'Bearish box', inline = 'obx', group = OTE_BOX_GROUP)
oteShowCE     = input.bool(true,  'CE midline (50% of box)', inline = 'oce', group = OTE_BOX_GROUP)
oteCeCss      = input.color(color.new(color.gray, 0), '',    inline = 'oce', group = OTE_BOX_GROUP)
oteShowLabel  = input.bool(true,  'Zone label', inline = 'olb', group = OTE_BOX_GROUP)
oteLabelCss   = input.color(color.new(color.white, 0), '',   inline = 'olb', group = OTE_BOX_GROUP)
oteLabelSize  = input.string(size.small, 'Label size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = OTE_BOX_GROUP)

// ============================================================================
// --- FIBONACCI GRID (7 independent levels) ---
// ============================================================================
OTE_FIB_GROUP = 'OTE ▸ Fibonacci levels'
oteF1On = input.bool(true,  '', inline='f1', group=OTE_FIB_GROUP)
oteF1R  = input.float(0.382, '', inline='f1', group=OTE_FIB_GROUP, step=0.001)
oteF1Cs = input.color(color.new(#787b86, 0), '', inline='f1', group=OTE_FIB_GROUP)
oteF1St = input.string('Dashed', '', options=['Solid','Dashed','Dotted'], inline='f1', group=OTE_FIB_GROUP)
oteF1Lb = input.bool(true,  'lbl', inline='f1', group=OTE_FIB_GROUP)

oteF2On = input.bool(true,  '', inline='f2', group=OTE_FIB_GROUP)
oteF2R  = input.float(0.5,   '', inline='f2', group=OTE_FIB_GROUP, step=0.001)
oteF2Cs = input.color(color.new(#787b86, 0), '', inline='f2', group=OTE_FIB_GROUP)
oteF2St = input.string('Dashed', '', options=['Solid','Dashed','Dotted'], inline='f2', group=OTE_FIB_GROUP)
oteF2Lb = input.bool(true,  'lbl', inline='f2', group=OTE_FIB_GROUP)

oteF3On = input.bool(true,  '', inline='f3', group=OTE_FIB_GROUP)
oteF3R  = input.float(0.618, '', inline='f3', group=OTE_FIB_GROUP, step=0.001)
oteF3Cs = input.color(color.new(#f7931a, 0), '', inline='f3', group=OTE_FIB_GROUP)
oteF3St = input.string('Solid', '', options=['Solid','Dashed','Dotted'], inline='f3', group=OTE_FIB_GROUP)
oteF3Lb = input.bool(true,  'lbl', inline='f3', group=OTE_FIB_GROUP)

oteF4On = input.bool(true,  '', inline='f4', group=OTE_FIB_GROUP)
oteF4R  = input.float(0.66,  '', inline='f4', group=OTE_FIB_GROUP, step=0.001)
oteF4Cs = input.color(color.new(#f7931a, 0), '', inline='f4', group=OTE_FIB_GROUP)
oteF4St = input.string('Solid', '', options=['Solid','Dashed','Dotted'], inline='f4', group=OTE_FIB_GROUP)
oteF4Lb = input.bool(true,  'lbl', inline='f4', group=OTE_FIB_GROUP)

oteF5On = input.bool(true,  '', inline='f5', group=OTE_FIB_GROUP)
oteF5R  = input.float(0.705, '', inline='f5', group=OTE_FIB_GROUP, step=0.001)
oteF5Cs = input.color(color.new(#2962ff, 0), '', inline='f5', group=OTE_FIB_GROUP)
oteF5St = input.string('Dashed', '', options=['Solid','Dashed','Dotted'], inline='f5', group=OTE_FIB_GROUP)
oteF5Lb = input.bool(true,  'lbl', inline='f5', group=OTE_FIB_GROUP)

oteF6On = input.bool(true,  '', inline='f6', group=OTE_FIB_GROUP)
oteF6R  = input.float(0.786, '', inline='f6', group=OTE_FIB_GROUP, step=0.001)
oteF6Cs = input.color(color.new(#e91e63, 0), '', inline='f6', group=OTE_FIB_GROUP)
oteF6St = input.string('Solid', '', options=['Solid','Dashed','Dotted'], inline='f6', group=OTE_FIB_GROUP)
oteF6Lb = input.bool(true,  'lbl', inline='f6', group=OTE_FIB_GROUP)

oteF7On = input.bool(false, '', inline='f7', group=OTE_FIB_GROUP)
oteF7R  = input.float(1.0,   '', inline='f7', group=OTE_FIB_GROUP, step=0.001)
oteF7Cs = input.color(color.new(#787b86, 0), '', inline='f7', group=OTE_FIB_GROUP)
oteF7St = input.string('Dotted', '', options=['Solid','Dashed','Dotted'], inline='f7', group=OTE_FIB_GROUP)
oteF7Lb = input.bool(true,  'lbl', inline='f7', group=OTE_FIB_GROUP)

// ============================================================================
// --- PRESETS ---
// ============================================================================
otePivLen  = switch oteSensitivity
    'Sensitive' => 5
    'Strict'    => 12
    => 8
oteAtrMult = switch oteSensitivity
    'Sensitive' => 1.0
    'Strict'    => 3.0
    => 2.0
oteTolMult = switch oteInvalTol
    'Strict' => 0.0
    'Loose'  => 1.0
    => 0.5

oteAtr = ta.atr(14)

f_oteStyle(string s) => s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

// ============================================================================
// --- SWING ENGINE (runs UNCONDITIONALLY — ta.* must be called every bar) ---
// ============================================================================
otePH = ta.pivothigh(otePivLen, otePivLen)
otePL = ta.pivotlow(otePivLen, otePivLen)

var float oteLastPH    = na
var int   oteLastPHbar = na
var float oteLastPL    = na
var int   oteLastPLbar = na

// active zone state
var int   oteDir       = 0     // 1 = bullish leg, -1 = bearish leg
var float oteHi        = na
var float oteLo        = na
var int   oteHiBar     = na
var int   oteLoBar     = na
var bool  oteActive    = false
var bool  oteInval     = false

// detect a new qualifying leg the moment a pivot confirms
if not na(otePH) and not na(oteLastPL)
    legHi = otePH
    legLo = oteLastPL
    if legHi > legLo and (legHi - legLo) >= oteAtr * oteAtrMult
        oteDir    := 1
        oteHi     := legHi
        oteLo     := legLo
        oteHiBar  := bar_index - otePivLen
        oteLoBar  := oteLastPLbar
        oteActive := true
        oteInval  := false

if not na(otePL) and not na(oteLastPH)
    legHi = oteLastPH
    legLo = otePL
    if legHi > legLo and (legHi - legLo) >= oteAtr * oteAtrMult
        oteDir    := -1
        oteHi     := legHi
        oteLo     := legLo
        oteHiBar  := oteLastPHbar
        oteLoBar  := bar_index - otePivLen
        oteActive := true
        oteInval  := false

// store the confirmed pivots AFTER leg detection (so a new pivot pairs with the prior opposite one)
if not na(otePH)
    oteLastPH    := otePH
    oteLastPHbar := bar_index - otePivLen
if not na(otePL)
    oteLastPL    := otePL
    oteLastPLbar := bar_index - otePivLen

// fib price at retracement ratio r (0 = recent extreme, 1 = leg origin)
f_otePrice(float r) => oteDir == 1 ? oteHi - r * (oteHi - oteLo) : oteLo + r * (oteHi - oteLo)

// ============================================================================
// --- INVALIDATION (confirmed body close beyond 0.786 ± tolerance) ---
// ============================================================================
if enableOTE and oteActive and not oteInval and barstate.isconfirmed
    invalLevel = f_otePrice(0.786)
    bw         = math.abs(f_otePrice(0.618) - f_otePrice(0.66))
    buf        = oteTolMult * bw
    if oteDir == 1 and close < invalLevel - buf
        oteInval := true
    if oteDir == -1 and close > invalLevel + buf
        oteInval := true

// ============================================================================
// --- DRAW (recreate at draw time → newest objects, eviction-safe) ---
// ============================================================================
var box            oteBox   = na
var line           oteCe    = na
var label          oteLbl   = na
var array<line>    oteFibLn = array.new<line>()
var array<label>   oteFibLb = array.new<label>()

f_oteFib(bool on, float r, color css, string st, bool lbl, int leftX, int rightX) =>
    if on
        float p = f_otePrice(r)
        oteFibLn.push(line.new(leftX, p, rightX, p, xloc = xloc.bar_index, color = css, style = f_oteStyle(st), width = oteLineWidth))
        if lbl
            oteFibLb.push(label.new(rightX, p, str.tostring(r, '0.###'), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(css, 100), textcolor = css, size = oteLabelSize))

if barstate.islast
    // clear previous drawings — done at top level (not in a function) so the
    // global handles can be reassigned to na with := (CE10088 forbids that inside a function)
    if not na(oteBox)
        oteBox.delete()
    if not na(oteCe)
        oteCe.delete()
    if not na(oteLbl)
        oteLbl.delete()
    for l in oteFibLn
        l.delete()
    oteFibLn.clear()
    for lb in oteFibLb
        lb.delete()
    oteFibLb.clear()
    oteBox := na
    oteCe  := na
    oteLbl := na
    if enableOTE and oteActive and not oteInval and not na(oteHi) and not na(oteLo)
        int leftX  = math.min(oteHiBar, oteLoBar)
        int rightX = bar_index + oteExtend
        float gpTop = math.max(f_otePrice(0.618), f_otePrice(0.66))
        float gpBot = math.min(f_otePrice(0.618), f_otePrice(0.66))
        color boxCss = oteDir == 1 ? oteBullCss : oteBearCss

        // golden-pocket box
        if oteShowBox
            oteBox := box.new(leftX, gpTop, rightX, gpBot, xloc = xloc.bar_index, border_color = color.new(boxCss, 40), bgcolor = boxCss)

        // CE midline (50% of the box)
        if oteShowCE
            float ce = math.avg(gpTop, gpBot)
            oteCe := line.new(leftX, ce, rightX, ce, xloc = xloc.bar_index, color = oteCeCss, style = line.style_dotted, width = oteLineWidth)

        // 7-level fib grid
        f_oteFib(oteF1On, oteF1R, oteF1Cs, oteF1St, oteF1Lb, leftX, rightX)
        f_oteFib(oteF2On, oteF2R, oteF2Cs, oteF2St, oteF2Lb, leftX, rightX)
        f_oteFib(oteF3On, oteF3R, oteF3Cs, oteF3St, oteF3Lb, leftX, rightX)
        f_oteFib(oteF4On, oteF4R, oteF4Cs, oteF4St, oteF4Lb, leftX, rightX)
        f_oteFib(oteF5On, oteF5R, oteF5Cs, oteF5St, oteF5Lb, leftX, rightX)
        f_oteFib(oteF6On, oteF6R, oteF6Cs, oteF6St, oteF6Lb, leftX, rightX)
        f_oteFib(oteF7On, oteF7R, oteF7Cs, oteF7St, oteF7Lb, leftX, rightX)

        // zone label
        if oteShowLabel
            float ly = math.avg(gpTop, gpBot)
            oteLbl := label.new(leftX, ly, oteDir == 1 ? 'Bullish OTE' : 'Bearish OTE', xloc = xloc.bar_index, style = oteDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(oteDir == 1 ? oteBullCss : oteBearCss, 0), textcolor = oteLabelCss, size = oteLabelSize)

// ============================================================================
// --- OTE ALERTS ---
// ============================================================================
oteNewBull = oteActive and oteDir == 1 and (oteDir != oteDir[1] or oteHi != oteHi[1] or oteLo != oteLo[1])
oteNewBear = oteActive and oteDir == -1 and (oteDir != oteDir[1] or oteHi != oteHi[1] or oteLo != oteLo[1])
alertcondition(enableOTE and oteNewBull, 'OTE Bullish zone', 'New bullish OTE golden-pocket zone formed')
alertcondition(enableOTE and oteNewBear, 'OTE Bearish zone', 'New bearish OTE golden-pocket zone formed')


//              SEVENTH LAYER  —  Current (developing) Day / Week / Month H-L
//  Developing high & low of the current, in-progress day, week and month:
//    CDH/CDL = current day    CWH/CWL = current week    CMH/CML = current month
//  Each of the SIX levels has its own on/off toggle and colour — enable only
//  what you need. Running extremes tracked bar-by-bar (no request.security,
//  no lookahead → non-repainting). Distinct from the base "Highs & Lows MTF"
//  group, which shows the PREVIOUS completed period (PDH/PWH/PMH …).
//  Master switch: enableCurLvls (default OFF). Up to 6 lines + 6 labels.
//═════════════════════════════════════════════════════════════════════════════

// ============================================================================
// --- MASTER TOGGLE + PER-LEVEL INPUTS ---
// ============================================================================
CUR_GROUP     = 'Current D/W/M H-L 📏'
enableCurLvls = input.bool(false, '● Enable Current D/W/M Levels', group = CUR_GROUP, tooltip = 'Draws the DEVELOPING high/low of the current day, week and/or month. Each of the six levels below has its own toggle — enable only the ones you want. Non-repainting (running max/min, no lookahead). The base "Highs & Lows MTF" group instead shows the PREVIOUS completed period.')

curCDHon  = input.bool(false, 'CDH — Current Day High',   inline = 'cdh', group = CUR_GROUP)
curCDHcss = input.color(color.new(#ff9800, 0), '',         inline = 'cdh', group = CUR_GROUP)
curCDLon  = input.bool(false, 'CDL — Current Day Low',     inline = 'cdl', group = CUR_GROUP)
curCDLcss = input.color(color.new(#ff9800, 0), '',         inline = 'cdl', group = CUR_GROUP)

curCWHon  = input.bool(false, 'CWH — Current Week High',   inline = 'cwh', group = CUR_GROUP)
curCWHcss = input.color(color.new(#2157f3, 0), '',         inline = 'cwh', group = CUR_GROUP)
curCWLon  = input.bool(false, 'CWL — Current Week Low',    inline = 'cwl', group = CUR_GROUP)
curCWLcss = input.color(color.new(#2157f3, 0), '',         inline = 'cwl', group = CUR_GROUP)

curCMHon  = input.bool(false, 'CMH — Current Month High',  inline = 'cmh', group = CUR_GROUP)
curCMHcss = input.color(color.new(#9c27b0, 0), '',         inline = 'cmh', group = CUR_GROUP)
curCMLon  = input.bool(false, 'CML — Current Month Low',   inline = 'cml', group = CUR_GROUP)
curCMLcss = input.color(color.new(#9c27b0, 0), '',         inline = 'cml', group = CUR_GROUP)

curStyleIn = input.string('Dashed', 'Line style', options = ['Solid','Dashed','Dotted'], group = CUR_GROUP)
curWidth   = input.int(1, 'Line thickness', minval = 1, maxval = 4, group = CUR_GROUP)
curShowLbl = input.bool(true, 'Show labels', group = CUR_GROUP)
curLblSize = input.string(size.small, 'Label size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = CUR_GROUP)
curExtend  = input.int(10, 'Extend right (bars)', minval = 0, maxval = 100, group = CUR_GROUP)

f_curStyle(string s) => s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

// ============================================================================
// --- RUNNING EXTREMES (unconditional every bar → consistent, non-repainting) ---
// ============================================================================
curDStart  = time('D')
curWkStart = time('W')
curMoStart = time('M')
curNewD    = curDStart  != curDStart[1]    // true on first bar (prior = na) and each new period
curNewWk   = curWkStart != curWkStart[1]
curNewMo   = curMoStart != curMoStart[1]

var float curCDH   = na
var float curCDL   = na
var int   curDBar  = na
if na(curCDH) or curNewD
    curCDH  := high
    curCDL  := low
    curDBar := bar_index
else
    curCDH := math.max(curCDH, high)
    curCDL := math.min(curCDL, low)

var float curCWH   = na
var float curCWL   = na
var int   curWkBar = na
if na(curCWH) or curNewWk
    curCWH   := high
    curCWL   := low
    curWkBar := bar_index
else
    curCWH := math.max(curCWH, high)
    curCWL := math.min(curCWL, low)

var float curCMH   = na
var float curCML   = na
var int   curMoBar = na
if na(curCMH) or curNewMo
    curCMH   := high
    curCML   := low
    curMoBar := bar_index
else
    curCMH := math.max(curCMH, high)
    curCML := math.min(curCML, low)

// ============================================================================
// --- DRAW (recreate on last bar → newest objects, eviction-safe) ---
// ============================================================================
var array<line>  curLines  = array.new<line>()
var array<label> curLabels = array.new<label>()

f_curDraw(bool on, float lvl, int leftBar, int rightBar, color css, string txt) =>
    if on and not na(lvl)
        curLines.push(line.new(leftBar, lvl, rightBar, lvl, xloc = xloc.bar_index, color = css, width = curWidth, style = f_curStyle(curStyleIn)))
        if curShowLbl
            curLabels.push(label.new(rightBar, lvl, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(css, 100), textcolor = css, size = curLblSize))

if barstate.islast
    for l in curLines
        l.delete()
    curLines.clear()
    for lb in curLabels
        lb.delete()
    curLabels.clear()
    if enableCurLvls
        int curRightBar = bar_index + curExtend
        f_curDraw(curCDHon, curCDH, curDBar,  curRightBar, curCDHcss, 'CDH')
        f_curDraw(curCDLon, curCDL, curDBar,  curRightBar, curCDLcss, 'CDL')
        f_curDraw(curCWHon, curCWH, curWkBar, curRightBar, curCWHcss, 'CWH')
        f_curDraw(curCWLon, curCWL, curWkBar, curRightBar, curCWLcss, 'CWL')
        f_curDraw(curCMHon, curCMH, curMoBar, curRightBar, curCMHcss, 'CMH')
        f_curDraw(curCMLon, curCML, curMoBar, curRightBar, curCMLcss, 'CML')


//═════════════════════════════════════════════════════════════════════════════
//              EIGHTH LAYER  —  Buyside / Sellside Liquidity (BSL / SSL)
//  ORIGINAL implementation of the public ICT liquidity-pool concept. NOT
//  derived from any published script — written from scratch, no engine imported.
//
//  Convention (matches the BigBeluga labelling the user referenced):
//    • Sellside liquidity → rests at a SWING HIGH  (stops of longs sit above)
//    • Buyside  liquidity → rests at a SWING LOW   (stops of shorts sit below)
//  A pool is drawn from its pivot to the right. When price WICKS through the
//  level and closes back on the origin side, the pool is "swept": it recolours
//  to the swept style and stops extending. Optional volume-% tag shows that
//  pool's share of the two most-recent opposing pools' volume (own calc).
//
//  Fully configurable draw mode: Line / Area / Area + % tag. Master switch:
//  enableBSSL (default OFF). Recreated at draw time → eviction-safe.
//═════════════════════════════════════════════════════════════════════════════

// ============================================================================
// --- MASTER TOGGLE + INPUTS ---
// ============================================================================
BSSL_GROUP   = 'Buyside / Sellside Liquidity 💧'
enableBSSL   = input.bool(false, '● Enable Buyside/Sellside Liquidity', group = BSSL_GROUP, tooltip = 'Marks resting liquidity: Sellside at swing highs, Buyside at swing lows (BigBeluga labelling). Pools extend right until price sweeps them (wick through + close back), then recolour as swept. Original implementation — educational map, not a signal.')
bsslPivLen   = input.int(5, 'Pivot length', minval = 1, maxval = 50, group = BSSL_GROUP, tooltip = 'Left/right bars for the swing pivots that create liquidity pools. Higher = fewer, more significant pools.')
bsslMax      = input.int(5, 'Max pools each side', minval = 1, maxval = 20, group = BSSL_GROUP, tooltip = 'How many recent Buyside AND Sellside pools to keep (oldest dropped).')
bsslKeepSwept = input.bool(true, 'Keep pools after sweep', group = BSSL_GROUP, tooltip = 'ON = swept pools stay (recoloured) until dropped by the max-count. OFF = a pool is deleted the moment it is swept.')

bsslDrawMode = input.string('Area + line', 'Draw mode', options = ['Line','Area','Area + line','Area + line + % tag'], group = BSSL_GROUP, tooltip = 'Line = single level line only (lightest). Area = shaded pool box. Area + line = both. Area + line + % tag = adds the volume-share label (Buyside/Sellside - NN%).')
bsslAreaHeight = input.string('ATR', 'Area height basis', options = ['ATR','Pivot wick'], group = BSSL_GROUP, tooltip = 'ATR = fixed-height band around the level. Pivot wick = span from the pivot extreme to its candle body.')
bsslAtrMult  = input.float(0.5, 'Area height × ATR', minval = 0.05, step = 0.05, group = BSSL_GROUP, tooltip = 'Band thickness when height basis = ATR (× ATR200).')
bsslExtend   = input.int(15, 'Extend right (bars)', minval = 0, maxval = 100, group = BSSL_GROUP)
bsslWidth    = input.int(1, 'Line thickness', minval = 1, maxval = 4, group = BSSL_GROUP)
bsslStyle    = input.string('Solid', 'Line style', options = ['Solid','Dashed','Dotted'], group = BSSL_GROUP)
bsslLblSize  = input.string(size.small, 'Label size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = BSSL_GROUP)

BSSL_COL_GROUP = 'BSSL ▸ Colours'
bsslSellCss  = input.color(color.new(#f23645, 0),  'Sellside (swing high) line', group = BSSL_COL_GROUP)
bsslSellFill = input.color(color.new(#f23645, 80), 'Sellside area', group = BSSL_COL_GROUP)
bsslBuyCss   = input.color(color.new(#089981, 0),  'Buyside (swing low) line',  group = BSSL_COL_GROUP)
bsslBuyFill  = input.color(color.new(#089981, 80), 'Buyside area', group = BSSL_COL_GROUP)
bsslSweptCss = input.color(color.new(#787b86, 40), 'Swept line', inline = 'sw', group = BSSL_COL_GROUP)
bsslSweptFill= input.color(color.new(#787b86, 88), 'Swept area', inline = 'sw', group = BSSL_COL_GROUP)

// ============================================================================
// --- TYPE + HELPERS ---
// ============================================================================
type LiqPool
    int   dir          // 1 = sellside (high), -1 = buyside (low)
    float level        // the liquidity price (pivot extreme)
    float body         // pivot candle body edge (for wick-based area)
    int   startBar
    float vol          // volume on the pivot bar (for the % tag)
    bool  swept
    int   sweptBar

f_bsslStyle(string s) => s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

bsslAtr = ta.atr(200)

// ============================================================================
// --- STATE ---
// ============================================================================
var array<LiqPool> bsslSell = array.new<LiqPool>()   // at swing highs
var array<LiqPool> bsslBuy  = array.new<LiqPool>()   // at swing lows

// ============================================================================
// --- PIVOT DETECTION (unconditional every bar) ---
// ============================================================================
bsslPH = ta.pivothigh(high, bsslPivLen, bsslPivLen)
bsslPL = ta.pivotlow(low,  bsslPivLen, bsslPivLen)

if enableBSSL and not na(bsslPH)
    LiqPool p = LiqPool.new(dir = 1, level = bsslPH, body = math.max(open[bsslPivLen], close[bsslPivLen]), startBar = bar_index - bsslPivLen, vol = volume[bsslPivLen], swept = false, sweptBar = na)
    bsslSell.unshift(p)
    while bsslSell.size() > bsslMax
        bsslSell.pop()

if enableBSSL and not na(bsslPL)
    LiqPool p = LiqPool.new(dir = -1, level = bsslPL, body = math.min(open[bsslPivLen], close[bsslPivLen]), startBar = bar_index - bsslPivLen, vol = volume[bsslPivLen], swept = false, sweptBar = na)
    bsslBuy.unshift(p)
    while bsslBuy.size() > bsslMax
        bsslBuy.pop()

// ============================================================================
// --- SWEEP DETECTION (confirmed bars) ---
// ============================================================================
bool bsslSellSwept = false
bool bsslBuySwept  = false

if enableBSSL and barstate.isconfirmed
    // Sellside swept: wick above the high, close back below it
    i = 0
    while i < bsslSell.size()
        LiqPool p = bsslSell.get(i)
        if not p.swept and high > p.level and close < p.level
            p.swept    := true
            p.sweptBar := bar_index
            bsslSellSwept := true
            if not bsslKeepSwept
                bsslSell.remove(i)
                continue
        i += 1
    // Buyside swept: wick below the low, close back above it
    j = 0
    while j < bsslBuy.size()
        LiqPool p = bsslBuy.get(j)
        if not p.swept and low < p.level and close > p.level
            p.swept    := true
            p.sweptBar := bar_index
            bsslBuySwept := true
            if not bsslKeepSwept
                bsslBuy.remove(j)
                continue
        j += 1

// ============================================================================
// --- DRAW (recreate on last bar → newest objects, eviction-safe) ---
// ============================================================================
var array<line>  bsslLines  = array.new<line>()
var array<box>   bsslBoxes  = array.new<box>()
var array<label> bsslLabels = array.new<label>()

// volume-% of this pool vs the most-recent opposing pool (own calc for the tag)
f_bsslPct(LiqPool p) =>
    float opp = p.dir == 1 ? (bsslBuy.size() > 0 ? bsslBuy.first().vol : 0.0) : (bsslSell.size() > 0 ? bsslSell.first().vol : 0.0)
    float tot = p.vol + opp
    tot > 0 ? math.floor(p.vol / tot * 100) : 0

f_bsslDrawPool(LiqPool p, int rightX, bool drawLine, bool drawArea, bool drawTag) =>
    color lineCss = p.swept ? bsslSweptCss : (p.dir == 1 ? bsslSellCss : bsslBuyCss)
    color fillCss = p.swept ? bsslSweptFill : (p.dir == 1 ? bsslSellFill : bsslBuyFill)
    int   rx      = p.swept ? p.sweptBar : rightX

    if drawArea
        float band = bsslAreaHeight == 'ATR' ? bsslAtr * bsslAtrMult : math.abs(p.level - p.body)
        float top  = p.dir == 1 ? p.level : p.level + band
        float bot  = p.dir == 1 ? p.level - band : p.level
        if bsslAreaHeight == 'Pivot wick'
            top := p.dir == 1 ? p.level : p.body
            bot := p.dir == 1 ? p.body  : p.level
        bsslBoxes.push(box.new(p.startBar, top, rx, bot, xloc = xloc.bar_index, border_color = na, bgcolor = fillCss))

    if drawLine
        bsslLines.push(line.new(p.startBar, p.level, rx, p.level, xloc = xloc.bar_index, color = lineCss, width = bsslWidth, style = f_bsslStyle(bsslStyle)))

    if drawTag
        string nm  = p.dir == 1 ? 'Sellside' : 'Buyside'
        string txt = nm + ' - ' + str.tostring(f_bsslPct(p)) + '%'
        bsslLabels.push(label.new(bar_index, p.level, txt, xloc = xloc.bar_index, style = p.dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(lineCss, 100), textcolor = lineCss, size = bsslLblSize))

if barstate.islast
    for l in bsslLines
        l.delete()
    bsslLines.clear()
    for b in bsslBoxes
        b.delete()
    bsslBoxes.clear()
    for lb in bsslLabels
        lb.delete()
    bsslLabels.clear()
    if enableBSSL
        int rightX     = bar_index + bsslExtend
        bool drawLine  = bsslDrawMode == 'Line' or bsslDrawMode == 'Area + line' or bsslDrawMode == 'Area + line + % tag'
        bool drawArea  = bsslDrawMode == 'Area' or bsslDrawMode == 'Area + line' or bsslDrawMode == 'Area + line + % tag'
        bool drawTag   = bsslDrawMode == 'Area + line + % tag'
        for p in bsslSell
            f_bsslDrawPool(p, rightX, drawLine, drawArea, drawTag)
        for p in bsslBuy
            f_bsslDrawPool(p, rightX, drawLine, drawArea, drawTag)

// ============================================================================
// --- BSSL ALERTS ---
// ============================================================================
alertcondition(enableBSSL and bsslSellSwept, 'Sellside swept', 'Sellside liquidity (swing high) swept')
alertcondition(enableBSSL and bsslBuySwept,  'Buyside swept',  'Buyside liquidity (swing low) swept')
