//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_LEG                     = 1
BEARISH_LEG                     = 0

BULLISH                         = +1
BEARISH                         = -1

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical'
PRESENT                         = 'Present'

COLORED                         = 'Colored'
MONOCHROME                      = 'Monochrome'

ALL                             = 'All'
BOS                             = 'BOS'
CHOCH                           = 'CHoCH'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal

ATR                             = 'Atr'
RANGE                           = 'Cumulative Mean Range'

CLOSE                           = 'Close'
HIGHLOW                         = 'High/Low'

SOLID                           = '⎯⎯⎯'
DASHED                          = '----'
DOTTED                          = '····'

SMART_GROUP                     = 'Smart Money Concepts'
INTERNAL_GROUP                  = 'Real Time Internal Structure'
SWING_GROUP                     = 'Real Time Swing Structure'
BLOCKS_GROUP                    = 'Order Blocks'
EQUAL_GROUP                     = 'EQH/EQL'
GAPS_GROUP                      = 'Fair Value Gaps'
LEVELS_GROUP                    = 'Highs & Lows MTF'
ZONES_GROUP                     = 'Premium & Discount Zones'

modeTooltip                     = 'Allows to display historical Structure or only the recent ones'
styleTooltip                    = 'Indicator color theme'
showTrendTooltip                = 'Display additional candles with a color reflecting the current trend detected by structure'
showInternalsTooltip            = 'Display internal market structure'
internalFilterConfluenceTooltip = 'Filter non significant internal structure breakouts'
showStructureTooltip            = 'Display swing market Structure'
showSwingsTooltip               = 'Display swing point as labels on the chart'
showHighLowSwingsTooltip        = 'Highlight most recent strong and weak high/low points on the chart'
showInternalOrderBlocksTooltip  = 'Display internal order blocks on the chart\n\nNumber of internal order blocks to display on the chart'
showSwingOrderBlocksTooltip     = 'Display swing order blocks on the chart\n\nNumber of internal swing blocks to display on the chart'
orderBlockFilterTooltip         = 'Method used to filter out volatile order blocks \n\nIt is recommended to use the cumulative mean range method when a low amount of data is available'
orderBlockMitigationTooltip     = 'Select what values to use for order block mitigation'
showEqualHighsLowsTooltip       = 'Display equal highs and equal lows on the chart'
equalHighsLowsLengthTooltip     = 'Number of bars used to confirm equal highs and equal lows'
equalHighsLowsThresholdTooltip  = 'Sensitivity threshold in a range (0, 1) used for the detection of equal highs & lows\n\nLower values will return fewer but more pertinent results'
showFairValueGapsTooltip        = 'Display fair values gaps on the chart'
fairValueGapsThresholdTooltip   = 'Filter out non significant fair value gaps'
fairValueGapsTimeframeTooltip   = 'Fair value gaps timeframe'
fairValueGapsExtendTooltip      = 'Determine how many bars to extend the Fair Value Gap boxes on chart'
showPremiumDiscountZonesTooltip = 'Display premium, discount, and equilibrium zones on chart'

modeInput                       = input.string( HISTORICAL, 'Mode',                     group = SMART_GROUP,    tooltip = modeTooltip, options = [HISTORICAL, PRESENT])
styleInput                      = input.string( COLORED,    'Style',                    group = SMART_GROUP,    tooltip = styleTooltip,options = [COLORED, MONOCHROME])
showTrendInput                  = input(        false,      'Color Candles',            group = SMART_GROUP,    tooltip = showTrendTooltip)

showInternalsInput              = input(        true,       'Show Internal Structure',  group = INTERNAL_GROUP, tooltip = showInternalsTooltip)
showInternalBullInput           = input.string( ALL,        'Bullish Structure',        group = INTERNAL_GROUP, inline = 'ibull', options = [ALL,BOS,CHOCH])
internalBullColorInput          = input(        GREEN,      '',                         group = INTERNAL_GROUP, inline = 'ibull')
showInternalBearInput           = input.string( ALL,        'Bearish Structure' ,       group = INTERNAL_GROUP, inline = 'ibear', options = [ALL,BOS,CHOCH])
internalBearColorInput          = input(        RED,        '',                         group = INTERNAL_GROUP, inline = 'ibear')
internalFilterConfluenceInput   = input(        false,      'Confluence Filter',        group = INTERNAL_GROUP, tooltip = internalFilterConfluenceTooltip)
internalStructureSize           = input.string( TINY,       'Internal Label Size',      group = INTERNAL_GROUP, options = [TINY,SMALL,NORMAL])

showStructureInput              = input(        true,       'Show Swing Structure',     group = SWING_GROUP,    tooltip = showStructureTooltip)
showSwingBullInput              = input.string( ALL,        'Bullish Structure',        group = SWING_GROUP,    inline = 'bull',    options = [ALL,BOS,CHOCH])
swingBullColorInput             = input(        GREEN,      '',                         group = SWING_GROUP,    inline = 'bull')
showSwingBearInput              = input.string( ALL,        'Bearish Structure',        group = SWING_GROUP,    inline = 'bear',    options = [ALL,BOS,CHOCH])
swingBearColorInput             = input(        RED,        '',                         group = SWING_GROUP,    inline = 'bear')
swingStructureSize              = input.string( SMALL,      'Swing Label Size',         group = SWING_GROUP,    options = [TINY,SMALL,NORMAL])
showSwingsInput                 = input(        false,      'Show Swings Points',       group = SWING_GROUP,    tooltip = showSwingsTooltip,inline = 'swings')
swingsLengthInput               = input.int(    50,         '',                         group = SWING_GROUP,    minval = 10,                inline = 'swings')
showHighLowSwingsInput          = input(        true,       'Show Strong/Weak High/Low',group = SWING_GROUP,    tooltip = showHighLowSwingsTooltip)

showInternalOrderBlocksInput    = input(        true,       'Internal Order Blocks' ,   group = BLOCKS_GROUP,   tooltip = showInternalOrderBlocksTooltip,   inline = 'iob')
internalOrderBlocksSizeInput    = input.int(    5,          '',                         group = BLOCKS_GROUP,   minval = 1, maxval = 20,                    inline = 'iob')
showSwingOrderBlocksInput       = input(        false,      'Swing Order Blocks',       group = BLOCKS_GROUP,   tooltip = showSwingOrderBlocksTooltip,      inline = 'ob')
swingOrderBlocksSizeInput       = input.int(    5,          '',                         group = BLOCKS_GROUP,   minval = 1, maxval = 20,                    inline = 'ob') 
orderBlockFilterInput           = input.string( 'Atr',      'Order Block Filter',       group = BLOCKS_GROUP,   tooltip = orderBlockFilterTooltip,          options = [ATR, RANGE])
orderBlockMitigationInput       = input.string( HIGHLOW,    'Order Block Mitigation',   group = BLOCKS_GROUP,   tooltip = orderBlockMitigationTooltip,      options = [CLOSE,HIGHLOW])
internalBullishOrderBlockColor  = input.color(color.new(#3179f5, 80), 'Internal Bullish OB',    group = BLOCKS_GROUP)
internalBearishOrderBlockColor  = input.color(color.new(#f77c80, 80), 'Internal Bearish OB',    group = BLOCKS_GROUP)
swingBullishOrderBlockColor     = input.color(color.new(#1848cc, 80), 'Bullish OB',             group = BLOCKS_GROUP)
swingBearishOrderBlockColor     = input.color(color.new(#b22833, 80), 'Bearish OB',             group = BLOCKS_GROUP)
showOBBreakerInput              = input.bool(false, 'Breaker Blocks (OB break)', group = BLOCKS_GROUP, tooltip = 'When an order block is mitigated, keep it as a breaker recoloured with the break colours below instead of deleting it. Removed only once price fully closes back through the opposite side.')
bullishOBBreakColor             = input.color(color.new(#4785f9, 80), 'Bullish Break', group = BLOCKS_GROUP, inline = 'obbrk')
bearishOBBreakColor             = input.color(color.new(#f9ff57, 80), 'Bearish Break', group = BLOCKS_GROUP, inline = 'obbrk')
obStyleInput     = input.string('Box', 'Order Block Style', group = BLOCKS_GROUP, options = ['Box','Label','Box + Label'], tooltip = 'Box = classic zone rectangle (default, unchanged). Label = a compact OB+ / OB- tag at the block level instead of the rectangle. Box + Label = draw both. This is the enable/disable switch for the label style.')
obLabelBullText  = input.string('OB+', 'Bull / Bear OB label text', group = BLOCKS_GROUP, inline = 'oblbl')
obLabelBearText  = input.string('OB-', '', group = BLOCKS_GROUP, inline = 'oblbl')
obLabelSizeInput = input.string(size.small, 'OB Label Size', group = BLOCKS_GROUP, options = [size.tiny, size.small, size.normal, size.large, size.huge])
showEqualHighsLowsInput         = input(        true,       'Equal High/Low',           group = EQUAL_GROUP,    tooltip = showEqualHighsLowsTooltip)
equalHighsLowsLengthInput       = input.int(    3,          'Bars Confirmation',        group = EQUAL_GROUP,    tooltip = equalHighsLowsLengthTooltip,      minval = 1)
equalHighsLowsThresholdInput    = input.float(  0.1,        'Threshold',                group = EQUAL_GROUP,    tooltip = equalHighsLowsThresholdTooltip,   minval = 0, maxval = 0.5, step = 0.1)
equalHighsLowsSizeInput         = input.string( TINY,       'Label Size',               group = EQUAL_GROUP,    options = [TINY,SMALL,NORMAL])

showFairValueGapsInput          = input(        false,      'Fair Value Gaps',          group = GAPS_GROUP,     tooltip = showFairValueGapsTooltip)
fairValueGapsThresholdInput     = input(        true,       'Auto Threshold',           group = GAPS_GROUP,     tooltip = fairValueGapsThresholdTooltip)
fairValueGapsTimeframeInput     = input.timeframe('',       'Timeframe',                group = GAPS_GROUP,     tooltip = fairValueGapsTimeframeTooltip)
fairValueGapsBullColorInput     = input.color(color.new(#00ff68, 70), 'Bullish FVG' , group = GAPS_GROUP)
fairValueGapsBearColorInput     = input.color(color.new(#ff0008, 70), 'Bearish FVG' , group = GAPS_GROUP)
showFVGBreakInput               = input.bool(false, 'FVG Break (inverse FVG)', group = GAPS_GROUP, tooltip = 'When price trades through a fair value gap, recolour it with the break colours below (inverse FVG) instead of deleting it. Removed once price fully closes past the opposite side.')
fvgBullBreakColor               = input.color(color.new(#808000, 70), 'Bullish FVG Break', group = GAPS_GROUP, inline = 'fvgbrk')
fvgBearBreakColor               = input.color(color.new(#ff0000, 70), 'Bearish FVG Break', group = GAPS_GROUP, inline = 'fvgbrk')
fairValueGapsExtendInput        = input.int(    1,          'Extend FVG',               group = GAPS_GROUP,     tooltip = fairValueGapsExtendTooltip,       minval = 0)

showDailyLevelsInput            = input(        false,      'Daily',    group = LEVELS_GROUP,   inline = 'daily')
dailyLevelsStyleInput           = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'daily',   options = [SOLID,DASHED,DOTTED])
dailyLevelsColorInput           = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'daily')
showWeeklyLevelsInput           = input(        false,      'Weekly',   group = LEVELS_GROUP,   inline = 'weekly')
weeklyLevelsStyleInput          = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'weekly',  options = [SOLID,DASHED,DOTTED])
weeklyLevelsColorInput          = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'weekly')
showMonthlyLevelsInput          = input(        false,      'Monthly',   group = LEVELS_GROUP,   inline = 'monthly')
monthlyLevelsStyleInput         = input.string( SOLID,      '',         group = LEVELS_GROUP,   inline = 'monthly', options = [SOLID,DASHED,DOTTED])
monthlyLevelsColorInput         = input(        BLUE,       '',         group = LEVELS_GROUP,   inline = 'monthly')
showMidLevelsInput              = input(        true,       '50% Midpoint (PD/PW/PM 50%)', group = LEVELS_GROUP, tooltip = 'Adds the equilibrium / 50% level of the previous day/week/month range (midpoint of PxH and PxL) as a dotted line.')

showPremiumDiscountZonesInput   = input(        false,      'Premium/Discount Zones',   group = ZONES_GROUP , tooltip = showPremiumDiscountZonesTooltip)
premiumZoneColorInput           = input.color(  RED,        'Premium Zone',             group = ZONES_GROUP)
equilibriumZoneColorInput       = input.color(  GRAY,       'Equilibrium Zone',         group = ZONES_GROUP)
discountZoneColorInput          = input.color(  GREEN,      'Discount Zone',            group = ZONES_GROUP)

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox
    bool broken = false

type trend
    int bias    

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime    
    int bias
    bool breaker = false

var pivot swingHigh                 = pivot.new(na,na,false)
var pivot swingLow                  = pivot.new(na,na,false)
var pivot internalHigh              = pivot.new(na,na,false)
var pivot internalLow               = pivot.new(na,na,false)
var pivot equalHigh                 = pivot.new(na,na,false)
var pivot equalLow                  = pivot.new(na,na,false)
var trend swingTrend                = trend.new(0)
var trend internalTrend             = trend.new(0)
var equalDisplay equalHighDisplay   = equalDisplay.new()
var equalDisplay equalLowDisplay    = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<float> parsedHighs        = array.new<float>()
var array<float> parsedLows         = array.new<float>()
var array<float> highs              = array.new<float>()
var array<float> lows               = array.new<float>()
var array<int> times                = array.new<int>()
var trailingExtremes trailing       = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks      = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks   = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes        = array.new<box>()
var array<box> internalOrderBlocksBoxes     = array.new<box>()
var array<label> swingOrderBlocksLabels    = array.new<label>()
var array<label> internalOrderBlocksLabels = array.new<label>()
var swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor        = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor        = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor                = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor               = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput 
varip int currentBarIndex           = bar_index
varip int lastBarIndex              = bar_index
alerts currentAlerts                = alerts.new()
var initialTime                     = time

// we create the needed boxes for displaying order blocks at the first execution
if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))

bearishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure                          = ta.atr(200)
volatilityMeasure                   = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr)/bar_index
highVolatilityBar                   = (high - low) >= (2 * volatilityMeasure)
parsedHigh                          = highVolatilityBar ? low : high
parsedLow                           = highVolatilityBar ? high : low

// we store current values into the arrays at each bar
parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
leg(int size) =>
    var leg     = 0    
    newLegHigh  = high[size] > ta.highest( size)
    newLegLow   = low[size]  < ta.lowest(  size)
    
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)      => ta.change(leg) != 0

startOfBearishLeg(int leg)  => ta.change(leg) == -1

startOfBullishLeg(int leg)  => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>    
    var label l_abel = na

    if modeInput == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    
    string tag          = 'EQL'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'EQH'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    if modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)
        
    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition           = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

getCurrentStructure(int size,bool equalHighLow = false, bool internal = false) =>        
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow    

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure                
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)            
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot,high[size],size,true)
                currentAlerts.equalHighs := true               

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)
                
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>    
    var line l_ine      = line.new(na,na,na,na,xloc = xloc.bar_time)
    var label l_abel    = label.new(na,na)

    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()

    l_ine   := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time,na,p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel  := label.new(chart.point.new(na,math.round(0.5*(p_ivot.barIndex+bar_index)),p_ivot.currentLevel), tag, xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size = labelSize)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

    for [index,eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false
        
        if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true
        if crossedOderBlock and not showOBBreakerInput
            orderBlocks.remove(index)
            true
        else if crossedOderBlock and showOBBreakerInput
            eachOrderBlock.breaker := true
            true
        else if showOBBreakerInput and eachOrderBlock.breaker and ((eachOrderBlock.bias == BEARISH and close < eachOrderBlock.barLow) or (eachOrderBlock.bias == BULLISH and close > eachOrderBlock.barHigh))
            orderBlocks.remove(index)
            true

storeOrdeBlock(pivot p_ivot,bool internal = false,int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)

        array<float> a_rray = na
        int parsedIndex = na

        if bias == BEARISH
            a_rray      := parsedHighs.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())  
        else
            a_rray      := parsedLows.slice(p_ivot.barIndex,bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())                        

        orderBlock o_rderBlock          = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex),bias)
        array<orderBlock> orderBlocks   = internal ? internalOrderBlocks : swingOrderBlocks
        
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()
    array<box>   b_oxes  = internal ? internalOrderBlocksBoxes  : swingOrderBlocksBoxes
    array<label> l_abels = internal ? internalOrderBlocksLabels : swingOrderBlocksLabels

    // Recreate boxes AND labels on every draw so they are the NEWEST drawing
    // objects (Pine GCs the oldest first when the 500 pools overflow). Runs only
    // on the last bar, so this is cheap.
    for b in b_oxes
        b.delete()
    b_oxes.clear()
    for lb in l_abels
        lb.delete()
    l_abels.clear()

    if orderBlocksSize > 0
        maxOrderBlocks                      = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks  = orderBlocks.slice(0, math.min(maxOrderBlocks,orderBlocksSize))

        bool drawBox   = obStyleInput == 'Box' or obStyleInput == 'Box + Label'
        bool drawLabel = obStyleInput == 'Label' or obStyleInput == 'Box + Label'

        for [index,eachOrderBlock] in parsedOrdeBlocks
            baseOBColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)
            orderBlockColor = (showOBBreakerInput and eachOrderBlock.breaker) ? (eachOrderBlock.bias == BULLISH ? bullishOBBreakColor : bearishOBBreakColor) : baseOBColor

            if drawBox
                box b_ox = box.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right)
                b_ox.set_top_left_point(    chart.point.new(eachOrderBlock.barTime,na,eachOrderBlock.barHigh))
                b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,eachOrderBlock.barLow))
                b_ox.set_border_color(      internal ? na : orderBlockColor)
                b_ox.set_bgcolor(           orderBlockColor)
                b_oxes.push(b_ox)

            if drawLabel
                bool   isBull   = eachOrderBlock.bias == BULLISH
                float  midPrice = math.avg(eachOrderBlock.barHigh, eachOrderBlock.barLow)
                string obTxt    = isBull ? obLabelBullText : obLabelBearText
                color  lblCol   = color.new(orderBlockColor, 0)   // solid version of the OB colour (strips the box transparency)
                // anchor at the ORIGIN candle of the block (start of the box); tag sits at that
                // candle with its pointer on the right, body to the left, so it marks the start.
                label lb = label.new(x = eachOrderBlock.barTime, y = midPrice, text = obTxt, xloc = xloc.bar_time, style = label.style_label_left, color = lblCol, textcolor = color.white, size = obLabelSizeInput)
                l_abels.push(lb)
displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    
    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize

    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    if ta.crossover(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBullishCHoCH  := tag == CHOCH
            currentAlerts.internalBullishBOS    := tag == BOS
        else
            currentAlerts.swingBullishCHoCH     := tag == CHOCH
            currentAlerts.swingBullishBOS       := tag == BOS

        p_ivot.crossed  := true
        t_rend.bias     := BULLISH

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition                        
            drawStructure(p_ivot,tag,bullishColor,lineStyle,label.style_label_down,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BULLISH)

    p_ivot          := internal ? internalLow : swingLow    
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if ta.crossunder(close,p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBearishCHoCH  := tag == CHOCH
            currentAlerts.internalBearishBOS    := tag == BOS
        else
            currentAlerts.swingBearishCHoCH     := tag == CHOCH
            currentAlerts.swingBearishBOS       := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BEARISH

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        
        if displayCondition                        
            drawStructure(p_ivot,tag,bearishColor,lineStyle,label.style_label_up,labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot,internal,BEARISH)

fairValueGapBox(leftTime,rightTime,topPrice,bottomPrice,boxColor) => box.new(chart.point.new(leftTime,na,topPrice),chart.point.new(rightTime + fairValueGapsExtendInput * (time-time[1]),na,bottomPrice), xloc=xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

deleteFairValueGaps() =>
    for [index,eachFairValueGap] in fairValueGaps
        bool crossedFVG = (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
        if crossedFVG and showFVGBreakInput and not eachFairValueGap.broken
            eachFairValueGap.broken := true
            fvgBreakColor = eachFairValueGap.bias == BULLISH ? fvgBullBreakColor : fvgBearBreakColor
            eachFairValueGap.topBox.set_bgcolor(fvgBreakColor)
            eachFairValueGap.topBox.set_border_color(fvgBreakColor)
            eachFairValueGap.bottomBox.set_bgcolor(fvgBreakColor)
            eachFairValueGap.bottomBox.set_border_color(fvgBreakColor)
            true
        else if crossedFVG and not showFVGBreakInput
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)
            true
        else if showFVGBreakInput and eachFairValueGap.broken and ((eachFairValueGap.bias == BULLISH and close > eachFairValueGap.top) or (eachFairValueGap.bias == BEARISH and close < eachFairValueGap.bottom))
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)
            true
    // safety cap so active + broken gaps can't grow past the box budget
    while fairValueGaps.size() > 30
        oldFVG = fairValueGaps.pop()
        oldFVG.topBox.delete()
        oldFVG.bottomBox.delete()
    
drawFairValueGaps() => 
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]],lookahead = barmerge.lookahead_on)

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow,last2High,BULLISH,fairValueGapBox(lastTime,currentTime,currentLow,math.avg(currentLow,last2High),fairValueGapBullishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentLow,last2High),last2High,fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh,last2Low,BEARISH,fairValueGapBox(lastTime,currentTime,currentHigh,math.avg(currentHigh,last2Low),fairValueGapBearishColor),fairValueGapBox(lastTime,currentTime,math.avg(currentHigh,last2Low),last2Low,fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time],lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel    

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray        = times.slice(leftIndex,rightIndex)
        array<float> topArray       = highs.slice(leftIndex,rightIndex)
        array<float> bottomArray    = lows.slice(leftIndex,rightIndex)

        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line midLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = line.style_dotted)
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label midLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}50%',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(    chart.point.new(parsedTopTime,na,parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))   
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))

    bottomLine.set_first_point( chart.point.new(parsedBottomTime,na,parsedBottom))    
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))

    // 50% / equilibrium midpoint of the previous period range
    float parsedMid = math.avg(parsedTop, parsedBottom)
    if showMidLevelsInput
        midLine.set_first_point(    chart.point.new(parsedLeftTime, na, parsedMid))
        midLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedMid))
        midLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedMid))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high,trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine     = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel      = label.new(na, na, color=color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel   = label.new(na, na, color=color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar            = last_bar_time + 20 * (time - time[1])

    topLine.set_first_point(    chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(          swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

    bottomLine.set_first_point( chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(       swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(    chart.point.new(trailing.barTime,na,top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))

    l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)

    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen,high,low,close,color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()

    if showHighLowSwingsInput
        drawHighLowSwings()

    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()

if showFairValueGapsInput
    deleteFairValueGaps()

getCurrentStructure(swingsLengthInput,false)
getCurrentStructure(5,false,true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput,true)

if showInternalsInput or showInternalOrderBlocksInput or showTrendInput
    displayStructure(true)

if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
    displayStructure()

if showInternalOrderBlocksInput
    deleteOrderBlocks(true)

if showSwingOrderBlocksInput
    deleteOrderBlocks()

if showFairValueGapsInput
    drawFairValueGaps()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput        
        drawOrderBlocks(true)
        
    if showSwingOrderBlocksInput        
        drawOrderBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D',timeframe.isdaily,dailyLevelsStyleInput,dailyLevelsColorInput)

    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W',timeframe.isweekly,weeklyLevelsStyleInput,weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M',timeframe.ismonthly,monthlyLevelsStyleInput,monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
//ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(currentAlerts.swingBullishBOS,           'Bullish BOS',                  'Internal Bullish BOS formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Bullish CHoCH',                'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.swingBearishBOS,           'Bearish BOS',                  'Bearish BOS formed')
alertcondition(currentAlerts.swingBearishCHoCH,         'Bearish CHoCH',                'Bearish CHoCH formed')

alertcondition(currentAlerts.internalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Price broke bearish swing OB')

alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')

alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')


//
//
//
//═════════════════════════════════════════════════════════════════════════════
//                    MODULE  —  KhanSaab Sniper V.02
//                    © KhanSaab 2026 — toggleable module
//                    + Trade Log (entry history)
//                    + Dashboard TP1→TP5 rows          (ADDED)
//                    + Trade Log SL column             (ADDED)
//                    + Day P/L — running daily pips     (ADDED)
//═════════════════════════════════════════════════════════════════════════════
SNIPER_GROUP     = 'Sniper Module ⚡'
enableSniper     = input.bool(true,  'Enable Sniper Module', group = SNIPER_GROUP, tooltip = 'Master switch for the KhanSaab Sniper layer (EMA-cross signals, SL/TP lines, score dashboard, EMA ribbon, VWAP).')

groupSniperInfo  = 'Sniper — Info & Disclaimer'
_sniperDisc      = input.text_area('Trading financial markets involves substantial risk of loss and is not suitable for every investor. The signals, indicators, and content provided by this module are purely for educational purposes and do not constitute financial or investment advice.', 'Disclaimer Notice', group = groupSniperInfo)
_sniperTfRec     = input.string('3 / 5 / 15 Minutes', 'Scalping Timeframe', group = groupSniperInfo, tooltip = 'Best suited for 3-minute, 5-minute, or 15-minute timeframes.')

groupSniperVis   = 'Sniper — Visuals & UI'
showSniperDash   = input.bool(true,  'Show Score Dashboard',  group = groupSniperVis)
showSniperRibbon = input.bool(true,  'Show EMA Ribbon (9/21/50)', group = groupSniperVis)
showSniperVwap   = input.bool(true,  'Show VWAP',             group = groupSniperVis)
showSniperTrades = input.bool(true,  'Show Signals & SL/TP',  group = groupSniperVis)
dashStyle        = input.string('ICT simple', 'Dashboard style', options = ['ICT simple', 'Full (indicators)'], group = groupSniperVis, tooltip = 'ICT SIMPLE = one card with the four things a trade needs - where you got in, where you are out if wrong, where you are out if right, and WHY. FULL = the original indicator readout (bias score, RSI, MACD, ADX, ATR, VWAP, news).')
dashShowLevels   = input.bool(true, 'ICT simple ▸ include Levels section',   group = groupSniperVis, tooltip = 'Folds the nearest liquidity above/below, equilibrium and the OTE bands into the dashboard, so the separate ICT Levels panel is not needed.')
dashShowGrade    = input.bool(true, 'ICT simple ▸ include Grade section',      group = groupSniperVis, tooltip = "Folds the setup-grade scoreboard into the dashboard: how many logged trades were A+ / A / B / C, and the win rate of each. This is the ICT-vs-EMA test in one place - if A+ and C win at the same rate, the ICT context is adding nothing on top of the EMA trigger.")
dashShowHitRate  = input.bool(false, 'ICT simple ▸ include Hit-rate section',  group = groupSniperVis, tooltip = 'Folds the by-distance draw hit rate into the dashboard. OFF by default because the Grade section above answers the more useful question; the full per-pool breakdown lives in the standalone Draw hit rate panel.')
dashPosInput     = input.string('Top Right', 'Dashboard Position', options = ['Top Left','Top Right','Middle Left','Middle Right','Bottom Left','Bottom Right'], group = groupSniperVis)
dashTextSize     = input.string('small',  'Dashboard Font Size', options = ['tiny','small','normal','large','huge'], group = groupSniperVis)
tradeTextSize    = input.string('normal', 'Trade Label Size',    options = ['tiny','small','normal','large','huge'], group = groupSniperVis)
tradeDisplayInput = input.string('Dashboard', 'Entry/SL/TP levels', options = ['Chart','Dashboard','Both'], group = groupSniperVis, tooltip = 'Where to show the active trade Entry / SL / TP levels.')
sniperSignalSize = input.string(size.small, 'BUY / SELL Label Size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = groupSniperVis)
sniperSigStyle   = input.string('Label', 'BUY / SELL marker style', options = ['Label','Triangle'], group = groupSniperVis, tooltip = 'Label = BUY/SELL text tags. Triangle = a plain triangle below/above the bar.')
ribbonOpacity    = input.int(50, 'EMA Ribbon Opacity', minval = 0, maxval = 100, group = groupSniperVis)
labelOffsetBars  = input.int(10, 'Label Right Offset (Bars)', minval = 2, maxval = 100, group = groupSniperVis, tooltip = 'How far to the right of live candles the price tags project.')

groupSniperRisk  = 'Sniper — Risk Management'
atrMultiplier    = input.float(2.0, 'SL ATR Multiplier', minval = 0.1, step = 0.1, group = groupSniperRisk)

//───────────────────────────────────────────────────────────────────────────
// Trade Log settings
//───────────────────────────────────────────────────────────────────────────
LOG_GROUP        = 'Sniper — Trade Log 🧾'
showTradeLog     = input.bool(true, 'Show Trade Log', group = LOG_GROUP, tooltip = 'A running history of past entries: time, direction, entry price, stop and outcome (which TP or SL was hit). A trade is written to the log when a new signal replaces it, or when it closes on SL / TP5.')
logPosInput      = input.string('Bottom Right', 'Trade Log Position', options = ['Top Left','Top Right','Middle Left','Middle Right','Bottom Left','Bottom Right'], group = LOG_GROUP, tooltip = "Keep this different from the Dashboard position so the two tables don't overlap.")
logTextSize      = input.string('small', 'Trade Log Font Size', options = ['tiny','small','normal','large','huge'], group = LOG_GROUP)
logTz            = input.string('Asia/Kolkata', 'Trade Log timezone', options = ['Asia/Kolkata','America/New_York','Europe/London','Asia/Tokyo','UTC','Exchange'], group = LOG_GROUP, tooltip = "Timezone the log's Time column AND the Day P/L day-boundary are read in. 'Exchange' follows the symbol's own timezone. Default IST.")
logMaxRows       = input.int(8, 'Max Log Rows', minval = 1, maxval = 30, group = LOG_GROUP, tooltip = 'How many recent trades to display (most recent first).')
logShowLive      = input.bool(true, 'Show live trade at top', group = LOG_GROUP, tooltip = 'Pin the currently-open trade as the first row, marked ●.')
tagChartOutcome  = input.bool(true, 'Tag outcome on chart signal', group = LOG_GROUP, tooltip = 'Append a 💣 (SL) or 🚀 (TP5) icon onto the BUY/SELL label once that trade resolves.')
// enable / disable — columns. EVERY one of these is live; only Result is
// permanent, because a log row with no outcome is not a log row.
logColTime       = input.bool(true, 'Column: Time',  inline = 'lcol', group = LOG_GROUP)
logColDir        = input.bool(true, 'Column: Dir',   inline = 'lcol', group = LOG_GROUP)
logColGrade      = input.bool(true, 'Column: Grade', inline = 'lcol', group = LOG_GROUP)
logColEntry      = input.bool(true, 'Column: Entry', inline = 'lcol2', group = LOG_GROUP)
logColSl         = input.bool(true, 'Column: SL',    inline = 'lcol2', group = LOG_GROUP, tooltip = 'Only the Result column is permanent — everything else here can be switched off to narrow the log. Untick what you do not read.')  // ADDED
logColIct        = input.bool(true, 'Column: Reason (ICT context)', group = LOG_GROUP, tooltip = "What ICT context was present when the trade was taken: killzone, any HTF PD array that was live for that direction (SW sweep / OB order block / FVG tapped / FIL filled), and whether price sat in premium or discount. Recorded at entry, so it never changes afterwards.\n\nUnlike the other column switches this one is honoured in BOTH log styles, so the ICT simple log can be narrowed by dropping it.")  // ADDED
logColTgt        = input.bool(false, 'Column: ICT target (draw on liquidity)', group = LOG_GROUP, tooltip = "Where the ICT concept says price was drawing to: the NEAREST resting liquidity on the far side of the entry - an H1 or H4 swing level, or the dealing-range edge. Shown as price, distance in R, a tick if price reached it, and which pool it came from. Compare that R against the TP ladder: an ICT target at 1.4R while TP5 sits at 5R means the ladder is reaching past the draw.")  // ADDED
logColInd        = input.bool(true, 'Column: Indicator state (EMA/VWAP/MACD/Vol/RSI/ADX/bias)', group = LOG_GROUP, tooltip = "What the indicators looked like AT ENTRY, each scored against the trade's own direction. ✔ agreed, ✖ argued against. Hover the cell for the full breakdown. This is how you find out WHY the flat setups were flat - they usually show a low ADX.")
logColExit       = input.bool(true, 'Column: Result value (Exit price)', group = LOG_GROUP, tooltip = "Show the price of the level the Result refers to — the TP price for a TP result, the stop price for an SL, blank (—) for a flat/flip. Sits next to Entry and SL.")  // ADDED
logShowDaySum    = input.bool(true, 'Show Day P/L footer', group = LOG_GROUP, tooltip = 'Adds a footer row to the log summing the realized pips for the current day (net, with a win/loss count).')  // ADDED
// enable / disable — what gets logged
logGradeFilter   = input.string('All', 'Grade filter', options = ['All','A+ only','A and above','B and above'], group = LOG_GROUP, tooltip = "Show only setups of this quality. THE POINT: set it to 'A+ only', read the win rate, then set it back to 'All' and compare. If the two are the same, the ICT context is adding nothing on top of the EMA trigger - which is worth knowing either way.")
logResultFilter  = input.string('All', 'Log filter', options = ['All','Wins only','Losses only'], group = LOG_GROUP, tooltip = 'All = every logged trade. Wins only = trades that reached a TP with no stop-out. Losses only = trades that hit SL.')
logIncludeFlips  = input.bool(true, 'Log trades that flipped early', group = LOG_GROUP, tooltip = 'ON = also record a trade when a new signal replaces it before it hit SL or TP5. OFF = only record trades that actually closed on SL or TP5.')

//───────────────────────────────────────────────────────────────────────────
// EXPORT  —  getting the log out of TradingView
//
// Pine cannot write files. Two routes exist and this covers both:
//
//   1. PINE LOGS (this section). One CSV line per trade into the Logs pane,
//      which you select and copy into a spreadsheet. It is the only route that
//      can carry the STRING columns - Reason, Ind, ICT target - so it is the
//      one you want for analysis.
//
//   2. EXPORT CHART DATA (the plots at the very bottom, display.data_window).
//      TradingView's own "Export chart data..." writes every plotted series to
//      CSV, one row per BAR. Numbers only, and mostly empty rows, but it is a
//      real file with no copying.
//───────────────────────────────────────────────────────────────────────────
EXP_GROUP = 'Sniper — Export 📤'
expOn     = input.bool(false, 'Write each trade to the Pine Logs pane', group = EXP_GROUP, tooltip = 'One CSV line per completed trade. Open the Pine Logs pane (the tab beside Pine Editor), select all, copy, paste into a spreadsheet. OFF by default because logging every bar of a long history is slow.')
expHdr    = input.bool(true, 'Emit a header line first', group = EXP_GROUP, tooltip = 'Writes the column names once, so the paste lands with headings already in place.')
expSep    = input.string(',', 'Delimiter', options = [',', ';', '|', 'tab'], group = EXP_GROUP, tooltip = 'Use ; if your spreadsheet is set to a locale where comma is the decimal separator. String fields are quoted either way.')
expPlots  = input.bool(false, 'Also expose numeric columns for Export chart data', group = EXP_GROUP, tooltip = "Adds hidden plots (entry, stop, exit, R, result code, ADX, RSI, bias) that TradingView's own 'Export chart data...' will include. One row per BAR, blank except on entry bars, and numbers only - no Reason or Ind text. Use this when you want a real file rather than a copy-paste.")

//───────────────────────────────────────────────────────────────────────────
// ADDED — Day P/L settings
//───────────────────────────────────────────────────────────────────────────
DAY_GROUP        = 'Sniper — Day P/L 📈'
pipSize          = input.float(0.1, 'Pip size (price per pip)', minval = 0.0001, step = 0.01, group = DAY_GROUP, tooltip = 'Price distance that equals 1 pip — used to convert each trade result into pips. XAUUSD: 0.1 is common ($0.10 = 1 pip). Set 1.0 to count whole dollars, 0.01 for points/cents. FX majors ≈ 0.0001. Day boundary uses the Trade Log timezone.')

//───────────────────────────────────────────────────────────────────────────
//  POSITION SIZE  —  how many lots this trade is worth
//
//  Original implementation; the arithmetic is standard and owned by nobody:
//
//      lots = risk money / (stop distance in price x money per price unit per lot)
//
//  The part that quietly goes wrong on "all pairs" calculators is the last
//  term. Money per price unit is in the QUOTE currency, and only equals your
//  account currency when the pair is quoted in it - true for XAUUSD and every
//  XXX/USD pair on a USD account, false for USDJPY, EURGBP and every cross.
//  Rather than guess, this asks for the rate and says so in the panel, because
//  a lot size that is silently 150x wrong is worse than no lot size at all.
//───────────────────────────────────────────────────────────────────────────
PS_GROUP  = 'Sniper — Position size 🧮'
psOn      = input.bool(true, 'Show the position-size panel', group = PS_GROUP, tooltip = 'Turns risk per trade into a lot size, using the live trade\'s own entry and stop. Read-only - it sizes nothing and places nothing.')
psBal     = input.float(10000.0, 'Account balance', minval = 1, step = 100, group = PS_GROUP)
psRiskMode = input.string('% of balance', 'Risk per trade', options = ['% of balance', 'Fixed amount'], inline = 'psr', group = PS_GROUP)
psRiskPct = input.float(1.0, '%', minval = 0.01, maxval = 100, step = 0.1, inline = 'psr', group = PS_GROUP, tooltip = 'Percent of balance risked if the stop is hit. 1% is the common ceiling for a single idea; above 2% a normal losing streak becomes an account-level event rather than a bad week.')
psRiskAmt = input.float(100.0, 'Fixed amount', minval = 0.01, step = 10, group = PS_GROUP, tooltip = 'Used when Risk per trade is set to Fixed amount. In your ACCOUNT currency.')
psContract = input.float(100.0, 'Contract size per 1.00 lot', minval = 0.0001, step = 1, group = PS_GROUP, tooltip = 'Units of the base instrument in one standard lot, which is what turns a price move into money.\n\nXAUUSD: 100 (one lot is 100 ounces, so a $1 move = $100).\nFX majors: 100000.\nIndices and crypto vary by broker - check the contract specification, do not assume.')
psQuoteRate = input.float(1.0, 'Quote → account currency rate', minval = 0.000001, step = 0.01, group = PS_GROUP, tooltip = 'How much ONE unit of the quote currency is worth in your account currency.\n\nLeave at 1.0 when they are the same - XAUUSD, EURUSD, GBPUSD on a USD account. For USDJPY on a USD account this is roughly 1/155 = 0.0065. For a cross on a USD account, use the quote currency\'s USD rate.\n\nGetting this wrong scales the lot size by exactly that factor, which is why it is a visible input rather than a guess.')
psSrc     = input.string('Live trade — ATR stop', 'Entry / stop from', options = ['Live trade — ATR stop', 'Live trade — ICT stop', 'Manual'], group = PS_GROUP, tooltip = 'ATR STOP sizes against the ladder the script actually latches results on. ICT STOP sizes against the stop beyond the pool, which is usually tighter and therefore a larger lot for the same money at risk. MANUAL uses the two boxes below, for planning a trade the script has not taken.')
psEntry   = input.float(0.0, 'Manual entry', inline = 'psm', group = PS_GROUP)
psStop    = input.float(0.0, 'Manual stop',  inline = 'psm', group = PS_GROUP)
psLotStep = input.float(0.01, 'Lot step', minval = 0.0001, step = 0.01, inline = 'psl', group = PS_GROUP)
psLotMin  = input.float(0.01, 'Min', minval = 0.0001, step = 0.01, inline = 'psl', group = PS_GROUP)
psLotMax  = input.float(100.0, 'Max', minval = 0.01, step = 1, inline = 'psl', group = PS_GROUP, tooltip = 'Broker limits. The lot is rounded DOWN to the step, so the risk shown is never more than you asked for.')
psPos     = input.string('Middle Right', 'Panel position', options = ['Top Left','Top Right','Middle Left','Middle Right','Bottom Left','Bottom Right'], group = PS_GROUP)
psSize    = input.string('small', 'Panel font', options = ['tiny','small','normal','large','huge'], group = PS_GROUP)

//───────────────────────────────────────────────────────────────────────────
// Signal Quality Filter (each condition is its own checkbox)
//───────────────────────────────────────────────────────────────────────────
QF_GROUP         = 'Sniper — Signal Quality Filter 🎯'
enableQFilter    = input.bool(false, 'Enable Signal Quality Filter', group = QF_GROUP, tooltip = 'Master switch. OFF = every EMA9/21 cross prints an arrow (original behaviour). ON = an arrow only prints when the ticked conditions below all agree, so the consolidation crosses are suppressed. Tick only the filters you want.')
qfTrend          = input.bool(true,  'Require trend — ADX ≥', inline = 'qf1', group = QF_GROUP, tooltip = 'STRONGEST filter. Blocks signals while the market is ranging (low ADX). This alone removes most consolidation noise.')
adxMin           = input.float(25.0, '', inline = 'qf1', minval = 0, group = QF_GROUP)
qfStruct         = input.bool(true,  'Require EMA structure — |EMA21−EMA50| ≥ ×ATR', inline = 'qf2', group = QF_GROUP, tooltip = 'Strong. In a range EMA21 and EMA50 sit on top of each other; this demands real separation (an actual trend), measured in ATRs.')
structMult       = input.float(0.5,  '', inline = 'qf2', minval = 0, step = 0.1, group = QF_GROUP)
qfEma50          = input.bool(true,  'Require price on trend side of EMA50', group = QF_GROUP, tooltip = 'Longs only when close is above EMA50, shorts only when below. Keeps you with the higher trend.')
qfVwap           = input.bool(true,  'Require VWAP alignment', group = QF_GROUP, tooltip = 'Longs only above VWAP, shorts only below. Good intraday filter for gold.')
qfBias           = input.bool(false, 'Require strong bias score ≥', inline = 'qf3', group = QF_GROUP, tooltip = 'Optional. Demands the dashboard B/S score strongly favour the signal side. Can be restrictive.')
biasMin          = input.float(70.0, '', inline = 'qf3', minval = 0, maxval = 100, group = QF_GROUP)
qfVolume         = input.bool(false, 'Require volume > average', group = QF_GROUP, tooltip = 'Optional. Only take crosses backed by above-average volume. Unreliable on some spot/FX feeds with poor volume data.')
qfCooldown       = input.bool(true,  'Cooldown — min bars since last signal', inline = 'qf4', group = QF_GROUP, tooltip = 'Stops rapid flip-flop: a new arrow cannot print within this many bars of the previous one.')
cooldownBars     = input.int(5,      '', inline = 'qf4', minval = 0, group = QF_GROUP)

//───────────────────────────────────────────────────────────────────────────
// MULTI-TIMEFRAME EMA CONFLUENCE  —  3m + 5m
//
// A 3-minute EMA cross on its own fires constantly, and most of those trades
// end 'flat ↷' - replaced by the next signal before they resolved. Requiring
// the NEXT timeframe up to agree is the cheapest way to kill that noise,
// because a 5m cross needs real displacement, not one impulsive 3m candle.
//
// The two crosses rarely land on the same bar. Usually the 3m goes first and
// the 5m confirms a few minutes later. PAIR mode handles exactly that: it
// waits for both, and enters on whichever one completes the pair.
//───────────────────────────────────────────────────────────────────────────
MTF_GROUP = 'Sniper — MTF EMA confluence ⏱️'
mtfOn     = input.bool(false, 'Require the higher timeframe to agree', group = MTF_GROUP, tooltip = 'OFF = the chart-timeframe EMA cross alone, unchanged. ON = the timeframe below must agree too. This CHANGES which trades happen and is the intended cure for the flat setups on 3m.')
mtfTf     = input.timeframe('5', 'Confirming timeframe', group = MTF_GROUP, tooltip = 'One step up from your chart. On a 3-minute chart use 5. It must be HIGHER than the chart timeframe - a lower one tells you nothing new.')
mtfMode   = input.string('Pair within window — enter on the later cross', 'How they must agree', options = ['Both aligned — chart cross, HTF already agrees', 'Pair within window — enter on the later cross'], group = MTF_GROUP, tooltip = 'BOTH ALIGNED = the chart cross fires only if the HTF is ALREADY on that side. Simple, but if the HTF crosses after your chart did, the trade is missed entirely. PAIR WITHIN WINDOW = wait for both to cross within the window below and enter on whichever completes the pair - so a 3m cross that the 5m confirms four minutes later still trades, entering at the 5m cross.')
mtfWindow = input.int(10, 'Pairing window (chart bars)', minval = 1, maxval = 100, group = MTF_GROUP, tooltip = 'How far apart the two crosses may be and still count as one setup. On a 3m chart, 10 bars is 30 minutes. Too wide and you are pairing unrelated events; too narrow and only simultaneous crosses qualify.')

PD_GROUP         = 'Sniper — HTF PD Arrays 🧊'
pdEnable         = input.bool(false, 'Enable HTF PD Array confluence', group = PD_GROUP, tooltip = 'Master switch, independent of the Quality Filter above. ON = an EMA cross only prints when the ticked higher-timeframe conditions also agree. Everything is read from the last CLOSED H1/H4 bar, so nothing repaints.')
pdMode           = input.string('All enabled must agree', 'Combine', options = ['All enabled must agree', 'Any one is enough'], group = PD_GROUP, tooltip = 'ALL = strict confluence, far fewer signals. ANY = at least one PD array lines up, much looser. Start with ANY to see which single array carries the edge, then tighten.')
pdUseH1          = input.bool(true,  'H1', inline = 'pdtf', group = PD_GROUP)
pdUseH4          = input.bool(true,  'H4', inline = 'pdtf', group = PD_GROUP, tooltip = 'Which higher timeframes to read. With both ticked a condition passes if EITHER timeframe shows it.')
pdSweep          = input.bool(true,  'Liquidity swept', group = PD_GROUP, tooltip = 'A prior HTF swing low was taken by a WICK and the bar closed back above it (buys) — the classic stop-hunt before a reversal. A close beyond the level is a break, not a sweep, and does not count.')
pdOB             = input.bool(true,  'Order block activated', group = PD_GROUP, tooltip = 'Price has traded back into the last down-candle before an HTF displacement up (buys). "Activated" means tapped, not closed through.')
pdFVG            = input.bool(false, 'FVG tapped', group = PD_GROUP, tooltip = 'Price re-entered a 3-candle HTF fair value gap.')
pdFill           = input.bool(false, 'Imbalance filled', group = PD_GROUP, tooltip = 'The HTF gap has been fully closed, not merely touched. NOTE: this is the same structure as FVG tapped at a later stage — filled implies tapped. Ticking both with ALL is nearly the same as ticking this one alone.')
pdRecent         = input.int(6,      'Stays valid for … HTF bars', minval = 1, maxval = 100, group = PD_GROUP, tooltip = 'How long an event still counts as confluence. 6 on H4 is a day. Too low and the cross has to be simultaneous with the sweep; too high and "confluence" means something that happened last week.')
pdSwing          = input.int(5,      'Swing length (sweep pivots)', minval = 2, maxval = 20, group = PD_GROUP, tooltip = 'Bars either side of an HTF pivot. Larger = only major swings count as liquidity.')
pdObLook         = input.int(10,     'Displacement lookback (OB)', minval = 3, maxval = 50, group = PD_GROUP, tooltip = 'An HTF close beyond this many bars of range counts as displacement, and the last opposite candle before it becomes the order block.')

DASHROWS_GROUP   = 'Dashboard — Rows (on/off)'
showBiasRow      = input.bool(true,  'BIAS',      inline = 'dr1', group = DASHROWS_GROUP)
showScoreRow     = input.bool(true,  'B / S %',   inline = 'dr1', group = DASHROWS_GROUP)
showStatusRow    = input.bool(true,  'Status',    inline = 'dr2', group = DASHROWS_GROUP)
showVwapRow      = input.bool(true,  'VWAP',      inline = 'dr2', group = DASHROWS_GROUP)
showRsiRow       = input.bool(true,  'RSI',       inline = 'dr3', group = DASHROWS_GROUP)
showMacdRow      = input.bool(true,  'MACD',      inline = 'dr3', group = DASHROWS_GROUP)
showEmaRow       = input.bool(true,  'EMA 9/21',  inline = 'dr4', group = DASHROWS_GROUP)
showAdxRow       = input.bool(true,  'ADX',       inline = 'dr4', group = DASHROWS_GROUP)
showAtrVolRow    = input.bool(true,  'ATR·Vol',   inline = 'dr5', group = DASHROWS_GROUP)
showPdRow        = input.bool(true,  'HTF PD',    inline = 'dr5b', group = DASHROWS_GROUP)
showNewsRow      = input.bool(true,  'News',      inline = 'dr5', group = DASHROWS_GROUP)
showTradeRow     = input.bool(true,  'Trade (Entry/SL/TP1-5)', inline = 'dr6', group = DASHROWS_GROUP)  // ALTERED label
showMarketRow    = input.bool(true,  'Market (regime)',        inline = 'dr6', group = DASHROWS_GROUP)
showDayRow       = input.bool(true,  'Day P/L (pips)',         inline = 'dr7', group = DASHROWS_GROUP)  // ADDED

NEWS_GROUP       = 'Dashboard — News (manual times)'
newsTz           = input.string('Asia/Kolkata', 'News timezone', options = ['Asia/Kolkata','America/New_York','Europe/London','Asia/Tokyo','UTC'], group = NEWS_GROUP, tooltip = 'Timezone the event windows below are read in. Default IST.')
newsShade        = input.bool(false, 'Shade chart background during a news window', group = NEWS_GROUP)
newsCss          = input.color(color.new(color.red, 90), 'News shade colour', group = NEWS_GROUP)
newsEn1          = input.bool(true,  'Event 1', inline = 'n1', group = NEWS_GROUP)
newsSess1        = input.session('1800-1815', '', inline = 'n1', group = NEWS_GROUP)
newsEn2          = input.bool(false, 'Event 2', inline = 'n2', group = NEWS_GROUP)
newsSess2        = input.session('2000-2015', '', inline = 'n2', group = NEWS_GROUP)
newsEn3          = input.bool(false, 'Event 3', inline = 'n3', group = NEWS_GROUP)
newsSess3        = input.session('2300-2315', '', inline = 'n3', group = NEWS_GROUP)

f_getDashPos(string _pos) =>
    switch _pos
        'Top Left'     => position.top_left
        'Top Right'    => position.top_right
        'Middle Left'  => position.middle_left
        'Middle Right' => position.middle_right
        'Bottom Left'  => position.bottom_left
        'Bottom Right' => position.bottom_right
        => position.top_right

f_addDashRow(table _table, int _row, string _title, string _val, color _col, string _size) =>
    table.cell(_table, 0, _row, _title, text_color = color.black, text_halign = text.align_left,  text_size = _size)
    table.cell(_table, 1, _row, _val,   text_color = _col,        text_halign = text.align_right, text_size = _size)

// turn a trade's hit-flags into a human-readable outcome string.
// SL shows how far it ran first, e.g. "SL 💣 (TP2)"; a clean win shows "TP5 🚀".
f_tradeResult(bool _sl, bool _t1, bool _t2, bool _t3, bool _t4, bool _t5) =>
    string _best = _t5 ? 'TP5' : _t4 ? 'TP4' : _t3 ? 'TP3' : _t2 ? 'TP2' : _t1 ? 'TP1' : ''
    _sl ? ('SL 💣' + (_best != '' ? ' (' + _best + ')' : '')) : (_t5 ? 'TP5 🚀' : (_best != '' ? _best : 'flat ↷'))

// ADDED — realized pips for one trade, in R-multiples × (risk / pipSize).
// Risk is recovered from |entry − SL|. SL takes priority (a stopped trade = −1R
// no matter how far it ran); otherwise credit the highest TP the result names.
f_tradePips(string _res, float _ent, float _sl, float _pip) =>
    float _R    = math.abs(_ent - _sl)
    float _mult = str.contains(_res, 'SL') ? -1.0 : str.contains(_res, 'TP5') ? 5.0 : str.contains(_res, 'TP4') ? 4.0 : str.contains(_res, 'TP3') ? 3.0 : str.contains(_res, 'TP2') ? 2.0 : str.contains(_res, 'TP1') ? 1.0 : 0.0
    _pip > 0.0 ? (_mult * _R / _pip) : 0.0

// ADDED — the price of the level a result refers to: SL price for a stop-out,
// the TPn price for a TP result (rebuilt from entry, risk and direction), or na
// for a flat/flipped trade that never hit a level.
f_resultPrice(string _res, float _ent, float _sl, int _dir) =>
    float _R = math.abs(_ent - _sl)
    float _n = str.contains(_res, 'TP5') ? 5.0 : str.contains(_res, 'TP4') ? 4.0 : str.contains(_res, 'TP3') ? 3.0 : str.contains(_res, 'TP2') ? 2.0 : str.contains(_res, 'TP1') ? 1.0 : 0.0
    str.contains(_res, 'SL') ? _sl : (_n > 0.0 ? (_dir == 1 ? _ent + _n * _R : _ent - _n * _R) : na)

// place a log cell only if its column is enabled (_col == -1 means off)
f_logCell(table _t, int _col, int _row, string _txt, color _tc, color _bg, string _sz, string _ha, string _tip = '') =>
    if _col >= 0
        table.cell(_t, _col, _row, _txt, text_color = _tc, bgcolor = _bg, text_size = _sz, text_halign = _ha, tooltip = _tip)

// does a trade's result pass the Log filter?
f_passFilter(string _res, string _filter) =>
    _filter == 'Wins only'   ? (str.contains(_res, 'TP') and not str.contains(_res, 'SL')) : _filter == 'Losses only' ? str.contains(_res, 'SL') : true

ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
vwapV  = ta.vwap(hlc3)
atr    = ta.atr(14)
rsiVal = ta.rsi(close, 14)
rsi5m  = request.security(syminfo.tickerid, '5', ta.rsi(close[1], 14), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

[m, s, macdHist]       = ta.macd(close, 12, 26, 9)
[plusDI, minusDI, adx] = ta.dmi(14, 14)
volAvg = ta.sma(volume, 20)

float bScore = 0.0
if close > vwapV
    bScore += 1.0
if rsiVal > 50
    bScore += 1.0
if m > s
    bScore += 1.0
if ema9 > ema21
    bScore += 1.0
if adx > 25 and close > ema9
    bScore += 1.0
if volume > volAvg and close > open
    bScore += 1.0
if rsi5m > 50
    bScore += 1.0
float bullPct = (bScore / 7.0) * 100.0

float rScore = 0.0
if close < vwapV
    rScore += 1.0
if rsiVal < 50
    rScore += 1.0
if m < s
    rScore += 1.0
if ema9 < ema21
    rScore += 1.0
if adx > 25 and close < ema9
    rScore += 1.0
if volume > volAvg and close < open
    rScore += 1.0
if rsi5m < 50
    rScore += 1.0
float bearPct = (rScore / 7.0) * 100.0

string biasText = (bullPct - bearPct) >= 40.0 ? 'STRONG BULL' : (bearPct - bullPct) >= 40.0 ? 'STRONG BEAR' : (bullPct > bearPct ? 'MILD BULL' : 'MILD BEAR')
color biasCol   = biasText == 'STRONG BULL' ? color.green : (biasText == 'STRONG BEAR' ? color.red : color.gray)

var int lastSignalState = 0
var int signalBarIdx    = 0
var int entryTime       = 0        // timestamp of the current entry (for the log)
var float entryP = 0.0
var float slP = 0.0
var float t1 = 0.0
var float t2 = 0.0
var float t3 = 0.0
var float t4 = 0.0
var float t5 = 0.0

// persistent reference to the current BUY/SELL chart label (for outcome tagging)
var label curSigLabel = na

// the trade log store (oldest → newest). Capped to keep memory bounded.
var array<int>    logTimeArr  = array.new_int()
var array<int>    logDirArr   = array.new_int()      //  1 = long, -1 = short
var array<float>  logEntryArr = array.new_float()
var array<float>  logSlArr    = array.new_float()    // ADDED — stop price per trade
var array<string> logResArr   = array.new_string()
var array<string> logIctArr   = array.new_string()   // ICT context captured at entry
var array<string> logTgtArr   = array.new_string()   // the ICT draw-on-liquidity target
var array<string> logIndArr   = array.new_string()   // indicator state captured at entry
var array<string> logGrdArr   = array.new_string()   // A+/A/B/C setup grade at entry
var string curGrade = '-'                            // the live trade's grade
var string curInd = '-'                              // the live trade's indicator tag
var string curIct = '-'                              // the live trade's tag
var float  curIctTgt  = na                           // ICT draw-on-liquidity target
var float  curIctTgtR = na                           // ...the same, in R
var string curIctTgtS = ''                           // which pool it came from

//─────────────────────────────────────────────────────────────────────────
//  HTF PD ARRAYS  —  confluence read from H1 / H4
//
//  Four ICT premium/discount arrays, each detected on the higher timeframe and
//  returned as "how many HTF bars ago did this last happen". The caller then
//  asks whether that is recent enough to still count as confluence.
//
//  Every value is taken from the last CLOSED HTF bar ([1] on the way out), so
//  a forming H4 candle cannot flip a signal that already printed. That is the
//  difference between a filter you can backtest and one that looks perfect in
//  hindsight.
//─────────────────────────────────────────────────────────────────────────
f_pdHtf(int _sw, int _obLook) =>
    // ── liquidity sweep ──────────────────────────────────────────────────
    // A wick through a prior swing that the BODY rejects. Closing beyond the
    // level is a break of structure, which is the opposite read, so the close
    // must come back inside.
    float _ph = ta.pivothigh(high, _sw, _sw)
    float _pl = ta.pivotlow(low,  _sw, _sw)
    var float _lastPH = na
    var float _lastPL = na
    if not na(_ph)
        _lastPH := _ph
    if not na(_pl)
        _lastPL := _pl
    bool _swBull = not na(_lastPL) and low  < _lastPL and close > _lastPL
    bool _swBear = not na(_lastPH) and high > _lastPH and close < _lastPH

    // ── order blocks ─────────────────────────────────────────────────────
    // Displacement first, then walk back to the last opposite candle - that
    // candle is the OB. Zones persist until a newer displacement replaces them.
    bool _dispUp = close > ta.highest(high, _obLook)[1]
    bool _dispDn = close < ta.lowest(low,   _obLook)[1]
    var float _obBullTop = na
    var float _obBullBot = na
    var float _obBearTop = na
    var float _obBearBot = na
    if _dispUp
        for i = 1 to _obLook
            if close[i] < open[i]
                _obBullTop := high[i]
                _obBullBot := low[i]
                break
    if _dispDn
        for i = 1 to _obLook
            if close[i] > open[i]
                _obBearTop := high[i]
                _obBearBot := low[i]
                break
    bool _obBullTap = not na(_obBullTop) and low <= _obBullTop and high >= _obBullBot
    bool _obBearTap = not na(_obBearTop) and low <= _obBearTop and high >= _obBearBot

    // ── fair value gaps ──────────────────────────────────────────────────
    // The 3-candle imbalance. "Tapped" = price entered the gap; "filled" =
    // price crossed all the way through it. Filled therefore implies tapped.
    var float _fvgUpTop = na
    var float _fvgUpBot = na
    var float _fvgDnTop = na
    var float _fvgDnBot = na
    var int   _fvgUpAt  = na
    var int   _fvgDnAt  = na
    if low > high[2]
        _fvgUpBot := high[2]
        _fvgUpTop := low
        _fvgUpAt  := bar_index
    if high < low[2]
        _fvgDnTop := low[2]
        _fvgDnBot := high
        _fvgDnAt  := bar_index
    // The creation bar must be excluded. Its own low IS the upper edge of a
    // bullish gap, so an overlap test scores every new FVG as instantly tapped
    // - the filter would then pass on nearly every bar and look like it works.
    bool _fvgUpTap  = not na(_fvgUpBot) and bar_index > _fvgUpAt and low  <= _fvgUpTop and high >= _fvgUpBot
    bool _fvgDnTap  = not na(_fvgDnTop) and bar_index > _fvgDnAt and high >= _fvgDnBot and low  <= _fvgDnTop
    bool _fvgUpFill = not na(_fvgUpBot) and low  <= _fvgUpBot
    bool _fvgDnFill = not na(_fvgDnTop) and high >= _fvgDnTop

    // 9999 = never happened, so a recency test fails cleanly instead of on na.
    // The last two are the SWING LEVELS themselves - resting liquidity, and the
    // thing ICT says price is actually drawing toward.
    [nz(ta.barssince(_swBull)[1],    9999), nz(ta.barssince(_swBear)[1],    9999),
     nz(ta.barssince(_obBullTap)[1], 9999), nz(ta.barssince(_obBearTap)[1], 9999),
     nz(ta.barssince(_fvgUpTap)[1],  9999), nz(ta.barssince(_fvgDnTap)[1],  9999),
     nz(ta.barssince(_fvgUpFill)[1], 9999), nz(ta.barssince(_fvgDnFill)[1], 9999),
     _lastPH[1], _lastPL[1]]

[h1SwB, h1SwS, h1ObB, h1ObS, h1FgB, h1FgS, h1FlB, h1FlS, h1PH, h1PL] = request.security(syminfo.tickerid, '60',  f_pdHtf(pdSwing, pdObLook), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[h4SwB, h4SwS, h4ObB, h4ObS, h4FgB, h4FgS, h4FlB, h4FlS, h4PH, h4PL] = request.security(syminfo.tickerid, '240', f_pdHtf(pdSwing, pdObLook), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// "recent enough on a timeframe we are actually reading". An unticked
// timeframe can never satisfy a condition.
f_pdHit(int _h1, int _h4) =>
    (pdUseH1 and _h1 <= pdRecent) or (pdUseH4 and _h4 <= pdRecent)

bool pdSweepL = f_pdHit(h1SwB, h4SwB)
bool pdSweepS = f_pdHit(h1SwS, h4SwS)
bool pdObL    = f_pdHit(h1ObB, h4ObB)
bool pdObS    = f_pdHit(h1ObS, h4ObS)
bool pdFvgL   = f_pdHit(h1FgB, h4FgB)
bool pdFvgS   = f_pdHit(h1FgS, h4FgS)
bool pdFillL  = f_pdHit(h1FlB, h4FlB)
bool pdFillS  = f_pdHit(h1FlS, h4FlS)

// ALL = every ticked array must agree (strict). ANY = one is enough (loose).
// With nothing ticked, or no timeframe ticked, the gate is open - a filter
// that silently blocks every trade is worse than one that does nothing.
bool _pdAnyOn = pdSweep or pdOB or pdFVG or pdFill
bool _pdAllL  = (not pdSweep or pdSweepL) and (not pdOB or pdObL) and (not pdFVG or pdFvgL) and (not pdFill or pdFillL)
bool _pdAllS  = (not pdSweep or pdSweepS) and (not pdOB or pdObS) and (not pdFVG or pdFvgS) and (not pdFill or pdFillS)
bool _pdAnyL  = (pdSweep and pdSweepL) or (pdOB and pdObL) or (pdFVG and pdFvgL) or (pdFill and pdFillL)
bool _pdAnyS  = (pdSweep and pdSweepS) or (pdOB and pdObS) or (pdFVG and pdFvgS) or (pdFill and pdFillS)
bool pdLong   = not pdEnable or not _pdAnyOn or not (pdUseH1 or pdUseH4) or (pdMode == 'All enabled must agree' ? _pdAllL : _pdAnyL)
bool pdShort  = not pdEnable or not _pdAnyOn or not (pdUseH1 or pdUseH4) or (pdMode == 'All enabled must agree' ? _pdAllS : _pdAnyS)

//─────────────────────────────────────────────────────────────────────────
//  ICT CONTEXT AT ENTRY  —  what the log's ICT column records
//
//  Sessions are anchored to NEW YORK, because that is how the killzones are
//  defined. Pine converts per bar, so US daylight saving is handled for us and
//  the windows stay correct all year. Hard-coding IST clock times would drift
//  by an hour for four months of every year - which is exactly the kind of bug
//  that looks like the strategy degrading.
//
//  You read the log in IST: the Trade Log timezone input is already
//  Asia/Kolkata, so the Time column is IST while the session maths stays NY.
//─────────────────────────────────────────────────────────────────────────
ICT_GROUP    = 'Sniper — ICT Context (log column) 🧭'
ictSessOn    = input.bool(true, 'Record ICT context on each trade', group = ICT_GROUP, tooltip = 'Fills the ICT column in the Trade Log with the killzone, any HTF PD array that was live, and whether price was in premium or discount. Recording only - it never blocks a trade.')
ictAsiaSess  = input.session('1900-2400', 'Asian range', group = ICT_GROUP, tooltip = 'New York time. 19:00-24:00 NY = 04:30-09:30 IST in US summer, 05:30-10:30 IST in US winter. Its high and low are the liquidity London raids.')
ictLdnSess   = input.session('0200-0500', 'London killzone', group = ICT_GROUP, tooltip = 'New York time. 02:00-05:00 NY = 11:30-14:30 IST summer, 12:30-15:30 IST winter.')
ictNySess    = input.session('0700-1000', 'New York killzone', group = ICT_GROUP, tooltip = 'New York time. 07:00-10:00 NY = 16:30-19:30 IST summer, 17:30-20:30 IST winter.')
ictLcSess    = input.session('1000-1200', 'London close', group = ICT_GROUP, tooltip = 'New York time. 10:00-12:00 NY = 19:30-21:30 IST summer, 20:30-22:30 IST winter.')
ictPdLen     = input.int(50, 'Dealing range length (premium / discount)', minval = 10, maxval = 300, group = ICT_GROUP, tooltip = 'Bars used to build the dealing range whose 50% is equilibrium. Above it is premium (sell side), below is discount (buy side).')

//  Three further models from the book, chosen because each is MECHANICAL -
//  a clock, a price level, or a comparison. The models that need a judgement
//  call (Market Maker, Unicorn's breaker) are deliberately left out: a tag that
//  is only right when you already agree with it tells you nothing.
ictSbOn      = input.bool(true,  'Silver Bullet window (Ch 15)', group = ICT_GROUP, tooltip = 'Pure time. Marks SB when the entry falls in one of the three one-hour windows. New York time, so DST is handled.')
ictSb1       = input.session('0300-0400', 'SB · London',  inline = 'sb1', group = ICT_GROUP, tooltip = '3-4 AM NY = 12:30-13:30 IST in US summer, 13:30-14:30 in US winter.')
ictSb2       = input.session('1000-1100', 'SB · NY AM',   inline = 'sb2', group = ICT_GROUP, tooltip = '10-11 AM NY = 19:30-20:30 IST summer, 20:30-21:30 winter.')
ictSb3       = input.session('1400-1500', 'SB · NY PM',   inline = 'sb3', group = ICT_GROUP, tooltip = '2-3 PM NY = 23:30-00:30 IST summer, 00:30-01:30 winter.')
ictPo3On     = input.bool(true,  'Power of 3 — side of the daily open (Ch 17)', group = ICT_GROUP, tooltip = 'Tags DO+ when price is above the current daily open, DO- below. A bullish day manipulates BELOW the open and distributes above, so a buy taken at DO- is early in the cycle and a buy at DO+ is already in distribution.')
ictSmtOn     = input.bool(false, 'SMT divergence vs a second market (Ch 18)', group = ICT_GROUP, tooltip = 'Cross-checks a correlated symbol. Bullish SMT = we make a lower low and it does NOT. Off by default because it needs the right symbol for your instrument.')
ictSmtSym    = input.symbol('TVC:DXY', 'SMT symbol', group = ICT_GROUP, tooltip = 'For XAUUSD use TVC:DXY with Negative correlation, or OANDA:XAGUSD with Positive. For EURUSD use GBPUSD with Positive.')
ictSmtCorr   = input.string('Negative', 'SMT correlation', options = ['Positive','Negative'], group = ICT_GROUP, tooltip = 'How the second symbol relates to yours. DXY against gold is Negative; silver against gold is Positive.')
ILV_GROUP     = 'ICT Levels panel 📋'
enableIctLvls = input.bool(false, 'Show ICT Levels panel (separate)', group = ILV_GROUP, tooltip = 'A separate panel listing the ICT levels for the current chart: the liquidity above and below, equilibrium, the OTE entry bands, and - while a trade is live - its ICT stop and target. Levels only; it places nothing and blocks nothing.')
ilvStyle      = input.string('Simple', 'Panel style', options = ['Simple', 'Full'], group = ILV_GROUP, tooltip = 'SIMPLE = the draw on both sides, the nearest pool above and below, equilibrium, the OTE bands and the live plan - nine rows. FULL = every level broken out by source (H1 / H4 / range separately) and the OTE sweet spots, which is the original panel.')
ilvPos        = input.string('Middle Left', 'Panel position', options = ['Top Left','Top Right','Middle Left','Middle Right','Bottom Left','Bottom Right'], group = ILV_GROUP, tooltip = 'Keep it clear of the Dashboard and the Trade Log.')
ilvSize       = input.string('small', 'Panel font size', options = ['tiny','small','normal','large','huge'], group = ILV_GROUP)
ilvShowDraw   = input.bool(true,  'Liquidity above / below', group = ILV_GROUP, tooltip = 'H1 swing, H4 swing and the dealing-range edge on each side. The one price must clear first is marked ◄ - that is the draw.')
ilvShowOte    = input.bool(true,  'OTE entry bands (0.62 / 0.705 / 0.79)', group = ILV_GROUP, tooltip = 'Chapter 5 retracement pocket, measured on the dealing range. Buy band sits in discount, sell band in premium, by construction.')
ilvShowPlan   = input.bool(true,  'Live trade plan (entry / stop / target)', group = ILV_GROUP, tooltip = 'While a trade is open: its entry, an ICT stop placed beyond the liquidity on the wrong side, and the draw-on-liquidity target with its R distance.')

ictSmtLen    = input.int(10, 'SMT lookback (bars)', minval = 3, maxval = 60, group = ICT_GROUP, tooltip = 'How far back the high/low comparison runs. Shorter = more frequent, noisier divergences.')

//─────────────────────────────────────────────────────────────────────────
//  THE DRAW  —  how the ICT target is chosen
//
//  Chapter 6: price cycles ERL -> IRL -> ERL. External range liquidity is the
//  buy/sell side resting at the EDGES of the dealing range; internal range
//  liquidity is the FVGs inside it. Chapter 28, Rule 3: demand a minimum 1:3,
//  and - the book's own words - "this is why the ICT method targets clean
//  draws on liquidity: it produces the room for a real 1:3 or better."
//
//  The first version of this picker took the NEAREST pool on the far side.
//  That is why the logged R was small: the nearest pool is usually a minor H1
//  swing a few tenths of an R away, which is not what price is drawing to.
//  These settings let it look THROUGH the small pools to one that pays.
//─────────────────────────────────────────────────────────────────────────
TGT_GROUP  = 'Sniper — ICT Target (the draw) 🎯'
tgtMode    = input.string('First pool ≥ min R', 'Target selection', options = ['Nearest pool', 'First pool ≥ min R', 'Opposite range edge (ERL)'], group = TGT_GROUP, tooltip = 'NEAREST POOL = the original behaviour, the first level price meets however close. FIRST POOL ≥ MIN R = skip the pools that do not pay and take the nearest one clearing the minimum below; this is the ICT reading, since a minor swing 0.4R away is not a draw. OPPOSITE RANGE EDGE = always the far side of the dealing range, pure ERL - the Chapter 24 read of sweep one side, deliver to the other.')
tgtMinR    = input.float(3.0, 'Minimum reward (R)', minval = 0.5, maxval = 20, step = 0.5, group = TGT_GROUP, tooltip = 'Rule 3 in the book is a minimum of 1:3 - at 3R you can be wrong six times in ten and still grow. Raising this pushes the target onto more distant pools; it does NOT make them more likely to be reached, so read the hit marks in the log before trusting a high setting.')
tgtShort   = input.string('Furthest pool, flagged !', 'When no pool clears the minimum', options = ['Furthest pool, flagged !', 'No target (—)'], group = TGT_GROUP, tooltip = 'What to record when every pool on the far side sits closer than the minimum. FLAGGED = still name the best draw available and mark it ! so you can see the rule was missed. NO TARGET = leave it blank, the honest "there was nothing here to reach for".')
tgtGate    = input.bool(false, 'Block signals whose draw is under the minimum', group = TGT_GROUP, tooltip = 'OFF = record the target and take the trade regardless; nothing about entries changes. ON = an EMA cross with no pool worth reaching is not taken at all. This is the only switch in this group that changes WHICH trades happen - Rule 3 applied as a filter. Expect materially fewer signals.')
tgtUsePdw  = input.bool(true, 'Include previous day / week high-low as pools', group = TGT_GROUP, tooltip = "The book names the day's and the week's high and low as the heaviest clusters of resting stops, above any intraday swing. Reads the PREVIOUS completed day and week only, so there is no lookahead.")
tgtRBasis  = input.string('ATR stop (TP ladder)', 'R measured against', options = ['ATR stop (TP ladder)', 'ICT stop (beyond the pool)'], group = TGT_GROUP, tooltip = 'Which stop the R in the target column is measured from. ATR STOP keeps the number directly comparable with the TP1-TP5 ladder. ICT STOP measures against a stop placed beyond the liquidity on the wrong side, which is how the method actually sizes a trade - usually the tighter of the two, so the same target reads as a larger R.')

//─────────────────────────────────────────────────────────────────────────
//  DOES THE DRAW ACTUALLY GET REACHED?
//
//  Raising the minimum R does not make a target more likely to be hit - it
//  only moves it further away. A 3R draw reached 40% of the time beats a 5R
//  draw reached 10% of the time, and nothing in the log told you which you
//  had. This counts it.
//
//  Measured INDEPENDENTLY of the trade. When a signal fires, its draw is put
//  on a watch list and followed for its own window, whether or not the trade
//  survived. "Did the level get reached" and "did my stop hold" are two
//  different questions, and conflating them is how you conclude a good draw
//  was a bad one.
//─────────────────────────────────────────────────────────────────────────
HR_GROUP = 'Sniper — Draw hit rate 📊'
hrOn     = input.bool(true, 'Track how often the draw is reached', group = HR_GROUP, tooltip = 'Counts, over the whole chart, how often the ICT target of a signal was subsequently reached. Split by which pool it was and by how far away it was, so you can see which kind of draw pays and where the distance stops being realistic. Recording only - it never blocks a trade.')
hrShowPanel = input.bool(false, 'Show the standalone hit-rate panel', group = HR_GROUP, tooltip = 'OFF = the by-distance rows appear inside the ICT dashboard instead. ON = also draw the full panel with the per-pool breakdown. Tracking runs either way - this only controls the panel.')
hrPos    = input.string('Bottom Left', 'Panel position', options = ['Top Left','Top Right','Middle Left','Middle Right','Bottom Left','Bottom Right'], group = HR_GROUP, tooltip = 'Keep it clear of the Dashboard, the Trade Log and the ICT Levels panel.')
hrSize   = input.string('tiny', 'Panel font size', options = ['tiny','small','normal','large','huge'], group = HR_GROUP)
hrWindow = input.int(200, 'Bars a draw stays trackable', minval = 20, maxval = 2000, group = HR_GROUP, tooltip = 'A draw not reached within this many bars is recorded as a miss. Without a window every level eventually counts as a hit and the rate means nothing. 200 bars on 5m is about a day and a half.')

// slots 0-4 = which pool, slots 5-8 = how far away in R
var array<int> hrHit = array.new_int(9, 0)
var array<int> hrTot = array.new_int(9, 0)

// the watch list: levels registered at signal time, awaiting a verdict
var array<float> hrPx  = array.new_float()
var array<int>   hrDir = array.new_int()
var array<int>   hrBar = array.new_int()
var array<int>   hrSrc = array.new_int()
var array<int>   hrBkt = array.new_int()

// a trailing ! means the minimum was missed; the pool is still whatever it was
f_hrSrcIdx(string _s) =>
    string _b = str.replace_all(_s, '!', '')
    _b == 'H1' ? 0 : _b == 'H4' ? 1 : _b == 'ERL' ? 2 : (_b == 'PDH' or _b == 'PDL') ? 3 : (_b == 'PWH' or _b == 'PWL') ? 4 : -1

f_hrBktIdx(float _r) =>
    na(_r) ? -1 : _r < 2.0 ? 0 : _r < 3.0 ? 1 : _r < 5.0 ? 2 : 3

f_hrRecord(int _slot, bool _hit) =>
    if _slot >= 0
        array.set(hrTot, _slot, array.get(hrTot, _slot) + 1)
        if _hit
            array.set(hrHit, _slot, array.get(hrHit, _slot) + 1)
    true

bool ictInAsia = not na(time(timeframe.period, ictAsiaSess, 'America/New_York'))
bool ictInLdn  = not na(time(timeframe.period, ictLdnSess,  'America/New_York'))
bool ictInNy   = not na(time(timeframe.period, ictNySess,   'America/New_York'))
bool ictInLc   = not na(time(timeframe.period, ictLcSess,   'America/New_York'))
string ictKz   = ictInLdn ? 'LDN' : ictInNy ? 'NY' : ictInLc ? 'LC' : ictInAsia ? 'ASIA' : '-'

float _drHi = ta.highest(high, ictPdLen)
float _drLo = ta.lowest(low,   ictPdLen)
float _drEq = math.avg(_drHi, _drLo)
string ictPd = close > _drEq ? 'PREM' : close < _drEq ? 'DISC' : 'EQ'

// Silver Bullet — three one-hour windows, New York time
bool _sbAny = ictSbOn and (not na(time(timeframe.period, ictSb1, 'America/New_York')) or not na(time(timeframe.period, ictSb2, 'America/New_York')) or not na(time(timeframe.period, ictSb3, 'America/New_York')))

// Power of 3 — which side of the DAILY OPEN price is delivering on. The open is
// fixed at the start of the day, so reading it is not lookahead.
float ictDayOpen = request.security(syminfo.tickerid, 'D', open, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
string ictPo3 = not ictPo3On or na(ictDayOpen) ? '' : (close > ictDayOpen ? 'DO+' : 'DO-')

// Previous day / week high and low - the heaviest resting-stop clusters the
// book names. [1] on a lookahead_on request is the standard NON-repainting
// idiom: on the forming daily bar, high[1] is yesterday's completed high,
// which is information you already had. The base SMC layer reads PDH/PDL the
// same way.
[pdhLvl, pdlLvl] = request.security(syminfo.tickerid, 'D', [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwhLvl, pwlLvl] = request.security(syminfo.tickerid, 'W', [high[1], low[1]], lookahead = barmerge.lookahead_on)

// SMT — a failure to confirm. We make the new extreme, the correlated market
// does not (or, when negatively correlated, fails to make its mirror extreme).
float _smtH = request.security(ictSmtSym, timeframe.period, high, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
float _smtL = request.security(ictSmtSym, timeframe.period, low,  gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
bool _ourLL = low  < ta.lowest(low,   ictSmtLen)[1]
bool _ourHH = high > ta.highest(high, ictSmtLen)[1]
// Hoisted to globals. Pine short-circuits `and`, so a ta.* call on the RIGHT
// of one is a CONDITIONAL call - it would stop advancing its internal series
// on any bar where the left side is false, and the result silently drifts.
float _smtLoN = ta.lowest(_smtL,  ictSmtLen)[1]
float _smtHiN = ta.highest(_smtH, ictSmtLen)[1]
bool _othLL = not na(_smtL) and _smtL < _smtLoN
bool _othHH = not na(_smtH) and _smtH > _smtHiN
// positive correlation: the pair should mirror us. negative: it should oppose us.
bool ictSmtBull = ictSmtOn and _ourLL and (ictSmtCorr == 'Positive' ? not _othLL : not _othHH)
bool ictSmtBear = ictSmtOn and _ourHH and (ictSmtCorr == 'Positive' ? not _othHH : not _othLL)

//─────────────────────────────────────────────────────────────────────────
//  THE ICT TARGET  —  where the concept says price is drawing to
//
//  The TP1-TP5 ladder is ATR arithmetic: entry +/- risk x n. It knows nothing
//  about the chart. ICT does not work that way - price is delivered to the
//  OPPOSITE LIQUIDITY, wherever that happens to sit. Chapter 24 says it
//  plainly: sweep one side of the range, then target the other side.
//
//  So the target here is the NEAREST resting liquidity on the far side of the
//  entry: an H1 or H4 swing level, or the edge of the dealing range. Nearest,
//  not furthest - the first pool price has to clear is the honest draw.
//
//  Read it in R against the ladder. An ICT target at +1.4R when TP5 sits at
//  +5R is the model telling you the ladder is reaching past the draw.
//─────────────────────────────────────────────────────────────────────────
f_pickAbove(float _px, float _a, float _b, float _c) =>
    float _r = na
    if not na(_a) and _a > _px
        _r := na(_r) ? _a : math.min(_r, _a)
    if not na(_b) and _b > _px
        _r := na(_r) ? _b : math.min(_r, _b)
    if not na(_c) and _c > _px
        _r := na(_r) ? _c : math.min(_r, _c)
    _r

f_pickBelow(float _px, float _a, float _b, float _c) =>
    float _r = na
    if not na(_a) and _a < _px
        _r := na(_r) ? _a : math.max(_r, _a)
    if not na(_b) and _b < _px
        _r := na(_r) ? _b : math.max(_r, _b)
    if not na(_c) and _c < _px
        _r := na(_r) ? _c : math.max(_r, _c)
    _r

// which pool the target came from, so the column can say WHY
f_tgtSrc(float _t) =>
    na(_t) ? '' : (_t == h1PH or _t == h1PL ? 'H1' : _t == h4PH or _t == h4PL ? 'H4' : 'DR')

// One compact string per trade. Only arrays that match the trade's OWN
// direction are listed - a bullish sweep is not confluence for a short.
f_ictTag(int _dir) =>
    string _t = ictKz
    bool _sw  = _dir == 1 ? pdSweepL : pdSweepS
    bool _ob  = _dir == 1 ? pdObL    : pdObS
    bool _fg  = _dir == 1 ? pdFvgL   : pdFvgS
    bool _fl  = _dir == 1 ? pdFillL  : pdFillS
    if _sw
        _t += '·SW'
    if _ob
        _t += '·OB'
    if _fg
        _t += '·FVG'
    if _fl
        _t += '·FIL'
    if _sbAny
        _t += '·SB'
    if _dir == 1 ? ictSmtBull : ictSmtBear
        _t += '·SMT'
    if ictPo3 != ''
        _t += '·' + ictPo3
    _t + '·' + ictPd

//─────────────────────────────────────────────────────────────────────────
//  INDICATOR STATE AT ENTRY  —  the log's IND column
//
//  Each component is scored AGAINST THE TRADE'S OWN DIRECTION, not raw. "MACD
//  bullish" tells you nothing on a short; "MACD disagreed" tells you a lot.
//  ✔ = agreed with the trade, ✖ = argued against it.
//
//  Captured at entry and frozen, like the ICT tag, so a row from last week
//  still says what the indicators looked like WHEN IT WAS TAKEN.
//─────────────────────────────────────────────────────────────────────────
f_indTag(int _dir) =>
    bool _e = _dir == 1 ? ema9 > ema21 : ema9 < ema21
    bool _w = _dir == 1 ? close > vwapV : close < vwapV
    bool _m = _dir == 1 ? m > s : m < s
    bool _v = volume > volAvg
    // bias shown as OWN side / OPPOSITE side. One number could not tell you
    // whether 55 meant a weak edge or a genuine fight - 55/45 and 55/14 are
    // very different bars, and only the pair distinguishes them.
    float _bOwn = _dir == 1 ? bullPct : bearPct
    float _bOpp = _dir == 1 ? bearPct : bullPct
    'E' + (_e ? '✔' : '✖') + 'W' + (_w ? '✔' : '✖') + 'M' + (_m ? '✔' : '✖') + 'V' + (_v ? '+' : '-') + '  R' + str.tostring(rsiVal, '#') + ' A' + str.tostring(adx, '#') + ' B' + str.tostring(_bOwn, '#') + '/' + str.tostring(_bOpp, '#')

//  Parsed back out of the STORED string, not rebuilt from live variables, so a
//  row from three weeks ago reads with its own numbers. Returns the four marks
//  plus ADX, RSI and the two bias halves.
f_indRead(string _t) =>
    bool _e = str.contains(_t, 'E✔')
    bool _w = str.contains(_t, 'W✔')
    bool _m = str.contains(_t, 'M✔')
    bool _v = str.contains(_t, 'V+')
    float _r  = na
    float _a  = na
    float _bo = na
    float _bp = na
    array<string> _ps = str.split(_t, ' ')
    if array.size(_ps) > 0
        for _i = 0 to array.size(_ps) - 1
            string _q = array.get(_ps, _i)
            if str.startswith(_q, 'R')
                _r := str.tonumber(str.substring(_q, 1))
            if str.startswith(_q, 'A')
                _a := str.tonumber(str.substring(_q, 1))
            if str.startswith(_q, 'B')
                array<string> _bb = str.split(str.substring(_q, 1), '/')
                if array.size(_bb) == 2
                    _bo := str.tonumber(array.get(_bb, 0))
                    _bp := str.tonumber(array.get(_bb, 1))
    [_e, _w, _m, _v, _r, _a, _bo, _bp]

//  THE READ  —  one headline for the COMBINATION, not for each mark alone.
//
//  Three components agreeing on a low-ADX, below-average-volume bar is not the
//  same setup as three agreeing in a real trend, and a legend that explains E,
//  W and M separately can never say so. This looks at them together.
f_indTier(string _t) =>
    [_e, _w, _m, _v, _r, _a, _bo, _bp] = f_indRead(_t)
    int   _ag  = (_e ? 1 : 0) + (_w ? 1 : 0) + (_m ? 1 : 0)
    float _gap = (na(_bo) or na(_bp)) ? na : _bo - _bp
    bool  _tr  = not na(_a) and _a >= 25.0
    bool  _rg  = not na(_a) and _a < 20.0
    bool  _wide = not na(_gap) and _gap >= 40.0
    bool  _tight = not na(_gap) and _gap < 20.0
    int _k = 5
    if _ag == 3 and _tr and _v and _wide
        _k := 0
    else if _rg and not _v and _tight
        _k := 1
    else if _ag <= 1
        _k := 2
    else if _tr and _ag >= 2
        _k := 3
    else if _rg
        _k := 4
    _k

//  The same tier, three ways: a word for the cell, a colour for the cell, and
//  the paragraph for the tooltip. One classifier behind all three, so they can
//  never disagree with each other.
f_indShort(string _t) =>
    int _k = f_indTier(_t)
    _k == 0 ? 'CLEAN' : _k == 1 ? 'CHOP' : _k == 2 ? 'DISAGREE' : _k == 3 ? 'TREND' : _k == 4 ? 'RANGE' : 'MIXED'

f_indCol(string _t) =>
    int _k = f_indTier(_t)
    _k == 0 ? color.new(#089981, 0) : _k == 1 ? color.new(#f23645, 0) : _k == 2 ? color.new(#e8622d, 0) : _k == 3 ? color.new(#5ba300, 0) : _k == 4 ? color.new(#e8a33d, 0) : color.new(#787b86, 0)

f_indVerdict(string _t) =>
    int _k = f_indTier(_t)
    string _h = ''
    if _k == 0
        _h := 'CLEAN TREND ENTRY\nEverything lined up: all three agreed, a real trend behind it,\nvolume above average, and the two bias halves far apart.\nThis is what you want the engine to be taking.'
    else if _k == 1
        _h := 'CHOP — THE FLAT-SETUP SIGNATURE\nNo trend (ADX under 20), below-average volume, and the two bias\nhalves close together. A cross with nothing behind it. These are\nthe trades that end flat, and the ADX filter is the direct cure.'
    else if _k == 2
        _h := 'INDICATORS DISAGREED\nThe cross fired but VWAP and MACD were on the other side. Taking\nthis meant betting on the EMA alone.'
    else if _k == 3
        _h := 'TREND ENTRY, PARTIAL AGREEMENT\nA real trend was present and most components agreed. Sound, not\nperfect — look below for which one dissented.'
    else if _k == 4
        _h := 'RANGE ENTRY\nComponents agreed, but ADX says there was no trend to ride. Wins\nhere tend to be small and to reverse quickly.'
    else
        _h := 'MIXED\nNothing decisive either way — neither a clean trend entry nor the\nchop signature.'
    _h

f_indWhy(string _t) =>
    [_e, _w, _m, _v, _r, _a, _bo, _bp] = f_indRead(_t)
    string _w2 = 'INDICATOR STATE AT ENTRY\n' + _t + '\n\n── THE READ ──\n' + f_indVerdict(_t) + '\n\n── COMPONENT BY COMPONENT ──\n'
    _w2 += 'E  EMA 9 vs 21 — ' + (_e ? 'agreed. The trigger itself, so this is expected.' : 'DISAGREED, which is odd — the cross is what fired it.') + '\n'
    _w2 += 'W  VWAP — ' + (_w ? 'price was on the trade\'s side. The most useful\n   intraday agreement there is on gold.' : 'price was on the WRONG side of the session VWAP.\n   Trading against VWAP intraday is the common way to be stopped.') + '\n'
    _w2 += 'M  MACD — ' + (_m ? 'momentum agreed with the direction.' : 'momentum argued AGAINST the trade.') + '\n'
    _w2 += 'V  Volume — ' + (_v ? 'above its 20-bar average. Real participation.' : 'BELOW its 20-bar average. A cross on thin volume is\n   the classic false break.') + '\n'
    _w2 += 'R  RSI ' + (na(_r) ? '—' : str.tostring(_r, '#')) + ' — ' + (na(_r) ? 'not recorded.' : _r >= 70.0 ? 'overbought. A long taken here is chasing;\n   a short here is fading strength.' : _r <= 30.0 ? 'oversold. A short here is chasing;\n   a long here is catching a falling market.' : _r >= 55.0 or _r <= 45.0 ? 'leaning but not extended — room to move.' : 'neutral, the middle of the range.') + '\n'
    _w2 += 'A  ADX ' + (na(_a) ? '—' : str.tostring(_a, '#')) + ' — ' + (na(_a) ? 'not recorded.' : _a >= 25.0 ? 'a REAL TREND. This is the regime the EMA cross\n   is built for.' : _a < 20.0 ? 'a RANGE. No trend to ride, and most flat setups\n   show exactly this.' : 'transition — neither a range nor a trend yet.') + '\n'
    _w2 += 'B  Bias ' + (na(_bo) ? '—' : str.tostring(_bo, '#') + '/' + str.tostring(_bp, '#')) + ' — own side / opposite side, seven checks each\n   (VWAP, RSI, MACD, EMA, ADX, volume, 5-minute RSI).\n   ' + (na(_bo) or na(_bp) ? 'not recorded.' : (_bo - _bp) >= 40.0 ? 'A WIDE split: strong one-way agreement.' : (_bo - _bp) < 20.0 ? 'A TIGHT split: the two sides were fighting.\n   That is a chop bar however good the own-side number looked.' : 'A moderate lean — some disagreement remained.') + '\n'
    _w2

//─────────────────────────────────────────────────────────────────────────
//  SETUP GRADE  —  A+ / A / B / C
//
//  The tag lists what was present. The grade says whether that combination is
//  the one the book actually calls a high-probability setup, so you can sort
//  the log by quality and ask: does the EMA engine do better on A+ than on C?
//
//  Weights follow the book's own emphasis, not a flat count:
//    3  Liquidity swept          Ch 6, the reversal signature. The heaviest
//                                single element - a stop-hunt that rejected.
//    2  Correct half of range    Ch 5. Buy in discount, sell in premium. The
//                                book treats trading the wrong half as an error.
//    2  In a killzone (LDN/NY)   Ch 9. Outside the windows there is no timing
//                                edge; LC and ASIA score nothing here.
//    2  OB or FVG active         Ch 7/8, a real PD array to enter from.
//    2  Draw clears the min R    Ch 28 Rule 3 - somewhere worth going.
//    1  Power of 3 correct side  Ch 17. DO- for a buy, DO+ for a sell.
//    1  Silver Bullet window     Ch 15.
//    1  SMT divergence           Ch 18.
//                                                             14 points total
//
//  A+ ALSO REQUIRES the sweep AND the correct half. A high total assembled out
//  of weak parts is not an A+ in ICT terms, and letting it grade as one would
//  defeat the whole purpose of grading.
//─────────────────────────────────────────────────────────────────────────
f_ictGrade(int _dir, float _r) =>
    bool _sw  = _dir == 1 ? pdSweepL : pdSweepS
    bool _ob  = _dir == 1 ? pdObL    : pdObS
    bool _fg  = _dir == 1 ? pdFvgL   : pdFvgS
    bool _loc = _dir == 1 ? ictPd == 'DISC' : ictPd == 'PREM'
    bool _kz  = ictKz == 'LDN' or ictKz == 'NY'
    bool _po3 = _dir == 1 ? ictPo3 == 'DO-' : ictPo3 == 'DO+'
    bool _smt = _dir == 1 ? ictSmtBull : ictSmtBear
    bool _rOk = not na(_r) and _r >= tgtMinR
    int _p = (_sw ? 3 : 0) + (_loc ? 2 : 0) + (_kz ? 2 : 0) + ((_ob or _fg) ? 2 : 0) + (_rOk ? 2 : 0) + (_po3 ? 1 : 0) + (_sbAny ? 1 : 0) + (_smt ? 1 : 0)
    string _g = (_p >= 10 and _sw and _loc) ? 'A+' : _p >= 8 ? 'A' : _p >= 5 ? 'B' : 'C'
    _g + ' ' + str.tostring(_p) + '/14'

f_grdWhy(string _g) =>
    'SETUP GRADE  ' + _g + '\n\nScored at entry from the ICT combination, weighted by the\nbook\'s own emphasis rather than a flat count:\n\n  3  Liquidity SWEPT - the reversal signature, heaviest element\n  2  Correct half - buy in discount, sell in premium\n  2  In a killzone - London or New York only (not LC / ASIA)\n  2  Order block or FVG active - a real PD array to enter from\n  2  Draw clears your minimum R - somewhere worth going\n  1  Power of 3 on the right side (DO- buy / DO+ sell)\n  1  Silver Bullet window\n  1  SMT divergence\n                                              14 points total\n\nA+  10+ AND swept AND correct half\nA   8+\nB   5+\nC   under 5\n\nA+ demands the sweep and the location on top of the score.\nA high total built from weak parts is not an A+ setup, and\ngrading it as one would make the grade useless.\n\nThe point of this column: filter the log to A+ and compare\nthe win rate against C. If they are the same, the ICT\ncontext is not adding anything to the EMA trigger - which\nis worth knowing either way.'

// does a trade's grade pass the Grade filter?
f_grdCol(string _g) =>
    str.startswith(_g, 'A+') ? color.new(#089981, 0) : str.startswith(_g, 'A') ? color.new(#5ba300, 0) : str.startswith(_g, 'B') ? color.new(#e8a33d, 0) : color.new(#f23645, 0)

f_passGrade(string _g, string _f) =>
    _f == 'All' ? true : _f == 'A+ only' ? str.startswith(_g, 'A+') : _f == 'A and above' ? (str.startswith(_g, 'A') ) : str.startswith(_g, 'A') or str.startswith(_g, 'B')

//─────────────────────────────────────────────────────────────────────────
//  THE TAG IN FULL  —  what the hover tooltip says
//
//  Parsed back OUT of the stored tag string rather than rebuilt from live
//  variables, so a row from three weeks ago explains itself with the context
//  that was true when it was taken, not with today's.
//─────────────────────────────────────────────────────────────────────────
f_ictWhy(string _t) =>
    string _w = 'WHY THIS TRADE WAS TAKEN\n' + _t + '\n'

    _w += '\n── SESSION ──\n'
    if str.contains(_t, 'LDN')
        _w += 'LDN  London killzone, 02:00-05:00 New York (11:30-14:30 IST in US summer).\n     London raids the Asian range, so reversals cluster here.\n'
    else if str.contains(_t, 'ASIA')
        _w += 'ASIA  Asian range, 19:00-24:00 New York.\n     Quiet accumulation. Its high and low are the liquidity London later takes.\n'
    else if str.contains(_t, 'LC')
        _w += 'LC  London close, 10:00-12:00 New York.\n     Late-session reversion window.\n'
    else if str.contains(_t, 'NY')
        _w += 'NY  New York killzone, 07:00-10:00 New York (16:30-19:30 IST summer).\n     Highest-volume window of the day.\n'
    else
        _w += '-  Outside every killzone. No session edge behind this entry.\n'

    _w += '\n── HTF PD ARRAYS (H1 / H4) ──\n'
    bool _anyPd = false
    if str.contains(_t, '·SW')
        _w += 'SW  Liquidity SWEPT. A prior higher-timeframe swing was taken by a WICK and\n    the bar closed back inside it. That is the stop-hunt before a reversal -\n    a close beyond the level would have been a break, which reads the other way.\n'
        _anyPd := true
    if str.contains(_t, '·OB')
        _w += 'OB  Order block ACTIVATED. Price traded back into the last opposite candle\n    before an HTF displacement. Tapped, not closed through.\n'
        _anyPd := true
    if str.contains(_t, '·FVG')
        _w += 'FVG  Fair value gap TAPPED. Price re-entered a 3-candle HTF imbalance.\n'
        _anyPd := true
    if str.contains(_t, '·FIL')
        _w += 'FIL  Imbalance FILLED. The HTF gap was closed completely, not merely touched.\n     Filled implies tapped, so FVG above is the same structure earlier.\n'
        _anyPd := true
    if not _anyPd
        _w += 'none  No HTF premium/discount array was live for this direction.\n'

    _w += '\n── MODELS ──\n'
    bool _anyMd = false
    if str.contains(_t, '·SB')
        _w += 'SB  Silver Bullet window (Ch 15). One of the three one-hour windows:\n    03-04, 10-11 or 14-15 New York.\n'
        _anyMd := true
    if str.contains(_t, '·SMT')
        _w += 'SMT  Divergence against the correlated market (Ch 18). We made the new\n     extreme and it did not confirm - a failure to agree.\n'
        _anyMd := true
    if str.contains(_t, 'DO+')
        _w += 'DO+  Above the daily open (Power of 3, Ch 17). On a bullish day this is the\n     DISTRIBUTION half - late in the cycle for a buy.\n'
        _anyMd := true
    if str.contains(_t, 'DO-')
        _w += 'DO-  Below the daily open (Power of 3, Ch 17). On a bullish day this is the\n     MANIPULATION half - early in the cycle, which is where you want to be.\n'
        _anyMd := true
    if not _anyMd
        _w += 'none\n'

    _w += '\n── PRICE LOCATION ──\n'
    if str.contains(_t, 'DISC')
        _w += 'DISC  Discount. Below the 50% of the dealing range - the buy half.\n'
    else if str.contains(_t, 'PREM')
        _w += 'PREM  Premium. Above the 50% of the dealing range - the sell half.\n'
    else
        _w += 'EQ  At equilibrium, the 50% of the dealing range. Neither half.\n'
    _w

// The target cell, spelled out: which pool, how far, and the honest caveat.
f_tgtWhy(float _t, float _r, string _src, bool _hit) =>
    na(_t) ? 'No pool of resting liquidity sat on the far side of this entry, so the model had nothing to name as a draw.' : ('DRAW ON LIQUIDITY\n\nPrice: ' + str.tostring(_t, '#.##') + '\nDistance: ' + str.tostring(_r, '#.##') + 'R from entry\n' + (_hit ? 'Reached: YES - price traded to this level.\n' : 'Reached: not yet.\n') + '\nPool: ' + (str.contains(_src, 'H1') ? 'an H1 swing level' : str.contains(_src, 'H4') ? 'an H4 swing level' : str.contains(_src, 'ERL') ? 'the dealing-range edge - external range liquidity' : str.contains(_src, 'PDH') or str.contains(_src, 'PDL') ? 'the PREVIOUS DAY high/low - one of the heaviest stop clusters' : str.contains(_src, 'PWH') or str.contains(_src, 'PWL') ? 'the PREVIOUS WEEK high/low - heavier still' : 'unknown') + '\n' + (str.contains(_src, '!') ? '\n!  No pool cleared the minimum R. This is merely the best that was\n   available, NOT a valid draw by the rule you set.\n' : ''))

// "4361.2 1.8R ✔" - the price, how far that is in R, and whether it was
// reached. Blank when no pool sat on the far side of the entry.
f_tgtTxt(float _t, float _r, string _src, bool _hit) =>
    na(_t) ? '—' : (str.tostring(_t, '#.##') + '  ' + str.tostring(_r, '#.#') + 'R' + (_hit ? ' ✔' : '') + (_src != '' ? ' ' + _src : ''))

//─────────────────────────────────────────────────────────────────────────
//  THE PICKER  —  every pool on the far side, then a choice among them
//
//  Returns [price, source, R]. Sources: H1 / H4 swing, ERL (the dealing-range
//  edge), PDH-PDL (previous day) and PWH-PWL (previous week). A trailing !
//  means nothing cleared the minimum and this is merely the best there was.
//─────────────────────────────────────────────────────────────────────────
f_drawTgt(int _dir, float _px, float _risk) =>
    array<float>  _p = array.new_float()
    array<string> _s = array.new_string()
    if _dir == 1
        if not na(h1PH) and h1PH > _px
            array.push(_p, h1PH)
            array.push(_s, 'H1')
        if not na(h4PH) and h4PH > _px
            array.push(_p, h4PH)
            array.push(_s, 'H4')
        if not na(_drHi) and _drHi > _px
            array.push(_p, _drHi)
            array.push(_s, 'ERL')
        if tgtUsePdw and not na(pdhLvl) and pdhLvl > _px
            array.push(_p, pdhLvl)
            array.push(_s, 'PDH')
        if tgtUsePdw and not na(pwhLvl) and pwhLvl > _px
            array.push(_p, pwhLvl)
            array.push(_s, 'PWH')
    else
        if not na(h1PL) and h1PL < _px
            array.push(_p, h1PL)
            array.push(_s, 'H1')
        if not na(h4PL) and h4PL < _px
            array.push(_p, h4PL)
            array.push(_s, 'H4')
        if not na(_drLo) and _drLo < _px
            array.push(_p, _drLo)
            array.push(_s, 'ERL')
        if tgtUsePdw and not na(pdlLvl) and pdlLvl < _px
            array.push(_p, pdlLvl)
            array.push(_s, 'PDL')
        if tgtUsePdw and not na(pwlLvl) and pwlLvl < _px
            array.push(_p, pwlLvl)
            array.push(_s, 'PWL')

    float  _best = na
    string _bsrc = ''
    int    _n    = array.size(_p)

    if _n > 0
        // pure ERL: the range edge, whatever the distance to it
        if tgtMode == 'Opposite range edge (ERL)'
            for i = 0 to _n - 1
                if array.get(_s, i) == 'ERL'
                    _best := array.get(_p, i)
                    _bsrc := 'ERL'
        // otherwise the NEAREST pool that still pays, tracking the furthest
        // one as the fallback for when none of them do
        if na(_best)
            float  _far  = na
            string _fsrc = ''
            for i = 0 to _n - 1
                float _c = array.get(_p, i)
                float _d = math.abs(_c - _px)
                float _r = _risk > 0 ? _d / _risk : 0.0
                if (tgtMode == 'Nearest pool' or _r >= tgtMinR) and (na(_best) or _d < math.abs(_best - _px))
                    _best := _c
                    _bsrc := array.get(_s, i)
                if na(_far) or _d > math.abs(_far - _px)
                    _far  := _c
                    _fsrc := array.get(_s, i)
            if na(_best) and tgtShort == 'Furthest pool, flagged !'
                _best := _far
                _bsrc := _fsrc + '!'

    [_best, _bsrc, (na(_best) or _risk <= 0) ? na : math.abs(_best - _px) / _risk]

// The ICT stop sits beyond the pool on the WRONG side - not entry minus n x
// ATR. It is the plan's stop in the levels panel, and optionally the risk the
// target's R is measured against.
float _ictStopL = f_pickBelow(close, h1PL, h4PL, _drLo)
float _ictStopS = f_pickAbove(close, h1PH, h4PH, _drHi)
float _riskAtr  = atr * atrMultiplier
float _riskL    = tgtRBasis == 'ICT stop (beyond the pool)' and not na(_ictStopL) ? math.abs(close - _ictStopL) : _riskAtr
float _riskS    = tgtRBasis == 'ICT stop (beyond the pool)' and not na(_ictStopS) ? math.abs(_ictStopS - close) : _riskAtr

// evaluated every bar so the levels panel can show the prospective draw for
// both directions, and so the gate below has something to test
[_tgtL, _tsrcL, _trL] = f_drawTgt(1,  close, _riskL)
[_tgtS, _tsrcS, _trS] = f_drawTgt(-1, close, _riskS)

// Rule 3 as a filter, only when asked for
bool tgtOkL = not tgtGate or (not na(_trL) and _trL >= tgtMinR)
bool tgtOkS = not tgtGate or (not na(_trS) and _trS >= tgtMinR)

//───────────────────────────────────────────────────────────────────────────
// The confirming timeframe's own EMA state and its cross events.
// lookahead_off, so on history the value only becomes available once that HTF
// bar has CLOSED - the same information you would have had live.
//───────────────────────────────────────────────────────────────────────────
f_mtfEma() =>
    float _e9  = ta.ema(close, 9)
    float _e21 = ta.ema(close, 21)
    [_e9 > _e21, ta.crossover(_e9, _e21), ta.crossunder(_e9, _e21)]

[mtfUp, mtfXUp, mtfXDn] = request.security(syminfo.tickerid, mtfTf, f_mtfEma(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

buyCond     = ta.crossover(ema9, ema21)
sellCond    = ta.crossunder(ema9, ema21)

// Bars since each side last crossed, counted in CHART bars so one window
// covers both. 9999 = it has not happened yet, so a window test fails cleanly.
int _ltfUpAgo = nz(ta.barssince(buyCond),  9999)
int _ltfDnAgo = nz(ta.barssince(sellCond), 9999)
int _mtfUpAgo = nz(ta.barssince(mtfXUp),   9999)
int _mtfDnAgo = nz(ta.barssince(mtfXDn),   9999)

// PAIR: both crossed inside the window, and THIS bar is the one that completed
// the pair - whichever timeframe it was. That is the "3m went first, 5m just
// confirmed, enter now" case.
bool _mtfPairUp = _ltfUpAgo <= mtfWindow and _mtfUpAgo <= mtfWindow and (buyCond  or mtfXUp)
bool _mtfPairDn = _ltfDnAgo <= mtfWindow and _mtfDnAgo <= mtfWindow and (sellCond or mtfXDn)

// ALIGNED: the ordinary chart cross, but only when the HTF already agrees.
bool _mtfAlignUp = buyCond  and mtfUp
bool _mtfAlignDn = sellCond and not mtfUp

// the cross condition the engine actually uses
bool buyCondEff  = not mtfOn ? buyCond  : (mtfMode == 'Both aligned — chart cross, HTF already agrees' ? _mtfAlignUp : _mtfPairUp)
bool sellCondEff = not mtfOn ? sellCond : (mtfMode == 'Both aligned — chart cross, HTF already agrees' ? _mtfAlignDn : _mtfPairDn)

// Signal Quality Filter: each enabled condition must agree for the cross to
// count. A disabled condition (checkbox off) passes automatically.
bool _qTrend  = not qfTrend    or adx >= adxMin
bool _qStruct = not qfStruct   or math.abs(ema21 - ema50) >= (structMult * atr)
bool _qVolume = not qfVolume   or volume > volAvg
bool _qCool   = not qfCooldown or (bar_index - signalBarIdx) >= cooldownBars
bool _qCommon = _qTrend and _qStruct and _qVolume and _qCool
bool _qLong   = _qCommon and (not qfEma50 or close > ema50) and (not qfVwap or close > vwapV) and (not qfBias or bullPct >= biasMin)
bool _qShort  = _qCommon and (not qfEma50 or close < ema50) and (not qfVwap or close < vwapV) and (not qfBias or bearPct >= biasMin)
bool qualityLong  = not enableQFilter or _qLong
bool qualityShort = not enableQFilter or _qShort

triggerBuy  = buyCondEff and lastSignalState <= 0 and qualityLong and pdLong and tgtOkL
triggerSell = sellCondEff and lastSignalState >= 0 and qualityShort and pdShort and tgtOkS

// Hit-flags are declared here so the snapshot below can read the OUTGOING
// trade's final state before a fresh signal resets them further down.
var bool slHit = false
var bool t1Hit = false
var bool t2Hit = false
var bool t3Hit = false
var bool t4Hit = false
var bool t5Hit = false
var bool tradeClosed = false   // true once SL or TP5 first hits; freezes the trade
var bool ictTgtHit = false     // did price reach the ICT draw before the trade ended?

// ── EXPORT: one CSV line per completed trade ─────────────────────────────
// Emitted at the same moment the trade is written into the log arrays, so the
// exported set and the on-screen log are always the same set of trades.
string _xd  = expSep == 'tab' ? '\t' : expSep
string _xtz = logTz == 'Exchange' ? syminfo.timezone : logTz   // _dayTz is declared later; do not reach forward for it
if expOn and expHdr and barstate.isfirst
    log.info('time' + _xd + 'dir' + _xd + 'entry' + _xd + 'stop' + _xd + 'exit' + _xd + 'result' + _xd + 'code' + _xd + 'pips' + _xd + 'grade' + _xd + 'reason' + _xd + 'ind' + _xd + 'ict_target')

// numeric mirrors for TradingView's own Export chart data (na except on the
// bar a trade is logged, so the CSV has one populated row per trade)
float _xEntry = na
float _xStop  = na
float _xExit  = na
float _xCode  = na
float _xPips  = na
float _xAdx   = na
float _xRsi   = na

// snapshot the outgoing trade into the log BEFORE the new signal
// overwrites entryP / lastSignalState / hit-flags.
bool _outgoingResolved = slHit or t5Hit
if (triggerBuy or triggerSell) and lastSignalState != 0 and (logIncludeFlips or _outgoingResolved)
    array.push(logTimeArr,  entryTime)
    array.push(logDirArr,   lastSignalState)
    array.push(logEntryArr, entryP)
    array.push(logSlArr,    slP)                 // ADDED
    array.push(logResArr,   f_tradeResult(slHit, t1Hit, t2Hit, t3Hit, t4Hit, t5Hit))
    array.push(logIctArr,   curIct)
    array.push(logIndArr,   curInd)
    array.push(logGrdArr,   curGrade)
    array.push(logTgtArr,   f_tgtTxt(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit))

    // the exported row, built from the SAME values just pushed above
    string _xRes  = f_tradeResult(slHit, t1Hit, t2Hit, t3Hit, t4Hit, t5Hit)
    float  _xEx   = f_resultPrice(_xRes, entryP, slP, lastSignalState)
    float  _xCd   = str.contains(_xRes, 'SL') ? -1.0 : str.contains(_xRes, 'TP5') ? 5.0 : str.contains(_xRes, 'TP4') ? 4.0 : str.contains(_xRes, 'TP3') ? 3.0 : str.contains(_xRes, 'TP2') ? 2.0 : str.contains(_xRes, 'TP1') ? 1.0 : 0.0
    float  _xPp   = f_tradePips(_xRes, entryP, slP, pipSize)
    _xEntry := entryP
    _xStop  := slP
    _xExit  := _xEx
    _xCode  := _xCd
    _xPips  := _xPp
    _xAdx   := adx
    _xRsi   := rsiVal
    if expOn
        log.info(str.format_time(entryTime, 'yyyy-MM-dd HH:mm', _xtz) + _xd + (lastSignalState == 1 ? 'LONG' : 'SHORT') + _xd + str.tostring(entryP, '#.##') + _xd + str.tostring(slP, '#.##') + _xd + (na(_xEx) ? '' : str.tostring(_xEx, '#.##')) + _xd + '"' + _xRes + '"' + _xd + str.tostring(_xCd, '#.#') + _xd + str.tostring(_xPp, '#.#') + _xd + '"' + curGrade + '"' + _xd + '"' + curIct + '"' + _xd + '"' + curInd + '"' + _xd + '"' + f_tgtTxt(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit) + '"')

    if array.size(logDirArr) > 60
        array.shift(logTimeArr)
        array.shift(logDirArr)
        array.shift(logEntryArr)
        array.shift(logSlArr)                    // ADDED
        array.shift(logResArr)
        array.shift(logIctArr)
        array.shift(logIndArr)
        array.shift(logGrdArr)
        array.shift(logTgtArr)

// Resolved BEFORE registration, so a level is never credited with the high or
// low of the very bar it was set on.
if hrOn and array.size(hrPx) > 0
    for i = array.size(hrPx) - 1 to 0
        float _hp = array.get(hrPx, i)
        int   _hd = array.get(hrDir, i)
        bool  _hh = _hd == 1 ? high >= _hp : low <= _hp
        bool  _he = bar_index - array.get(hrBar, i) > hrWindow
        if _hh or _he
            f_hrRecord(array.get(hrSrc, i), _hh)
            int _bk = array.get(hrBkt, i)
            f_hrRecord(_bk >= 0 ? _bk + 5 : -1, _hh)
            array.remove(hrPx,  i)
            array.remove(hrDir, i)
            array.remove(hrBar, i)
            array.remove(hrSrc, i)
            array.remove(hrBkt, i)

if triggerBuy or triggerSell
    lastSignalState := triggerBuy ? 1 : -1
    signalBarIdx    := bar_index
    entryTime       := time
    entryP          := close
    curIct          := ictSessOn ? f_ictTag(triggerBuy ? 1 : -1) : '-'
    curInd          := f_indTag(triggerBuy ? 1 : -1)
    curGrade        := f_ictGrade(triggerBuy ? 1 : -1, triggerBuy ? _trL : _trS)
    float risk      = atr * atrMultiplier
    curIctTgt       := triggerBuy ? _tgtL  : _tgtS
    curIctTgtS      := triggerBuy ? _tsrcL : _tsrcS
    curIctTgtR      := triggerBuy ? _trL   : _trS
    if hrOn and not na(curIctTgt)
        array.push(hrPx,  curIctTgt)
        array.push(hrDir, triggerBuy ? 1 : -1)
        array.push(hrBar, bar_index)
        array.push(hrSrc, f_hrSrcIdx(curIctTgtS))
        array.push(hrBkt, f_hrBktIdx(curIctTgtR))
        while array.size(hrPx) > 200
            array.shift(hrPx)
            array.shift(hrDir)
            array.shift(hrBar)
            array.shift(hrSrc)
            array.shift(hrBkt)
    slP := triggerBuy ? (entryP - risk) : (entryP + risk)
    t1  := triggerBuy ? (entryP + (risk * 1.0)) : (entryP - (risk * 1.0))
    t2  := triggerBuy ? (entryP + (risk * 2.0)) : (entryP - (risk * 2.0))
    t3  := triggerBuy ? (entryP + (risk * 3.0)) : (entryP - (risk * 3.0))
    t4  := triggerBuy ? (entryP + (risk * 4.0)) : (entryP - (risk * 4.0))
    t5  := triggerBuy ? (entryP + (risk * 5.0)) : (entryP - (risk * 5.0))

//-----------------------------------------------------------------------------}
// SL/TP hit detection: latch on FIRST real touch, trade closes on first SL or
// TP5 hit.
//-----------------------------------------------------------------------------{

// fresh signal clears everything for the new trade
if triggerBuy or triggerSell
    slHit := false, t1Hit := false, t2Hit := false
    ictTgtHit := false
    t3Hit := false, t4Hit := false, t5Hit := false
    tradeClosed := false

// latch levels only while the trade is still live (TPs checked before SL, so an
// ambiguous bar that spans both still registers the TP, then closes the trade)
if not tradeClosed and lastSignalState == 1 and bar_index >= signalBarIdx
    if not na(curIctTgt) and high >= curIctTgt
        ictTgtHit := true
    if high >= t1
        t1Hit := true
    if high >= t2
        t2Hit := true
    if high >= t3
        t3Hit := true
    if high >= t4
        t4Hit := true
    if high >= t5
        t5Hit := true
    if low  <= slP
        slHit := true
    if slHit or t5Hit
        tradeClosed := true
else if not tradeClosed and lastSignalState == -1 and bar_index >= signalBarIdx
    if not na(curIctTgt) and low <= curIctTgt
        ictTgtHit := true
    if low  <= t1
        t1Hit := true
    if low  <= t2
        t2Hit := true
    if low  <= t3
        t3Hit := true
    if low  <= t4
        t4Hit := true
    if low  <= t5
        t5Hit := true
    if high >= slP
        slHit := true
    if slHit or t5Hit
        tradeClosed := true

// the moment a trade closes on SL/TP5, tag its chart label with an icon.
if enableSniper and tagChartOutcome and tradeClosed and not tradeClosed[1] and not na(curSigLabel)
    label.set_text(curSigLabel, label.get_text(curSigLabel) + (slHit ? ' 💣' : ' 🚀'))

bool nearEntry = math.abs(close - entryP) <= (atr * 1.0)
bool isRetest = nearEntry and ((lastSignalState == 1 and low <= ema9 and low > ema21) or (lastSignalState == -1 and high >= ema9 and high < ema21))

string dashStatus = 'WAIT'
color dashStatusColor = color.black

if triggerBuy or triggerSell
    dashStatus := 'ENTERED'
    dashStatusColor := color.blue
else if slHit or t5Hit
    dashStatus := 'EXIT'
    dashStatusColor := slHit ? color.red : color.green
else if lastSignalState != 0
    if isRetest or adx < 20
        dashStatus := 'EXHAUSTED'
        dashStatusColor := color.orange
    else
        dashStatus := 'HOLD'
        dashStatusColor := color.green

buySig  = enableSniper and showSniperTrades and triggerBuy
sellSig = enableSniper and showSniperTrades and triggerSell
buyStyle   = sniperSigStyle == 'Triangle' ? label.style_none : label.style_label_up
sellStyle  = sniperSigStyle == 'Triangle' ? label.style_none : label.style_label_down
buyTxt     = sniperSigStyle == 'Triangle' ? '▲' : 'BUY'
sellTxt    = sniperSigStyle == 'Triangle' ? '▼' : 'SELL'
buyTxtCol  = sniperSigStyle == 'Triangle' ? color.green : color.white
sellTxtCol = sniperSigStyle == 'Triangle' ? color.red   : color.white
buyBgCol   = sniperSigStyle == 'Triangle' ? na : color.green
sellBgCol  = sniperSigStyle == 'Triangle' ? na : color.red
if buySig
    curSigLabel := label.new(bar_index, na, buyTxt,  xloc = xloc.bar_index, yloc = yloc.belowbar, color = buyBgCol,  textcolor = buyTxtCol,  style = buyStyle,  size = sniperSignalSize)
if sellSig
    curSigLabel := label.new(bar_index, na, sellTxt, xloc = xloc.bar_index, yloc = yloc.abovebar, color = sellBgCol, textcolor = sellTxtCol, style = sellStyle, size = sniperSignalSize)

newsNow = (newsEn1 and not na(time(timeframe.period, newsSess1, newsTz))) or (newsEn2 and not na(time(timeframe.period, newsSess2, newsTz))) or (newsEn3 and not na(time(timeframe.period, newsSess3, newsTz)))

string regimeTxt = adx >= 25 ? (plusDI >= minusDI ? 'Trending ▲' : 'Trending ▼') : adx < 20 ? 'Choppy' : 'Transition'
color  regimeCol = adx >= 25 ? (plusDI >= minusDI ? color.green : color.red) : adx < 20 ? color.gray : color.orange

//───────────────────────────────────────────────────────────────────────────
// ADDED — Day P/L: realized pips from trades logged on the current day, plus
// the current trade if it has already resolved (SL/TP5) but not yet flipped
// into the log. Day boundary is read in the Trade Log timezone.
//───────────────────────────────────────────────────────────────────────────
string _dayTz  = logTz == 'Exchange' ? syminfo.timezone : logTz
float  dayPips = 0.0
int    dayWins = 0
int    dayLoss = 0
if enableSniper and barstate.islast
    string _todayKey = str.format_time(time, 'yyyy-MM-dd', _dayTz)
    if array.size(logDirArr) > 0
        for i = 0 to array.size(logDirArr) - 1
            if str.format_time(array.get(logTimeArr, i), 'yyyy-MM-dd', _dayTz) == _todayKey
                float _p = f_tradePips(array.get(logResArr, i), array.get(logEntryArr, i), array.get(logSlArr, i), pipSize)
                dayPips += _p
                dayWins := _p > 0.0 ? dayWins + 1 : dayWins
                dayLoss := _p < 0.0 ? dayLoss + 1 : dayLoss
    // current trade counted the moment it resolves, before it flips into the log
    if lastSignalState != 0 and tradeClosed and str.format_time(entryTime, 'yyyy-MM-dd', _dayTz) == _todayKey
        float _pc = f_tradePips(f_tradeResult(slHit, t1Hit, t2Hit, t3Hit, t4Hit, t5Hit), entryP, slP, pipSize)
        dayPips += _pc
        dayWins := _pc > 0.0 ? dayWins + 1 : dayWins
        dayLoss := _pc < 0.0 ? dayLoss + 1 : dayLoss
string dayPipsStr = (dayPips >= 0.0 ? '+' : '') + str.tostring(dayPips, '#.#') + ' p  (' + str.tostring(dayWins) + 'W/' + str.tostring(dayLoss) + 'L)'
color  dayPipsCol = dayPips > 0.0 ? color.green : dayPips < 0.0 ? color.red : color.gray

var table d = table.new(f_getDashPos(dashPosInput), 2, 36, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 70))
if enableSniper and showSniperDash and dashStyle == 'Full (indicators)' and barstate.islast
    table.clear(d, 0, 0, 1, 35)
    table.set_position(d, f_getDashPos(dashPosInput))
    int rw = 0
    if showBiasRow
        table.cell(d, 0, rw, 'BIAS',   text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, biasText, text_color = color.white, bgcolor = biasCol,                   text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
    if showScoreRow
        f_addDashRow(d, rw, 'B / S %', str.tostring(bullPct, '#') + ' / ' + str.tostring(bearPct, '#'), bullPct >= bearPct ? color.green : color.red, dashTextSize)
        rw += 1
    if showMarketRow
        table.cell(d, 0, rw, 'Market',   text_color = color.black, text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, regimeTxt,  text_color = color.white, bgcolor = regimeCol, text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
    if showVwapRow
        f_addDashRow(d, rw, 'VWAP', close > vwapV ? 'Above' : 'Below', close > vwapV ? color.green : color.red, dashTextSize)
        rw += 1
    if showRsiRow
        f_addDashRow(d, rw, 'RSI', str.tostring(rsiVal, '#.#'), rsiVal > 50 ? color.green : color.red, dashTextSize)
        rw += 1
    if showMacdRow
        f_addDashRow(d, rw, 'MACD', m > s ? 'Bull' : 'Bear', m > s ? color.green : color.red, dashTextSize)
        rw += 1
    if showEmaRow
        f_addDashRow(d, rw, 'EMA 9/21', ema9 > ema21 ? 'Bull' : 'Bear', ema9 > ema21 ? color.green : color.red, dashTextSize)
        rw += 1
    if showAdxRow
        f_addDashRow(d, rw, 'ADX', str.tostring(adx, '#') + (adx > 25 ? ' Strong' : ' Weak'), adx > 25 ? color.green : color.gray, dashTextSize)
        rw += 1
    if showAtrVolRow
        f_addDashRow(d, rw, 'ATR·Vol', str.tostring(atr, '#.##') + ' · ' + (volume > volAvg ? 'Hi' : 'Lo'), volume > volAvg ? color.green : color.gray, dashTextSize)
        rw += 1
    if showPdRow
        string _pdTxt = not pdEnable ? 'off' : (pdLong and pdShort ? 'L ✔  S ✔' : pdLong ? 'L ✔  S ✖' : pdShort ? 'L ✖  S ✔' : 'L ✖  S ✖')
        f_addDashRow(d, rw, 'HTF PD', _pdTxt, not pdEnable ? color.gray : (pdLong or pdShort ? color.green : color.red), dashTextSize)
        rw += 1
    if showNewsRow
        table.cell(d, 0, rw, 'News', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize)
        table.cell(d, 1, rw, newsNow ? '⚠ NEWS' : 'Clear', text_color = color.white, bgcolor = newsNow ? color.red : color.new(color.green, 20), text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
    // ALTERED — full Entry / SL / TP1 → TP5 ladder (was TP5 only)
    if showTradeRow and tradeDisplayInput != 'Chart' and lastSignalState != 0
        table.cell(d, 0, rw, 'TRADE', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, lastSignalState == 1 ? 'LONG' : 'SHORT', text_color = color.white, bgcolor = lastSignalState == 1 ? color.green : color.red, text_halign = text.align_right, text_size = dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'Entry', str.tostring(entryP, '#.##'), color.blue, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'SL',  str.tostring(slP, '#.##') + (slHit ? ' 💣' : ''), color.red,   dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP1', str.tostring(t1, '#.##')  + (t1Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP2', str.tostring(t2, '#.##')  + (t2Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP3', str.tostring(t3, '#.##')  + (t3Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP4', str.tostring(t4, '#.##')  + (t4Hit ? ' ✔' : ''),  color.green, dashTextSize)
        rw += 1
        f_addDashRow(d, rw, 'TP5', str.tostring(t5, '#.##')  + (t5Hit ? ' 🚀' : ''), color.green, dashTextSize)
        rw += 1
    // ADDED — running daily pip total
    if showDayRow
        f_addDashRow(d, rw, 'Day P/L', dayPipsStr, dayPipsCol, dashTextSize)
        rw += 1
    if showStatusRow
        table.cell(d, 0, rw, 'Status',   text_color = color.black, text_halign = text.align_left,  text_size = dashTextSize)
        table.cell(d, 1, rw, dashStatus, text_color = color.white, bgcolor = dashStatusColor, text_halign = text.align_right, text_size = dashTextSize)
        rw += 1

//───────────────────────────────────────────────────────────────────────────
// DASHBOARD — ICT SIMPLE
//
// One card. A trade needs four things answered: where you got in, where you
// are out if you are wrong, where you are out if you are right, and WHY you
// are in it. RSI, MACD, ADX and the bias score answer none of those, so they
// live in the Full style instead.
//
// FLAT it does not go blank - it shows the draw on both sides and whether the
// PD arrays currently permit each direction, which is the decision you are
// actually making while you wait.
//───────────────────────────────────────────────────────────────────────────
if enableSniper and showSniperDash and dashStyle == 'ICT simple' and barstate.islast
    table.clear(d, 0, 0, 1, 35)
    table.set_position(d, f_getDashPos(dashPosInput))
    bool _live = lastSignalState != 0
    int rw2 = 0

    table.cell(d, 0, rw2, 'ICT MODEL', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = dashTextSize)
    table.cell(d, 1, rw2, _live ? (lastSignalState == 1 ? 'LONG' : 'SHORT') : 'FLAT', text_color = color.white, bgcolor = _live ? (lastSignalState == 1 ? color.green : color.red) : color.gray, text_halign = text.align_right, text_size = dashTextSize)
    rw2 += 1

    if _live
        // The ICT plan is the headline. Entry / Stop / Target here are the
        // METHOD's levels - the stop sits beyond the pool that invalidates the
        // idea, the target is the draw on liquidity.
        table.cell(d, 0, rw2, 'Grade', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = f_grdWhy(curGrade))
        table.cell(d, 1, rw2, curGrade, text_color = f_grdCol(curGrade), text_halign = text.align_right, text_size = dashTextSize, tooltip = f_grdWhy(curGrade))
        rw2 += 1
        f_addDashRow(d, rw2, 'Entry', str.tostring(entryP, '#.##'), color.blue, dashTextSize)
        rw2 += 1
        float _s2 = lastSignalState == 1 ? f_pickBelow(entryP, h1PL, h4PL, _drLo) : f_pickAbove(entryP, h1PH, h4PH, _drHi)
        string _s2src = f_tgtSrc(_s2)
        f_addDashRow(d, rw2, 'Stop', (na(_s2) ? '—' : str.tostring(_s2, '#.##')) + (_s2src != '' ? '  ' + _s2src : ''), color.red, dashTextSize)
        rw2 += 1
        // written cell-by-cell rather than via f_addDashRow, so the hover
        // tooltip can carry the long-form explanation
        table.cell(d, 0, rw2, 'Target', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = f_tgtWhy(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit))
        table.cell(d, 1, rw2, f_tgtTxt(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit), text_color = ictTgtHit ? color.green : color.new(color.teal, 0), text_halign = text.align_right, text_size = dashTextSize, tooltip = f_tgtWhy(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit))
        rw2 += 1
        table.cell(d, 0, rw2, 'Reason', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = f_ictWhy(curIct))
        table.cell(d, 1, rw2, curIct, text_color = color.new(color.purple, 0), text_halign = text.align_right, text_size = dashTextSize, tooltip = f_ictWhy(curIct))
        rw2 += 1
        // the indicator state, same string the log carries, with the combined
        // read on hover rather than a per-mark legend
        table.cell(d, 0, rw2, 'Ind', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize, tooltip = f_indWhy(curInd))
        table.cell(d, 1, rw2, f_indShort(curInd) + '  ' + curInd, text_color = f_indCol(curInd), text_halign = text.align_right, text_size = dashTextSize, tooltip = f_indWhy(curInd))
        rw2 += 1
        // The ATR ladder still governs what the script actually latches as a
        // result, so it is shown - but greyed, as reference, not as the plan.
        f_addDashRow(d, rw2, 'ATR stop', str.tostring(slP, '#.##') + (slHit ? '  💣' : ''), color.new(color.gray, 0), dashTextSize)
        rw2 += 1
        f_addDashRow(d, rw2, 'ATR TP5', str.tostring(t5, '#.##') + (t5Hit ? '  🚀' : ''), color.new(color.gray, 0), dashTextSize)
        rw2 += 1
    else
        f_addDashRow(d, rw2, 'Zone', ictPd + '  ' + ictKz + (ictPo3 != '' ? '  ' + ictPo3 : ''), ictPd == 'DISC' ? color.green : ictPd == 'PREM' ? color.red : color.gray, dashTextSize)
        rw2 += 1
        f_addDashRow(d, rw2, 'Draw ▲', f_tgtTxt(_tgtL, _trL, _tsrcL, false), (not na(_trL) and _trL >= tgtMinR) ? color.green : color.gray, dashTextSize)
        rw2 += 1
        f_addDashRow(d, rw2, 'Draw ▼', f_tgtTxt(_tgtS, _trS, _tsrcS, false), (not na(_trS) and _trS >= tgtMinR) ? color.red : color.gray, dashTextSize)
        rw2 += 1
        f_addDashRow(d, rw2, 'HTF PD', not pdEnable ? 'off' : (pdLong and pdShort ? 'L ✔  S ✔' : pdLong ? 'L ✔  S ✖' : pdShort ? 'L ✖  S ✔' : 'L ✖  S ✖'), not pdEnable ? color.gray : (pdLong or pdShort ? color.green : color.red), dashTextSize)
        rw2 += 1
        if mtfOn
            // which way the confirming timeframe is leaning, and whether the
            // chart cross is still inside the pairing window
            string _mtfTxt = (mtfUp ? '▲' : '▼') + '  ' + (_ltfUpAgo <= mtfWindow ? 'up ' + str.tostring(_ltfUpAgo) + 'b' : _ltfDnAgo <= mtfWindow ? 'dn ' + str.tostring(_ltfDnAgo) + 'b' : 'no pair')
            f_addDashRow(d, rw2, mtfTf + ' EMA', _mtfTxt, mtfUp ? color.green : color.red, dashTextSize)
            rw2 += 1

    // ── LEVELS ───────────────────────────────────────────────────────────
    // Nearest pool each side only. Full breakdown lives in the standalone panel.
    if dashShowLevels
        table.cell(d, 0, rw2, 'LEVELS', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = dashTextSize)
        table.cell(d, 1, rw2, '', bgcolor = color.new(color.black, 0), text_size = dashTextSize)
        rw2 += 1
        float _lvA = f_pickAbove(close, h1PH, h4PH, _drHi)
        float _lvB = f_pickBelow(close, h1PL, h4PL, _drLo)
        f_addDashRow(d, rw2, 'Above', (na(_lvA) ? '—' : str.tostring(_lvA, '#.##')) + (f_tgtSrc(_lvA) != '' ? '  ' + f_tgtSrc(_lvA) : ''), color.red, dashTextSize)
        rw2 += 1
        f_addDashRow(d, rw2, 'EQ 50%', na(_drEq) ? '—' : str.tostring(_drEq, '#.##'), color.gray, dashTextSize)
        rw2 += 1
        f_addDashRow(d, rw2, 'Below', (na(_lvB) ? '—' : str.tostring(_lvB, '#.##')) + (f_tgtSrc(_lvB) != '' ? '  ' + f_tgtSrc(_lvB) : ''), color.green, dashTextSize)
        rw2 += 1
        float _rgD = _drHi - _drLo
        bool _inBd = close <= (_drHi - 0.62 * _rgD) and close >= (_drHi - 0.79 * _rgD)
        bool _inSd = close >= (_drLo + 0.62 * _rgD) and close <= (_drLo + 0.79 * _rgD)
        f_addDashRow(d, rw2, 'OTE buy',  str.tostring(_drHi - 0.79 * _rgD, '#.##') + ' – ' + str.tostring(_drHi - 0.62 * _rgD, '#.##') + (_inBd ? '  ●' : ''), _inBd ? color.green : color.gray, dashTextSize)
        rw2 += 1
        f_addDashRow(d, rw2, 'OTE sell', str.tostring(_drLo + 0.62 * _rgD, '#.##') + ' – ' + str.tostring(_drLo + 0.79 * _rgD, '#.##') + (_inSd ? '  ●' : ''), _inSd ? color.red : color.gray, dashTextSize)
        rw2 += 1

    // ── GRADE, and whether it actually pays ──────────────────────────────
    // Counted over every logged trade, not the live one. Shown as "N · win%";
    // read N first - a 100% win rate on two trades is noise.
    //
    // What to look for: A+ should beat C. If it does not, the ICT context is
    // decorating the EMA trigger rather than improving it, and this is the
    // row that tells you so.
    if dashShowGrade
        table.cell(d, 0, rw2, 'GRADE', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = dashTextSize, tooltip = f_grdWhy('— rubric —'))
        table.cell(d, 1, rw2, 'N · win', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_right, text_size = dashTextSize)
        rw2 += 1
        array<int> _gN = array.new_int(4, 0)
        array<int> _gW = array.new_int(4, 0)
        if array.size(logGrdArr) > 0
            for i = 0 to array.size(logGrdArr) - 1
                string _gg = array.get(logGrdArr, i)
                int    _gi = str.startswith(_gg, 'A+') ? 0 : str.startswith(_gg, 'A') ? 1 : str.startswith(_gg, 'B') ? 2 : 3
                array.set(_gN, _gi, array.get(_gN, _gi) + 1)
                string _gr = array.get(logResArr, i)
                if str.contains(_gr, 'TP') and not str.contains(_gr, 'SL')
                    array.set(_gW, _gi, array.get(_gW, _gi) + 1)
        for _gb = 0 to 3
            int    _gt = array.get(_gN, _gb)
            float  _gp = _gt > 0 ? (array.get(_gW, _gb) * 100.0) / _gt : na
            string _gl = _gb == 0 ? 'A+' : _gb == 1 ? 'A' : _gb == 2 ? 'B' : 'C'
            f_addDashRow(d, rw2, _gl, str.tostring(_gt) + ' · ' + (na(_gp) ? '—' : str.tostring(_gp, '#') + '%'), na(_gp) ? color.gray : (_gp >= 60.0 ? color.green : _gp >= 40.0 ? color.orange : color.red), dashTextSize)
            rw2 += 1

    // ── DRAW REACHED, by distance ────────────────────────────────────────
    // The question this answers: is the minimum R you demand actually
    // reachable on this market? Shown as "N · hit%"; read N first.
    if dashShowHitRate and hrOn
        table.cell(d, 0, rw2, 'DRAW REACHED', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left, text_size = dashTextSize)
        table.cell(d, 1, rw2, 'N · hit', text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_right, text_size = dashTextSize)
        rw2 += 1
        for _b = 0 to 3
            int   _bt = array.get(hrTot, _b + 5)
            int   _bh = array.get(hrHit, _b + 5)
            float _bp = _bt > 0 ? (_bh * 100.0) / _bt : na
            string _bn = _b == 0 ? 'under 2R' : _b == 1 ? '2 – 3R' : _b == 2 ? '3 – 5R' : '5R +'
            f_addDashRow(d, rw2, _bn, str.tostring(_bt) + ' · ' + (na(_bp) ? '—' : str.tostring(_bp, '#') + '%'), na(_bp) ? color.gray : (_bp >= 60.0 ? color.green : _bp >= 40.0 ? color.orange : color.red), dashTextSize)
            rw2 += 1

    table.cell(d, 0, rw2, 'Status', text_color = color.black, text_halign = text.align_left, text_size = dashTextSize)
    table.cell(d, 1, rw2, dashStatus, text_color = color.white, bgcolor = dashStatusColor, text_halign = text.align_right, text_size = dashTextSize)
    rw2 += 1
    f_addDashRow(d, rw2, 'Day P/L', dayPipsStr, dayPipsCol, dashTextSize)
    rw2 += 1
    // Said once, plainly, at the bottom. The trigger is an EMA cross; every
    // level above it is ICT. Hiding that would make the panel a lie.
    f_addDashRow(d, rw2, 'Trigger', 'EMA 9/21 ✕' + (mtfOn ? ' +' + mtfTf + 'm' : '') + (pdEnable ? ' + PD' : '') + (enableQFilter ? ' + QF' : ''), color.new(color.gray, 30), dashTextSize)

//───────────────────────────────────────────────────────────────────────────
// ICT LEVELS PANEL
//
// The levels the METHOD points at, as opposed to the ATR ladder: resting
// liquidity above and below, equilibrium, the OTE pocket, and - once a trade is
// live - a stop placed beyond the liquidity that would invalidate it.
//
// A stop here is NOT entry minus n x ATR. ICT puts it beyond the pool price
// would have to take to prove the idea wrong, which is why it moves with the
// chart instead of with volatility.
//───────────────────────────────────────────────────────────────────────────
f_ilvHdr(table _t, int _row, string _txt) =>
    table.cell(_t, 0, _row, _txt, text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_left,  text_size = ilvSize)
    table.cell(_t, 1, _row, '',   text_color = color.white, bgcolor = color.new(color.black, 0), text_halign = text.align_right, text_size = ilvSize)

f_ilvPx(float _v) => na(_v) ? '—' : str.tostring(_v, '#.##')

var table dILV = table.new(f_getDashPos(ilvPos), 2, 28, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 70))
if enableSniper and enableIctLvls and ilvStyle == 'Full' and barstate.islast
    table.clear(dILV, 0, 0, 1, 27)
    table.set_position(dILV, f_getDashPos(ilvPos))
    int ir = 0

    f_ilvHdr(dILV, ir, 'ICT LEVELS')
    ir += 1
    f_addDashRow(dILV, ir, 'Zone', ictPd + '  ' + ictKz + (ictPo3 != '' ? '  ' + ictPo3 : ''), ictPd == 'DISC' ? color.green : ictPd == 'PREM' ? color.red : color.gray, ilvSize)
    ir += 1

    // ── the draw as it stands right now, for a trade not yet taken ───────
    // Green once the R clears the minimum, grey while it does not. This is
    // what the Target selection setting would pick if a signal fired here.
    f_ilvHdr(dILV, ir, 'DRAW  (if entered now)')
    ir += 1
    f_addDashRow(dILV, ir, 'Long ▲',  f_tgtTxt(_tgtL, _trL, _tsrcL, false), (not na(_trL) and _trL >= tgtMinR) ? color.green : color.gray, ilvSize)
    ir += 1
    f_addDashRow(dILV, ir, 'Short ▼', f_tgtTxt(_tgtS, _trS, _tsrcS, false), (not na(_trS) and _trS >= tgtMinR) ? color.red   : color.gray, ilvSize)
    ir += 1

    // ── liquidity above / below, nearest marked ──────────────────────────
    if ilvShowDraw
        float _nAbove = f_pickAbove(close, h1PH, h4PH, _drHi)
        float _nBelow = f_pickBelow(close, h1PL, h4PL, _drLo)
        f_ilvHdr(dILV, ir, 'LIQUIDITY ABOVE')
        ir += 1
        f_addDashRow(dILV, ir, 'H1 high',    f_ilvPx(h1PH) + (not na(_nAbove) and h1PH == _nAbove ? '  ◄' : ''), color.red, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'H4 high',    f_ilvPx(h4PH) + (not na(_nAbove) and h4PH == _nAbove ? '  ◄' : ''), color.red, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'Range high', f_ilvPx(_drHi) + (not na(_nAbove) and _drHi == _nAbove ? '  ◄' : ''), color.red, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'EQ (50%)',   f_ilvPx(_drEq), color.gray, ilvSize)
        ir += 1
        f_ilvHdr(dILV, ir, 'LIQUIDITY BELOW')
        ir += 1
        f_addDashRow(dILV, ir, 'H1 low',    f_ilvPx(h1PL) + (not na(_nBelow) and h1PL == _nBelow ? '  ◄' : ''), color.green, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'H4 low',    f_ilvPx(h4PL) + (not na(_nBelow) and h4PL == _nBelow ? '  ◄' : ''), color.green, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'Range low', f_ilvPx(_drLo) + (not na(_nBelow) and _drLo == _nBelow ? '  ◄' : ''), color.green, ilvSize)
        ir += 1

    // ── OTE pockets on the dealing range (Ch 5) ──────────────────────────
    if ilvShowOte
        float _rng = _drHi - _drLo
        // a BUY retraces DOWN from the range high; a SELL retraces UP from the low
        float _bHi = _drHi - 0.62  * _rng
        float _bSw = _drHi - 0.705 * _rng
        float _bLo = _drHi - 0.79  * _rng
        float _sLo = _drLo + 0.62  * _rng
        float _sSw = _drLo + 0.705 * _rng
        float _sHi = _drLo + 0.79  * _rng
        bool _inBuy  = close <= _bHi and close >= _bLo
        bool _inSell = close >= _sLo and close <= _sHi
        f_ilvHdr(dILV, ir, 'OTE ENTRY')
        ir += 1
        f_addDashRow(dILV, ir, 'Buy band',  f_ilvPx(_bLo) + ' – ' + f_ilvPx(_bHi) + (_inBuy ? '  ●' : ''),  _inBuy ? color.green : color.gray, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, '  sweet',   f_ilvPx(_bSw), _inBuy ? color.green : color.gray, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'Sell band', f_ilvPx(_sLo) + ' – ' + f_ilvPx(_sHi) + (_inSell ? '  ●' : ''), _inSell ? color.red : color.gray, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, '  sweet',   f_ilvPx(_sSw), _inSell ? color.red : color.gray, ilvSize)
        ir += 1

    // ── the live trade, priced the ICT way ───────────────────────────────
    if ilvShowPlan and lastSignalState != 0
        // ICT stop: beyond the pool that would prove the idea wrong, not n x ATR
        float _stop = lastSignalState == 1 ? f_pickBelow(entryP, h1PL, h4PL, _drLo) : f_pickAbove(entryP, h1PH, h4PH, _drHi)
        string _stopSrc = f_tgtSrc(_stop)
        f_ilvHdr(dILV, ir, lastSignalState == 1 ? 'PLAN — LONG' : 'PLAN — SHORT')
        ir += 1
        f_addDashRow(dILV, ir, 'Entry',  f_ilvPx(entryP), color.blue, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'ICT stop', f_ilvPx(_stop) + (_stopSrc != '' ? '  ' + _stopSrc : ''), color.red, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'ICT target', f_tgtTxt(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit), ictTgtHit ? color.green : color.new(color.teal, 0), ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'ATR stop', f_ilvPx(slP) + (slHit ? '  💣' : ''), color.gray, ilvSize)
        ir += 1
        f_addDashRow(dILV, ir, 'ATR TP5',  f_ilvPx(t5) + (t5Hit ? '  🚀' : ''), color.gray, ilvSize)
        ir += 1

//───────────────────────────────────────────────────────────────────────────
// ICT LEVELS — SIMPLE
//
// The Full panel lists H1, H4 and the range edge as separate rows on each side.
// In practice you only act on the NEAREST one, so this collapses each side to
// that single level and names which pool it came from.
//───────────────────────────────────────────────────────────────────────────
if enableSniper and enableIctLvls and ilvStyle == 'Simple' and barstate.islast
    table.clear(dILV, 0, 0, 1, 27)
    table.set_position(dILV, f_getDashPos(ilvPos))
    int ir2 = 0

    f_ilvHdr(dILV, ir2, 'ICT LEVELS')
    ir2 += 1
    f_addDashRow(dILV, ir2, 'Zone', ictPd + '  ' + ictKz + (ictPo3 != '' ? '  ' + ictPo3 : ''), ictPd == 'DISC' ? color.green : ictPd == 'PREM' ? color.red : color.gray, ilvSize)
    ir2 += 1
    f_addDashRow(dILV, ir2, 'Draw ▲', f_tgtTxt(_tgtL, _trL, _tsrcL, false), (not na(_trL) and _trL >= tgtMinR) ? color.green : color.gray, ilvSize)
    ir2 += 1
    f_addDashRow(dILV, ir2, 'Draw ▼', f_tgtTxt(_tgtS, _trS, _tsrcS, false), (not na(_trS) and _trS >= tgtMinR) ? color.red : color.gray, ilvSize)
    ir2 += 1

    // nearest pool each side - the one price must clear first
    float _nA = f_pickAbove(close, h1PH, h4PH, _drHi)
    float _nB = f_pickBelow(close, h1PL, h4PL, _drLo)
    f_addDashRow(dILV, ir2, 'Above', f_ilvPx(_nA) + (f_tgtSrc(_nA) != '' ? '  ' + f_tgtSrc(_nA) : ''), color.red, ilvSize)
    ir2 += 1
    f_addDashRow(dILV, ir2, 'EQ 50%', f_ilvPx(_drEq), color.gray, ilvSize)
    ir2 += 1
    f_addDashRow(dILV, ir2, 'Below', f_ilvPx(_nB) + (f_tgtSrc(_nB) != '' ? '  ' + f_tgtSrc(_nB) : ''), color.green, ilvSize)
    ir2 += 1

    // OTE band each side, no sweet-spot rows
    float _rg = _drHi - _drLo
    bool _inB = close <= (_drHi - 0.62 * _rg) and close >= (_drHi - 0.79 * _rg)
    bool _inS = close >= (_drLo + 0.62 * _rg) and close <= (_drLo + 0.79 * _rg)
    f_addDashRow(dILV, ir2, 'OTE buy',  f_ilvPx(_drHi - 0.79 * _rg) + ' – ' + f_ilvPx(_drHi - 0.62 * _rg) + (_inB ? '  ●' : ''), _inB ? color.green : color.gray, ilvSize)
    ir2 += 1
    f_addDashRow(dILV, ir2, 'OTE sell', f_ilvPx(_drLo + 0.62 * _rg) + ' – ' + f_ilvPx(_drLo + 0.79 * _rg) + (_inS ? '  ●' : ''), _inS ? color.red : color.gray, ilvSize)
    ir2 += 1

    if lastSignalState != 0
        float _sp = lastSignalState == 1 ? f_pickBelow(entryP, h1PL, h4PL, _drLo) : f_pickAbove(entryP, h1PH, h4PH, _drHi)
        f_ilvHdr(dILV, ir2, lastSignalState == 1 ? 'PLAN — LONG' : 'PLAN — SHORT')
        ir2 += 1
        f_addDashRow(dILV, ir2, 'Entry', f_ilvPx(entryP), color.blue, ilvSize)
        ir2 += 1
        f_addDashRow(dILV, ir2, 'ICT stop', f_ilvPx(_sp) + (f_tgtSrc(_sp) != '' ? '  ' + f_tgtSrc(_sp) : ''), color.red, ilvSize)
        ir2 += 1
        f_addDashRow(dILV, ir2, 'ICT target', f_tgtTxt(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit), ictTgtHit ? color.green : color.new(color.teal, 0), ilvSize)

//───────────────────────────────────────────────────────────────────────────
// Trade Log table (entry history: Time / Dir / Entry / SL / Result + Day footer)
//───────────────────────────────────────────────────────────────────────────
var table logT = table.new(f_getDashPos(logPosInput), 10, 40, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 70))
if enableSniper and showTradeLog and barstate.islast
    table.clear(logT, 0, 0, 9, 39)
    table.set_position(logT, f_getDashPos(logPosInput))

    // Every checkbox decides its own column, with nothing overriding them.
    // There used to be a 'Trade Log style' input here whose ICT-simple setting
    // silently forced the column set, which made the checkboxes look broken.
    bool _cTime  = logColTime
    bool _cDir   = logColDir
    bool _cGrade = logColGrade
    bool _cEntry = logColEntry
    bool _cSl    = logColSl
    bool _cExit  = logColExit
    bool _cIct   = logColIct
    bool _cInd   = logColInd
    bool _cTgt   = logColTgt

    // dynamic column indices — only Result is permanent
    int _ci = 0
    int idxTime = _cTime ? _ci : -1
    _ci := _cTime ? _ci + 1 : _ci
    int idxDir = _cDir ? _ci : -1
    _ci := _cDir ? _ci + 1 : _ci
    int idxGrd = _cGrade ? _ci : -1
    _ci := _cGrade ? _ci + 1 : _ci
    int idxEntry = _cEntry ? _ci : -1
    _ci := _cEntry ? _ci + 1 : _ci
    int idxSl = _cSl ? _ci : -1
    _ci := _cSl ? _ci + 1 : _ci
    int idxExit = _cExit ? _ci : -1
    _ci := _cExit ? _ci + 1 : _ci
    int idxIct = _cIct ? _ci : -1
    _ci := _cIct ? _ci + 1 : _ci
    int idxInd = _cInd ? _ci : -1
    _ci := _cInd ? _ci + 1 : _ci
    int idxTgt = _cTgt ? _ci : -1
    _ci := _cTgt ? _ci + 1 : _ci
    int idxResult = _ci

    color _hdrBg = color.new(color.black, 0)
    string _logTz = logTz == 'Exchange' ? syminfo.timezone : logTz
    // header row
    f_logCell(logT, idxTime,   0, 'Time',   color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxDir,    0, 'Dir',    color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxGrd,    0, 'Grade',  color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxEntry,  0, 'Entry',  color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxSl,     0, 'SL',     color.white, _hdrBg, logTextSize, text.align_left)   // ADDED
    f_logCell(logT, idxExit,   0, 'Exit',   color.white, _hdrBg, logTextSize, text.align_left)   // ADDED
    f_logCell(logT, idxIct,    0, 'Reason', color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxInd,    0, 'Ind',    color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxTgt,    0, 'ICT tgt', color.white, _hdrBg, logTextSize, text.align_left)
    f_logCell(logT, idxResult, 0, 'Result', color.white, _hdrBg, logTextSize, text.align_right)

    int _r = 1

    // live/open trade pinned at top (not affected by the Log filter)
    if logShowLive and lastSignalState != 0
        string _lres = tradeClosed ? f_tradeResult(slHit, t1Hit, t2Hit, t3Hit, t4Hit, t5Hit) : ('● ' + f_tradeResult(false, t1Hit, t2Hit, t3Hit, t4Hit, false))
        color  _lcol = str.contains(_lres, 'SL') ? color.red : str.contains(_lres, 'TP') ? color.green : color.gray
        f_logCell(logT, idxTime,   _r, str.format_time(entryTime, 'HH:mm', _logTz), color.gray, na, logTextSize, text.align_left)
        f_logCell(logT, idxDir,    _r, lastSignalState == 1 ? 'LONG' : 'SHORT', color.white, lastSignalState == 1 ? color.new(color.green, 20) : color.new(color.red, 20), logTextSize, text.align_left)
        f_logCell(logT, idxGrd,    _r, curGrade, f_grdCol(curGrade), na, logTextSize, text.align_left, f_grdWhy(curGrade))
        f_logCell(logT, idxEntry,  _r, str.tostring(entryP, '#.##'), color.blue, na, logTextSize, text.align_left)
        f_logCell(logT, idxSl,     _r, str.tostring(slP, '#.##') + (slHit ? ' 💣' : ''), color.red, na, logTextSize, text.align_left)   // ADDED
        float _lexit = f_resultPrice(_lres, entryP, slP, lastSignalState)   // ADDED
        f_logCell(logT, idxExit,   _r, na(_lexit) ? '—' : str.tostring(_lexit, '#.##'), _lcol, na, logTextSize, text.align_left)   // ADDED
        f_logCell(logT, idxIct,    _r, curIct, color.new(color.purple, 0), na, logTextSize, text.align_left, f_ictWhy(curIct))
        f_logCell(logT, idxInd,    _r, f_indShort(curInd) + '  ' + curInd, f_indCol(curInd), na, logTextSize, text.align_left, f_indWhy(curInd))
        f_logCell(logT, idxTgt,    _r, f_tgtTxt(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit), ictTgtHit ? color.green : color.new(color.teal, 0), na, logTextSize, text.align_left, f_tgtWhy(curIctTgt, curIctTgtR, curIctTgtS, ictTgtHit))
        f_logCell(logT, idxResult, _r, _lres, _lcol, na, logTextSize, text.align_right)
        _r += 1

    int _n = array.size(logDirArr)
    int _shown = 0
    if _n > 0
        for i = _n - 1 to 0
            if _shown >= logMaxRows
                break
            string _res = array.get(logResArr, i)
            string _gr  = array.get(logGrdArr, i)
            if f_passFilter(_res, logResultFilter) and f_passGrade(_gr, logGradeFilter)
                int   _dir = array.get(logDirArr,   i)
                float _ent = array.get(logEntryArr, i)
                float _sl  = array.get(logSlArr,    i)         // ADDED
                int   _tm  = array.get(logTimeArr,  i)
                color _rc  = str.contains(_res, 'SL') ? color.red : str.contains(_res, 'TP') ? color.green : color.gray
                f_logCell(logT, idxTime,   _r, str.format_time(_tm, 'HH:mm', _logTz), color.gray, na, logTextSize, text.align_left)
                f_logCell(logT, idxDir,    _r, _dir == 1 ? 'LONG' : 'SHORT', _dir == 1 ? color.green : color.red, na, logTextSize, text.align_left)
                f_logCell(logT, idxGrd,    _r, _gr, f_grdCol(_gr), na, logTextSize, text.align_left, f_grdWhy(_gr))
                f_logCell(logT, idxEntry,  _r, str.tostring(_ent, '#.##'), color.black, na, logTextSize, text.align_left)
                f_logCell(logT, idxSl,     _r, str.tostring(_sl, '#.##'), color.red, na, logTextSize, text.align_left)   // ADDED
                float _ex = f_resultPrice(_res, _ent, _sl, _dir)   // ADDED
                f_logCell(logT, idxExit,   _r, na(_ex) ? '—' : str.tostring(_ex, '#.##'), _rc, na, logTextSize, text.align_left)   // ADDED
                string _ic = array.get(logIctArr, i)
                f_logCell(logT, idxIct,    _r, _ic, color.new(color.purple, 0), na, logTextSize, text.align_left, f_ictWhy(_ic))
                string _in = array.get(logIndArr, i)
                f_logCell(logT, idxInd,    _r, f_indShort(_in) + '  ' + _in, f_indCol(_in), na, logTextSize, text.align_left, f_indWhy(_in))
                string _tg = array.get(logTgtArr, i)
                f_logCell(logT, idxTgt,    _r, _tg, str.contains(_tg, '✔') ? color.green : color.new(color.teal, 0), na, logTextSize, text.align_left, 'DRAW ON LIQUIDITY\n\n' + (_tg == '—' ? 'No pool sat on the far side of this entry.' : _tg + '\n\nprice · distance in R · ✔ if reached · which pool\nH1/H4 = swing level, ERL = dealing-range edge,\nPDH-PDL = previous day, PWH-PWL = previous week.\n! = no pool cleared the minimum R.'))
                f_logCell(logT, idxResult, _r, _res, _rc, na, logTextSize, text.align_right)
                _r    += 1
                _shown += 1
    if _shown == 0 and not (logShowLive and lastSignalState != 0)
        table.cell(logT, 0, _r, logResultFilter == 'All' ? 'No trades yet' : 'No trades match filter', text_color = color.gray, text_size = logTextSize, text_halign = text.align_left)
        _r += 1

    // ADDED — Day P/L footer (net realized pips for the current day)
    if logShowDaySum
        // with every optional column off, Result IS column 0 - writing the
        // label there would overwrite the figure it is labelling
        if idxResult > 0
            table.cell(logT, 0,     _r, 'DAY ▸',    text_color = color.white, bgcolor = color.new(color.black, 0), text_size = logTextSize, text_halign = text.align_left)
        table.cell(logT, idxResult, _r, dayPipsStr, text_color = dayPipsCol,  text_size = logTextSize, text_halign = text.align_right)

//───────────────────────────────────────────────────────────────────────────
// DRAW HIT-RATE PANEL
//
// Two questions, answered separately. WHICH POOL pays - an H4 swing and a
// previous-week high are not the same kind of level, and the counts say so.
// HOW FAR is realistic - if the 5R+ row reads 8% over a hundred samples, the
// minimum R is set past what this market delivers, and no amount of filtering
// fixes that.
//
// Read the N column first. A 100% hit rate on N=2 is noise.
//───────────────────────────────────────────────────────────────────────────
f_hrRow(table _t, int _row, string _name, int _slot) =>
    int   _tot = array.get(hrTot, _slot)
    int   _hit = array.get(hrHit, _slot)
    float _pct = _tot > 0 ? (_hit * 100.0) / _tot : na
    table.cell(_t, 0, _row, _name, text_color = color.black, text_halign = text.align_left,  text_size = hrSize)
    table.cell(_t, 1, _row, str.tostring(_tot), text_color = color.gray, text_halign = text.align_right, text_size = hrSize)
    table.cell(_t, 2, _row, na(_pct) ? '—' : str.tostring(_pct, '#') + '%', text_color = na(_pct) ? color.gray : color.white, bgcolor = na(_pct) ? na : (_pct >= 60.0 ? color.new(color.green, 20) : _pct >= 40.0 ? color.new(color.orange, 20) : color.new(color.red, 20)), text_halign = text.align_right, text_size = hrSize)
    true

var table hrT = table.new(f_getDashPos(hrPos), 3, 12, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 70))
if enableSniper and hrOn and hrShowPanel and barstate.islast
    table.clear(hrT, 0, 0, 2, 11)
    table.set_position(hrT, f_getDashPos(hrPos))
    color _hb = color.new(color.black, 0)
    table.cell(hrT, 0, 0, 'DRAW REACHED', text_color = color.white, bgcolor = _hb, text_halign = text.align_left,  text_size = hrSize)
    table.cell(hrT, 1, 0, 'N',            text_color = color.white, bgcolor = _hb, text_halign = text.align_right, text_size = hrSize)
    table.cell(hrT, 2, 0, 'hit',          text_color = color.white, bgcolor = _hb, text_halign = text.align_right, text_size = hrSize)
    f_hrRow(hrT, 1, 'H1 swing',    0)
    f_hrRow(hrT, 2, 'H4 swing',    1)
    f_hrRow(hrT, 3, 'Range edge',  2)
    f_hrRow(hrT, 4, 'Prev day',    3)
    f_hrRow(hrT, 5, 'Prev week',   4)
    table.cell(hrT, 0, 6, 'BY DISTANCE', text_color = color.white, bgcolor = _hb, text_halign = text.align_left,  text_size = hrSize)
    table.cell(hrT, 1, 6, '',            text_color = color.white, bgcolor = _hb, text_size = hrSize)
    table.cell(hrT, 2, 6, '',            text_color = color.white, bgcolor = _hb, text_size = hrSize)
    f_hrRow(hrT, 7,  'under 2R', 5)
    f_hrRow(hrT, 8,  '2 – 3R',   6)
    f_hrRow(hrT, 9,  '3 – 5R',   7)
    f_hrRow(hrT, 10, '5R +',     8)
    table.cell(hrT, 0, 11, 'still open', text_color = color.gray, text_halign = text.align_left,  text_size = hrSize)
    table.cell(hrT, 1, 11, str.tostring(array.size(hrPx)), text_color = color.gray, text_halign = text.align_right, text_size = hrSize)
    table.cell(hrT, 2, 11, '', text_size = hrSize)

//───────────────────────────────────────────────────────────────────────────
// POSITION SIZE PANEL
//
//     lots = risk money / (stop distance x money per price unit per lot)
//
// Everything here is read off the live trade, so the lot shown is for the
// trade on the chart rather than a hypothetical one. Rounded DOWN to the lot
// step, always — rounding up would quietly risk more than you asked for.
//───────────────────────────────────────────────────────────────────────────
var table psT = table.new(f_getDashPos(psPos), 2, 14, bgcolor = color.new(color.white, 8), border_width = 1, border_color = color.new(color.gray, 70))

if enableSniper and psOn and barstate.islast
    table.clear(psT, 0, 0, 1, 13)
    table.set_position(psT, f_getDashPos(psPos))

    bool   _psLive = lastSignalState != 0
    float  _ictStp = _psLive ? (lastSignalState == 1 ? f_pickBelow(entryP, h1PL, h4PL, _drLo) : f_pickAbove(entryP, h1PH, h4PH, _drHi)) : na
    float  _e = psSrc == 'Manual' ? psEntry : (_psLive ? entryP : na)
    float  _s = psSrc == 'Manual' ? psStop  : (_psLive ? (psSrc == 'Live trade — ICT stop' ? _ictStp : slP) : na)
    string _srcTxt = psSrc == 'Manual' ? 'manual' : psSrc == 'Live trade — ICT stop' ? 'ICT stop' : 'ATR stop'

    float _dist  = (na(_e) or na(_s)) ? na : math.abs(_e - _s)
    float _risk$ = psRiskMode == '% of balance' ? psBal * psRiskPct / 100.0 : psRiskAmt
    // money moved by ONE price unit on ONE lot, in the account currency
    float _perLot = psContract * psQuoteRate
    float _rawLot = (na(_dist) or _dist <= 0.0 or _perLot <= 0.0) ? na : _risk$ / (_dist * _perLot)
    // DOWN to the step, then clamped. The epsilon keeps 0.0099999 from
    // floor-ing to zero on a value that is really 0.01.
    float _lot = na(_rawLot) ? na : math.min(psLotMax, math.floor(_rawLot / psLotStep + 0.000000001) * psLotStep)
    bool  _tooSmall = not na(_lot) and _lot < psLotMin
    float _actual$  = na(_lot) ? na : _lot * _dist * _perLot

    color _hb = color.new(color.black, 0)
    table.cell(psT, 0, 0, 'POSITION SIZE', text_color = color.white, bgcolor = _hb, text_halign = text.align_left,  text_size = psSize)
    table.cell(psT, 1, 0, _srcTxt,         text_color = color.white, bgcolor = _hb, text_halign = text.align_right, text_size = psSize)
    f_addDashRow(psT, 1, 'Balance', str.tostring(psBal, '#'), color.gray, psSize)
    f_addDashRow(psT, 2, 'Risk', (psRiskMode == '% of balance' ? str.tostring(psRiskPct, '#.##') + '%  =  ' : '') + str.tostring(_risk$, '#.##'), color.gray, psSize)
    f_addDashRow(psT, 3, 'Entry', na(_e) ? '—' : str.tostring(_e, '#.##'), color.blue, psSize)
    f_addDashRow(psT, 4, 'Stop',  na(_s) ? '—' : str.tostring(_s, '#.##'), color.red, psSize)
    f_addDashRow(psT, 5, 'Stop distance', na(_dist) ? '—' : str.tostring(_dist, '#.##'), color.gray, psSize)
    f_addDashRow(psT, 6, 'Per 1.0 lot / 1.0 move', str.tostring(_perLot, '#.##'), color.gray, psSize)

    table.cell(psT, 0, 7, 'LOT SIZE', text_color = color.white, bgcolor = _hb, text_halign = text.align_left, text_size = psSize)
    table.cell(psT, 1, 7, na(_lot) ? '—' : str.tostring(_lot, '#.##'), text_color = color.white, bgcolor = _tooSmall ? color.new(#f23645, 0) : color.new(#089981, 0), text_halign = text.align_right, text_size = psSize)

    f_addDashRow(psT, 8, 'Risk at stop', na(_actual$) ? '—' : str.tostring(_actual$, '#.##'), _tooSmall ? color.red : color.gray, psSize)
    f_addDashRow(psT, 9, '1R is worth', na(_actual$) ? '—' : str.tostring(_actual$, '#.##'), color.gray, psSize)
    // what the ladder and the draw are worth at this size
    f_addDashRow(psT, 10, 'ATR TP5  (5R)', na(_actual$) ? '—' : '+' + str.tostring(_actual$ * 5.0, '#'), color.green, psSize)
    f_addDashRow(psT, 11, 'ICT target', (na(_actual$) or na(curIctTgtR)) ? '—' : '+' + str.tostring(_actual$ * curIctTgtR, '#') + '  (' + str.tostring(curIctTgtR, '#.#') + 'R)', color.new(color.teal, 0), psSize)

    // The two ways this panel can mislead, said out loud rather than buried.
    string _warn = _tooSmall ? 'stop too wide for this risk' : psQuoteRate == 1.0 and not str.endswith(syminfo.currency, 'USD') ? 'check quote rate' : na(_e) ? 'no trade — use Manual' : 'ok'
    color  _wc   = _tooSmall ? color.red : _warn == 'ok' ? color.gray : color.orange
    f_addDashRow(psT, 12, 'Check', _warn, _wc, psSize)
    f_addDashRow(psT, 13, 'Quote ccy', syminfo.currency + '  × ' + str.tostring(psQuoteRate, '#.######'), color.new(color.gray, 30), psSize)

pFast = plot(enableSniper and showSniperRibbon ? ema9  : na, color = color.new(color.green, 20), title = 'Fast EMA')
pMid  = plot(enableSniper and showSniperRibbon ? ema21 : na, color = color.new(color.red, 20),   title = 'Mid EMA')
pSlow = plot(enableSniper and showSniperRibbon ? ema50 : na, color = color.blue, linewidth = 2,  title = 'Slow EMA')

fill(pFast, pMid, color = (enableSniper and showSniperRibbon) ? (ema9 > ema21 ? color.new(color.green, 100 - ribbonOpacity) : color.new(color.red, 100 - ribbonOpacity)) : na)

barcolor((enableSniper and showSniperTrades) ? ((triggerBuy or triggerSell) ? color.black : (isRetest ? color.orange : na)) : na)

var line lE = na
var line lSL = na
var line lT5 = na
var label lbE   = na
var label lbSL  = na
var label lbT5  = na

if enableSniper and showSniperTrades and tradeDisplayInput != 'Dashboard' and (triggerBuy or triggerSell)
    line.delete(lE)
    line.delete(lSL)
    line.delete(lT5)
    label.delete(lbE)
    label.delete(lbSL)
    label.delete(lbT5)
    int rightMarginX = bar_index + labelOffsetBars
    lE  := line.new(signalBarIdx, entryP, rightMarginX, entryP, color = color.blue,  width = 2, style = line.style_solid)
    lSL := line.new(signalBarIdx, slP,    rightMarginX, slP,    color = color.red,   width = 2, style = line.style_solid)
    lT5 := line.new(signalBarIdx, t5,     rightMarginX, t5,     color = color.green, width = 2, style = line.style_solid)
    lbE  := label.new(rightMarginX, entryP, 'ENTRY: ' + str.tostring(entryP, '#.##'), color = color.blue,  textcolor = color.white, style = label.style_label_left, size = tradeTextSize)
    lbSL := label.new(rightMarginX, slP,    'SL: '    + str.tostring(slP, '#.##'),     color = color.red,   textcolor = color.white, style = label.style_label_left, size = tradeTextSize)
    lbT5 := label.new(rightMarginX, t5,     'TP5: '   + str.tostring(t5, '#.##'),      color = color.green, textcolor = color.white, style = label.style_label_left, size = tradeTextSize)

if enableSniper and showSniperTrades and tradeDisplayInput != 'Dashboard' and lastSignalState != 0
    int targetX = barstate.islast ? (bar_index + labelOffsetBars) : (bar_index + 1)
    line.set_x2(lE, targetX)
    line.set_x2(lSL, targetX)
    line.set_x2(lT5, targetX)
    label.set_x(lbE, targetX)
    label.set_x(lbSL, targetX)
    label.set_text(lbSL, 'SL: ' + str.tostring(slP, '#.##') + (slHit ? ' 💣' : ''))
    label.set_x(lbT5, targetX)
    label.set_text(lbT5, 'TP5: ' + str.tostring(t5, '#.##') + (t5Hit ? ' 🚀' : ''))

plot(enableSniper and showSniperVwap ? vwapV : na, color = close > vwapV ? color.green : color.red, linewidth = 2, title = 'VWAP')

bgcolor(enableSniper and newsShade and newsNow ? newsCss : na, title = 'News window', editable = false)

// ── EXPORT: numeric columns for TradingView's "Export chart data..." ─────
// display.data_window keeps them off the chart and out of the legend, but
// TradingView still writes them into the exported CSV. One row per BAR, blank
// except on the bar a trade was logged.
plot(expPlots ? _xEntry : na, 'exp_entry',  display = display.data_window)
plot(expPlots ? _xStop  : na, 'exp_stop',   display = display.data_window)
plot(expPlots ? _xExit  : na, 'exp_exit',   display = display.data_window)
plot(expPlots ? _xCode  : na, 'exp_code',   display = display.data_window)
plot(expPlots ? _xPips  : na, 'exp_pips',   display = display.data_window)
plot(expPlots ? _xAdx   : na, 'exp_adx',    display = display.data_window)
plot(expPlots ? _xRsi   : na, 'exp_rsi',    display = display.data_window)

alertcondition(enableSniper and triggerBuy,  'Sniper Buy',  'Sniper EMA9/21 bullish cross — BUY')
alertcondition(enableSniper and triggerSell, 'Sniper Sell', 'Sniper EMA9/21 bearish cross — SELL')


//═════════════════════════════════════════════════════════════════════════════
//                    THIRD LAYER  —  ICT Killzones (session shading)
//  Concept from ICT Concepts [LuxAlgo] (CC BY-NC-SA 4.0); reimplemented for v6.
//  Background shading only — uses bgcolor (no boxes/lines, tiny label footprint).
//  Six sessions: New York Open/Close, London Open/Close, Asian Open/Close.
//  Every session has: enable • editable label text • colour • session window • own timezone.
//═════════════════════════════════════════════════════════════════════════════
KZ_GROUP    = 'Killzones (ICT) 🕐'
kzEnable    = input.bool(false, '● Enable Killzones', group = KZ_GROUP, tooltip = 'Shades the ICT killzone sessions in the chart background. Each session has its OWN timezone (below), so daylight-saving is handled automatically and the New York / London / Asian windows always land correctly.')
kzShowNames = input.bool(true, 'Show session names on chart', group = KZ_GROUP, tooltip = 'Prints each session name (editable per session below) at the top of the session as it begins. Only the most recent few per session are kept, to save drawing objects.')
kzShowShade = input.bool(true, 'Shade session background', group = KZ_GROUP, tooltip = 'Paints the killzone window in the chart background. Turn OFF (with session names ON) to mark sessions with just labels, no background colour.')
kzNameSize  = input.string(size.small, 'Session name label size', options = [size.tiny, size.small, size.normal, size.large, size.huge], group = KZ_GROUP, tooltip = 'Font size for the session-name labels printed on the chart.')
kzNameKeep  = input.int(5, 'Session names kept (each)', minval = 1, maxval = 30, group = KZ_GROUP, tooltip = 'How many recent name labels to keep PER session. Lower = fewer label objects used (labels share the 500 cap with SMC/Turtle-Soup layers).')

// ── Vertical open/close lines ────────────────────────────────────────────────
kzShowVlines = input.bool(false, 'Show open/close vertical lines', group = KZ_GROUP, tooltip = 'Draws a vertical line at each session Open and/or Close, in that session colour. Automatically hidden on Daily / Weekly / Monthly charts, because intraday session boundaries do not apply there.')
kzVlineOpen  = input.bool(true,  'Mark Open',  inline = 'kzvl', group = KZ_GROUP)
kzVlineClose = input.bool(true,  'Mark Close', inline = 'kzvl', group = KZ_GROUP)
kzVlineLbl   = input.bool(true,  'Label the vertical lines', group = KZ_GROUP, tooltip = 'Prints the session name at each vertical line: at the top for the Open line, at the bottom for the Close line.')
kzVlineStyle = input.string('Dashed', 'Vertical line style', options = ['Solid','Dashed','Dotted'], group = KZ_GROUP)
kzVlineWidth = input.int(1, 'Vertical line thickness', minval = 1, maxval = 4, group = KZ_GROUP)
kzVlineKeep  = input.int(6, 'Vertical lines kept (each session)', minval = 1, maxval = 40, group = KZ_GROUP, tooltip = 'How many recent open+close lines to keep PER session (shares the 500-line cap with other layers).')


// ── New York Open ────────────────────────────────────────────────────────────
kzShowNyO = input.bool(true,  'New York Open', inline = 'nyo1', group = KZ_GROUP)
kzNyOName = input.string('NY Open', '',        inline = 'nyo1', group = KZ_GROUP)
kzNyOCss  = input.color(color.new(#ff5d00, 80), '', inline = 'nyo1', group = KZ_GROUP)
kzNyOSess = input.session('0700-0900', '',     inline = 'nyo2', group = KZ_GROUP)
kzNyOTz   = input.string('America/New_York', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'nyo2', group = KZ_GROUP, tooltip = 'NY AM killzone. Classic = 07:00-09:00 New York time (auto-DST). Some traders use 08:30-11:00.')

// ── New York Close ───────────────────────────────────────────────────────────
kzShowNyC = input.bool(true,  'New York Close', inline = 'nyc1', group = KZ_GROUP)
kzNyCName = input.string('NY Close', '',         inline = 'nyc1', group = KZ_GROUP)
kzNyCCss  = input.color(color.new(#ffb300, 80), '', inline = 'nyc1', group = KZ_GROUP)
kzNyCSess = input.session('1330-1600', '',       inline = 'nyc2', group = KZ_GROUP)
kzNyCTz   = input.string('America/New_York', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'nyc2', group = KZ_GROUP, tooltip = 'NY PM killzone. Default 13:30-16:00 New York time (auto-DST).')

// ── London Open ──────────────────────────────────────────────────────────────
kzShowLdnO = input.bool(true,  'London Open', inline = 'ldo1', group = KZ_GROUP)
kzLdnOName = input.string('LDN Open', '',     inline = 'ldo1', group = KZ_GROUP)
kzLdnOCss  = input.color(color.new(#00bcd4, 80), '', inline = 'ldo1', group = KZ_GROUP)
kzLdnOSess = input.session('0700-1000', '',   inline = 'ldo2', group = KZ_GROUP)
kzLdnOTz   = input.string('Europe/London', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'ldo2', group = KZ_GROUP, tooltip = 'Read in Europe/London (auto-DST). Classic London Open killzone = 07:00-10:00 London time.')

// ── London Close ─────────────────────────────────────────────────────────────
kzShowLdnC = input.bool(true,  'London Close', inline = 'ldc1', group = KZ_GROUP)
kzLdnCName = input.string('LDN Close', '',      inline = 'ldc1', group = KZ_GROUP)
kzLdnCCss  = input.color(color.new(#2157f3, 80), '', inline = 'ldc1', group = KZ_GROUP)
kzLdnCSess = input.session('1500-1700', '',     inline = 'ldc2', group = KZ_GROUP)
kzLdnCTz   = input.string('Europe/London', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'ldc2', group = KZ_GROUP, tooltip = 'Read in Europe/London (auto-DST). Classic London Close killzone = 15:00-17:00 London time.')

// ── Asian Open ───────────────────────────────────────────────────────────────
kzShowAsO = input.bool(true,  'Asian Open', inline = 'aso1', group = KZ_GROUP)
kzAsOName = input.string('Asia Open', '',    inline = 'aso1', group = KZ_GROUP)
kzAsOCss  = input.color(color.new(#e91e63, 80), '', inline = 'aso1', group = KZ_GROUP)
kzAsOSess = input.session('1000-1200', '',   inline = 'aso2', group = KZ_GROUP)
kzAsOTz   = input.string('Asia/Tokyo', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'aso2', group = KZ_GROUP, tooltip = 'Read in Asia/Tokyo (Japan has no DST). Default first half of the Asian range = 10:00-12:00 Tokyo (~06:30-08:30 IST).')

// ── Asian Close ──────────────────────────────────────────────────────────────
kzShowAsC = input.bool(true,  'Asian Close', inline = 'asc1', group = KZ_GROUP)
kzAsCName = input.string('Asia Close', '',    inline = 'asc1', group = KZ_GROUP)
kzAsCCss  = input.color(color.new(#9c27b0, 80), '', inline = 'asc1', group = KZ_GROUP)
kzAsCSess = input.session('1200-1400', '',    inline = 'asc2', group = KZ_GROUP)
kzAsCTz   = input.string('Asia/Tokyo', '', options = ['America/New_York','Europe/London','Asia/Tokyo','Asia/Kolkata','UTC'], inline = 'asc2', group = KZ_GROUP, tooltip = 'Read in Asia/Tokyo (no DST). Default second half of the Asian range = 12:00-14:00 Tokyo.')

// active-now flags (each read in its own timezone)
kzNyO  = kzEnable and kzShowNyO  and not na(time(timeframe.period, kzNyOSess,  kzNyOTz))
kzNyC  = kzEnable and kzShowNyC  and not na(time(timeframe.period, kzNyCSess,  kzNyCTz))
kzLdnO = kzEnable and kzShowLdnO and not na(time(timeframe.period, kzLdnOSess, kzLdnOTz))
kzLdnC = kzEnable and kzShowLdnC and not na(time(timeframe.period, kzLdnCSess, kzLdnCTz))
kzAsO  = kzEnable and kzShowAsO  and not na(time(timeframe.period, kzAsOSess,  kzAsOTz))
kzAsC  = kzEnable and kzShowAsC  and not na(time(timeframe.period, kzAsCSess,  kzAsCTz))

// session-name label at the top of each session's first bar (own capped registry per call site)
f_kzName(bool active, bool activePrev, string nm, color css) =>
    var array<label> arr = array.new<label>()
    if kzEnable and kzShowNames and active and not activePrev
        arr.push(label.new(bar_index, high, nm, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(css, 15), textcolor = color.white, size = kzNameSize))
        while arr.size() > kzNameKeep
            label.delete(arr.shift())

f_kzVstyle(string s) => s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

// vertical line at a session Open and/or Close (own capped registry per call site).
// Hidden on Daily+ timeframes. Session name shown at top for Open, bottom for Close.
f_kzVline(bool active, bool activePrev, string nm, color css) =>
    var array<line>  vl  = array.new<line>()
    var array<label> vlb = array.new<label>()
    color solidCss = color.new(css, 0)   // session colours carry 80 transparency (for shading); make the line solid
    if kzEnable and kzShowVlines and timeframe.isintraday
        if kzVlineOpen and active and not activePrev
            vl.push(line.new(bar_index, high, bar_index, low, xloc = xloc.bar_index, extend = extend.both, color = solidCss, style = f_kzVstyle(kzVlineStyle), width = kzVlineWidth))
            if kzVlineLbl
                vlb.push(label.new(bar_index, high, nm, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(css, 20), textcolor = color.white, size = kzNameSize))
        if kzVlineClose and not active and activePrev
            vl.push(line.new(bar_index, high, bar_index, low, xloc = xloc.bar_index, extend = extend.both, color = solidCss, style = f_kzVstyle(kzVlineStyle), width = kzVlineWidth))
            if kzVlineLbl
                vlb.push(label.new(bar_index, low, nm, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(css, 20), textcolor = color.white, size = kzNameSize))
        while vl.size() > kzVlineKeep
            line.delete(vl.shift())
        while vlb.size() > kzVlineKeep
            label.delete(vlb.shift())

f_kzName(kzNyO,  kzNyO[1],  kzNyOName,  kzNyOCss)
f_kzName(kzNyC,  kzNyC[1],  kzNyCName,  kzNyCCss)
f_kzName(kzLdnO, kzLdnO[1], kzLdnOName, kzLdnOCss)
f_kzName(kzLdnC, kzLdnC[1], kzLdnCName, kzLdnCCss)
f_kzName(kzAsO,  kzAsO[1],  kzAsOName,  kzAsOCss)
f_kzName(kzAsC,  kzAsC[1],  kzAsCName,  kzAsCCss)

f_kzVline(kzNyO,  kzNyO[1],  kzNyOName,  kzNyOCss)
f_kzVline(kzNyC,  kzNyC[1],  kzNyCName,  kzNyCCss)
f_kzVline(kzLdnO, kzLdnO[1], kzLdnOName, kzLdnOCss)
f_kzVline(kzLdnC, kzLdnC[1], kzLdnCName, kzLdnCCss)
f_kzVline(kzAsO,  kzAsO[1],  kzAsOName,  kzAsOCss)
f_kzVline(kzAsC,  kzAsC[1],  kzAsCName,  kzAsCCss)

bgcolor((kzShowShade and kzNyO)  ? kzNyOCss  : na, title = 'Killzone — New York Open',  editable = false)
bgcolor((kzShowShade and kzNyC)  ? kzNyCCss  : na, title = 'Killzone — New York Close', editable = false)
bgcolor((kzShowShade and kzLdnO) ? kzLdnOCss : na, title = 'Killzone — London Open',    editable = false)
bgcolor((kzShowShade and kzLdnC) ? kzLdnCCss : na, title = 'Killzone — London Close',   editable = false)
bgcolor((kzShowShade and kzAsO)  ? kzAsOCss  : na, title = 'Killzone — Asian Open',     editable = false)
bgcolor((kzShowShade and kzAsC)  ? kzAsCCss  : na, title = 'Killzone — Asian Close',    editable = false)

// optional: shade the chart background while inside a manual news window (Sniper layer)
bgcolor(enableSniper and newsShade and newsNow ? newsCss : na, title = 'News window', editable = false)


//═════════════════════════════════════════════════════════════════════════════
//                    FOURTH LAYER  —  Turtle Soup + Market Structure
//  Engine © mickes (PriceAction library + Turtle soup indicator),
//  Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/)
//  Library inlined (export/library/import scaffolding stripped) and every
//  public type / function PA_-prefixed to avoid clashing with the base
//  LuxAlgo layer (which already owns `pivot`, `trend`, `Pivot()`, etc.),
//  the Sniper layer (owns `atr`) and the HTF layer.
//  Master switch: enableTS (default OFF). HEAVY — consumes boxes/lines/labels.
//═════════════════════════════════════════════════════════════════════════════

// ============================================================================
// --- MASTER TOGGLE + INPUTS ---
// ============================================================================
TS_GROUP        = 'Turtle Soup + Structure 🐢'
enableTS        = input.bool(false, '● Enable Turtle Soup Module', group = TS_GROUP, tooltip = 'Master switch for the mickes PriceAction + Turtle Soup engine (swing market structure, BOS/CHoCH/CHoCH+, equal high/low zones, liquidity $$$ sweeps, and turtle-soup boxes). When OFF nothing renders and the engine stays idle. HEAVY layer — enabling it with SMC order blocks/FVGs + HTF candles can exceed the Pine 500 box/line/label caps.')

TS_MS_GROUP     = 'TS ▸ Market structure'
ts_msLeft       = input.int(5, 'Pivot', inline = 'ts_pivot', group = TS_MS_GROUP)
ts_msRight      = input.int(5, '', inline = 'ts_pivot', group = TS_MS_GROUP, tooltip = 'Set the left and right pivot lengths for the market structure that decides the trend.')
ts_showPivots   = input.bool(true, 'Show pivot labels (H/L/EQ)', group = TS_MS_GROUP)
ts_showBOS      = input.bool(true, 'Show BOS', inline = 'ts_bc', group = TS_MS_GROUP)
ts_showCHoCH    = input.bool(true, 'Show CHoCH', inline = 'ts_bc', group = TS_MS_GROUP)

TS_EQ_GROUP     = 'TS ▸ Equal highs / lows'
ts_showEqual    = input.bool(true, 'Show equal high/low zones', group = TS_EQ_GROUP)
ts_eqFactor     = input.float(10.0, 'Equal factor (% of ATR14)', minval = 0, step = 1, group = TS_EQ_GROUP, tooltip = 'A pivot is "equal" to a previous one if it sits within this fraction (percent) of ATR14 of it.')
ts_eqExtend     = input.bool(false, 'Extend equal zones right', group = TS_EQ_GROUP)
ts_eqColor      = input.color(color.new(color.blue, 0), 'Equal zone color', group = TS_EQ_GROUP)

TS_LIQ_GROUP    = 'TS ▸ Liquidity ($$$)'
ts_showLiq      = input.bool(true, 'Show liquidity sweeps', group = TS_LIQ_GROUP)
ts_liqConfirm   = input.int(3, 'Confirmation bars', minval = 0, group = TS_LIQ_GROUP, tooltip = 'Bars required to confirm a liquidity grab is valid.')
ts_liqLookback  = input.int(5, 'Pivots lookback', minval = 1, group = TS_LIQ_GROUP)

TS_SOUP_GROUP   = 'TS ▸ Turtle soup liquidity'
ts_soupLeft     = input.int(1, 'Pivot', inline = 'ts_soup', group = TS_SOUP_GROUP)
ts_soupRight    = input.int(1, '', inline = 'ts_soup', group = TS_SOUP_GROUP, tooltip = 'Pivot lengths (left/right) that can be a target for a turtle soup.')
ts_soupLookback = input.int(5, 'Lookback (pivots)', group = TS_SOUP_GROUP, tooltip = 'How many pivots back can be a turtle-soup target.')
ts_soupTf       = input.timeframe('', 'Timeframe', group = TS_SOUP_GROUP, tooltip = 'Higher timeframe for pivots that can be a turtle-soup target.')
ts_soupColor    = input.color(color.new(color.orange, 70), 'Color', group = TS_SOUP_GROUP)
ts_soupConfirm  = input.bool(true, 'Confirmation', group = TS_SOUP_GROUP, tooltip = '• ENABLED — the turtle soup must be followed by a CHoCH in the opposite direction.\n\n• DISABLED — all potential turtle soups shown (even wrong-direction ones from HTF fetch lag).')

TS_DISP_GROUP   = 'TS ▸ Display & alerts'
ts_fontSize     = input.int(7, 'Structure font size', group = TS_DISP_GROUP)
ts_alertFreq    = input.string(alert.freq_once_per_bar_close, 'Alert frequency', [alert.freq_all, alert.freq_once_per_bar, alert.freq_once_per_bar_close], group = TS_DISP_GROUP)
ts_alertMS      = input.bool(false, 'Alert BOS/CHoCH', inline = 'ts_al', group = TS_DISP_GROUP)
ts_alertEq      = input.bool(false, 'Alert equal H/L', inline = 'ts_al', group = TS_DISP_GROUP)
ts_screenerKeep = input.int(5, 'Screener keep (bars)', group = TS_DISP_GROUP, tooltip = 'Bars the "Turtle soup" plot stays high after a confirmed soup (for the Pine Screener).')

// ============================================================================
// --- TYPES (inlined from mickes/PriceAction, PA_-prefixed) ---
// ============================================================================
type PA_StructureBreak
    line Line
    label Label

type PA_Pivot
    float Price
    int BarIndex
    int Type // -1 = low, 1 = high
    int Time
    bool BreakOfStructureBroken
    bool LiquidityBroken
    bool ChangeOfCharacterBroken

enum PA_Type
    Internal = 'internal'
    Swing = 'swing'

type PA_Structure
    int LeftLength
    int RightLength
    PA_Type Type
    int Trend // -1 = downtrend, 1 = uptrend
    float EqualPivotsFactor
    bool ExtendEqualPivotsZones
    string ExtendEqualPivotsStyle
    color ExtendEqualPivotsColor
    array<box> EqualHighs
    array<box> EqualLows
    array<PA_StructureBreak> BreakOfStructures
    array<PA_Pivot> Pivots
    int FontSize
    bool AlertChangeOfCharacter
    bool AlertBreakOfStructure
    bool AlerEqualPivots

type PA_Liquidity
    array<PA_Pivot> LiquidityPivotsHigh
    array<PA_Pivot> LiquidityPivotsLow
    int LiquidityConfirmationBars
    int LiquidityPivotsLookback
    int FontSize

type PA_PriceAction
    PA_Liquidity Liquidity
    PA_Structure Swing
    PA_Structure Internal

type PA_TurtleSoupSettings
    int PivotLeftLenght
    int PivotRightLenght
    int Lookback
    bool Confirmation
    color Color
    int ScreenerKeep
    string AlertFrequency

type PA_TurtleSoup
    line Line
    box Box
    int Start
    int End
    PA_Pivot Pivot
    bool Visible
    float Deepest

type PA_Screener
    int TurtleSoupUntilBarIndex

type PA_TurtleSoups
    array<PA_Pivot> Highs
    array<PA_Pivot> Lows
    array<PA_TurtleSoup> Bullish
    array<PA_TurtleSoup> Bearish
    varip array<string> AlertMessages

// ATR used by the equal-zone logic (renamed to avoid the base `atrMeasure` and Sniper `atr`)
pa_atr = ta.atr(14)

// ============================================================================
// --- FUNCTIONS (inlined, export stripped, PA_-prefixed) ---
// ============================================================================
method SetBarIndex(PA_Pivot pivot, int barTime) =>
    barIndex = 0
    i = 0
    while true
        timeBack = time[i]
        if timeBack < barTime or na(timeBack)
            barIndex := bar_index - (i - 1)
            break
        i += 1
    pivot.BarIndex := barIndex

pa_SetBarIndices(PA_Pivot pivotHigh, PA_Pivot pivotLow) =>
    if not na(pivotHigh) and na(pivotHigh.BarIndex)
        pivotHigh.SetBarIndex(pivotHigh.Time)
    if not na(pivotLow) and na(pivotLow.BarIndex)
        pivotLow.SetBarIndex(pivotLow.Time)

pa_alertFire(string message, string frequency) =>
    switch frequency
        alert.freq_all => alert(message, alert.freq_all)
        alert.freq_once_per_bar => alert(message, alert.freq_once_per_bar)
        alert.freq_once_per_bar_close => alert(message, alert.freq_once_per_bar_close)

pa_alertOnce(string message) =>
    alert(message, alert.freq_once_per_bar_close)

pa_TurtleSoupAlert(string message, PA_TurtleSoup turtleSoup, PA_TurtleSoupSettings settings) =>
    direction = switch turtleSoup.Pivot.Type
        -1 => 'bullish'
        1 => 'bearish'
    fullMessage = str.format('{0} ({1} of {2} bars, {3} bars ago and with a pivot from {4} bars ago (from the turtle soup start))', message, direction, turtleSoup.End - turtleSoup.Start, bar_index - turtleSoup.End, turtleSoup.Start - turtleSoup.Pivot.BarIndex)
    fullMessage

pa_AlertContext(PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings) =>
    if turtleSoupsContext.AlertMessages.size() > 0
        pa_alertFire(turtleSoupsContext.AlertMessages.join('\n'), settings.AlertFrequency)
        turtleSoupsContext.AlertMessages.clear()

pa_VisualizeTurtleSoups(array<PA_Pivot> pivots, array<PA_TurtleSoup> turtleSoups, PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings) =>
    reversedPivots = pivots.copy()
    reversedPivots.reverse()
    for pivot in reversedPivots
        if not pivot.LiquidityBroken
            confirmed = switch pivot.Type
                -1 => low > pivot.Price and low[1] <= pivot.Price
                1 => high < pivot.Price and high[1] >= pivot.Price
            if confirmed
                i = 2
                deepest = switch pivot.Type
                    -1 => low[1]
                    1 => high[1]
                while true
                    price = switch pivot.Type
                        -1 => low[i]
                        1 => high[i]
                    swept = switch pivot.Type
                        -1 => price <= pivot.Price
                        1 => price >= pivot.Price
                    if swept
                        i += 1
                        newDeepest = switch pivot.Type
                            -1 => price < deepest
                            1 => price > deepest
                        if newDeepest
                            deepest := price
                    else
                        break
                if i == 2
                    continue
                pivot.LiquidityBroken := true
                start = bar_index - i
                end = bar_index - 1
                boxColor = settings.Confirmation ? na : settings.Color
                lineColor = settings.Confirmation ? na : color.new(settings.Color, 0)
                turtleSoup = PA_TurtleSoup.new(
                  line.new(pivot.Time, pivot.Price, time[1], pivot.Price, xloc = xloc.bar_time, color = lineColor, style = line.style_dotted),
                  box.new(bar_index - i, pivot.Price, bar_index - 1, deepest, border_width = 0, bgcolor = boxColor, text = '🐢', text_color = boxColor),
                  start,
                  end,
                  pivot,
                  settings.Confirmation ? false : true,
                  deepest)
                removeTurtleSoupIndices = array.new<int>()
                for [j, previousTurtleSoup] in turtleSoups
                    if previousTurtleSoup.Start >= turtleSoup.Start and previousTurtleSoup.End <= turtleSoup.End
                        removeTurtleSoupIndices.unshift(j)
                for removeTurtleSoupIndex in removeTurtleSoupIndices
                    removeTurtleSoup = turtleSoups.get(removeTurtleSoupIndex)
                    removeTurtleSoup.Box.set_text('')
                    if turtleSoup.Start > removeTurtleSoup.Start
                        removeTurtleSoup.Line.set_x2(turtleSoup.Start)
                if turtleSoups.size() >= 5
                    turtleSoups.pop()
                turtleSoups.unshift(turtleSoup)
                if not settings.Confirmation
                    turtleSoupsContext.AlertMessages.unshift(pa_TurtleSoupAlert('Turtle soup (NOT confirmed)', turtleSoup, settings))

pa_GetPivots(PA_TurtleSoupSettings settings) =>
    PA_Pivot pivotHigh = na
    PA_Pivot pivotLow = na
    pivotHighPrice = ta.pivothigh(settings.PivotLeftLenght, settings.PivotRightLenght)
    pivotLowPrice = ta.pivotlow(settings.PivotLeftLenght, settings.PivotRightLenght)
    if not na(pivotHighPrice)
        pivotHigh := PA_Pivot.new(pivotHighPrice, Type = 1, Time = time[settings.PivotRightLenght])
    if not na(pivotLowPrice)
        pivotLow := PA_Pivot.new(pivotLowPrice, Type = -1, Time = time[settings.PivotRightLenght])
    [pivotHigh, pivotLow]

pa_SetPivots(PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings, PA_Pivot pivotHigh, PA_Pivot pivotLow) =>
    if not na(pivotHigh)
        if turtleSoupsContext.Highs.size() >= settings.Lookback
            turtleSoupsContext.Highs.pop()
        turtleSoupsContext.Highs.unshift(pivotHigh)
    if not na(pivotLow)
        if turtleSoupsContext.Lows.size() >= settings.Lookback
            turtleSoupsContext.Lows.pop()
        turtleSoupsContext.Lows.unshift(pivotLow)

pa_Confirm(array<PA_TurtleSoup> turtleSoups, PA_TurtleSoups turtleSoupsContext, PA_TurtleSoupSettings settings, int earliest, int latest, PA_Screener screener) =>
    for turtleSoup in turtleSoups
        if not turtleSoup.Visible and turtleSoup.End >= earliest and turtleSoup.End <= latest and turtleSoup.Pivot.BarIndex >= earliest
            turtleSoup.Line.set_color(color.new(settings.Color, 0))
            turtleSoup.Box.set_bgcolor(settings.Color)
            turtleSoup.Box.set_text_color(settings.Color)
            turtleSoup.Visible := true
            turtleSoupsContext.AlertMessages.unshift(pa_TurtleSoupAlert('Turtle soup (confirmed)', turtleSoup, settings))
            screener.TurtleSoupUntilBarIndex := bar_index + settings.ScreenerKeep

pa_Liquidation(PA_Liquidity liquidity, PA_Pivot pivot) =>
    switch pivot.Type
        -1 =>
            if low[liquidity.LiquidityConfirmationBars] <= pivot.Price and close[liquidity.LiquidityConfirmationBars] >= pivot.Price
                if liquidity.LiquidityConfirmationBars > 0
                    confirmed = true
                    for i = liquidity.LiquidityConfirmationBars - 1 to 0
                        if close[i] < pivot.Price
                            confirmed := false
                            break
                    confirmed
                else
                    true
        1 =>
            if high[liquidity.LiquidityConfirmationBars] >= pivot.Price and close[liquidity.LiquidityConfirmationBars] <= pivot.Price
                if liquidity.LiquidityConfirmationBars > 0
                    confirmed = true
                    for i = liquidity.LiquidityConfirmationBars - 1 to 0
                        if close[i] > pivot.Price
                            confirmed := false
                            break
                    confirmed
                else
                    true

method VisualizeLiquidations(array<PA_Pivot> pivots, PA_Liquidity liquidity) =>
    for pivot in pivots
        if bar_index < pivot.BarIndex + liquidity.LiquidityConfirmationBars + 1
            continue
        if not pivot.LiquidityBroken
            if pa_Liquidation(liquidity, pivot)
                limitLine = line.new(pivot.BarIndex, pivot.Price, bar_index - liquidity.LiquidityConfirmationBars, pivot.Price, color = color.orange, style = line.style_dotted)
                breakLine = switch pivot.Type
                    -1 => line.new(pivot.BarIndex, low[liquidity.LiquidityConfirmationBars], bar_index - liquidity.LiquidityConfirmationBars, low[liquidity.LiquidityConfirmationBars], color = na)
                    1 => line.new(pivot.BarIndex, high[liquidity.LiquidityConfirmationBars], bar_index - liquidity.LiquidityConfirmationBars, high[liquidity.LiquidityConfirmationBars], color = na)
                linefill.new(limitLine, breakLine, color.new(color.orange, 80))
                switch pivot.Type
                    -1 => label.new(bar_index - liquidity.LiquidityConfirmationBars - ((bar_index - liquidity.LiquidityConfirmationBars - pivot.BarIndex) / 2), pivot.Price, '$$$', size = liquidity.FontSize, color = color(na), textcolor = color.new(color.orange, 30), style = label.style_label_up)
                    1 => label.new(bar_index - liquidity.LiquidityConfirmationBars - ((bar_index - liquidity.LiquidityConfirmationBars - pivot.BarIndex) / 2), pivot.Price, '$$$', size = liquidity.FontSize, color = color(na), textcolor = color.new(color.orange, 30))
                pivot.LiquidityBroken := true
            else
                switch pivot.Type
                    -1 =>
                        if close < pivot.Price
                            pivot.LiquidityBroken := true
                    1 =>
                        if close > pivot.Price
                            pivot.LiquidityBroken := true

pa_Liqudity(PA_Liquidity liquidity) =>
    if barstate.isconfirmed
        liquidity.LiquidityPivotsHigh.VisualizeLiquidations(liquidity)
        liquidity.LiquidityPivotsLow.VisualizeLiquidations(liquidity)
    pivotHigh = ta.pivothigh(1, 1)
    pivotLow = ta.pivotlow(1, 1)
    if not na(pivotHigh)
        if liquidity.LiquidityPivotsHigh.size() >= liquidity.LiquidityPivotsLookback
            liquidity.LiquidityPivotsHigh.pop()
        liquidity.LiquidityPivotsHigh.unshift(PA_Pivot.new(pivotHigh, bar_index - 1, 1))
    if not na(pivotLow)
        if liquidity.LiquidityPivotsLow.size() >= liquidity.LiquidityPivotsLookback
            liquidity.LiquidityPivotsLow.pop()
        liquidity.LiquidityPivotsLow.unshift(PA_Pivot.new(pivotLow, bar_index - 1, -1))

method BrokenByBar(PA_Pivot pivot) =>
    broken = false
    for i = 1 to bar_index - 1 - pivot.BarIndex
        switch pivot.Type
            1 =>
                if low[i] > pivot.Price
                    broken := true
                    break
            -1 =>
                if high[i] < pivot.Price
                    broken := true
                    break
    broken

method BrokenByBarZone(box zone, int type) =>
    broken = false
    for i = 1 to bar_index - 1 - zone.get_left()
        switch type
            1 =>
                if low[i] > zone.get_top()
                    broken := true
                    break
            -1 =>
                if high[i] < zone.get_bottom()
                    broken := true
                    break
    broken

pa_InLimits(float highLimit, float lowLimit, float price) =>
    price >= lowLimit and price <= highLimit

pa_Pivot(PA_Structure structure) =>
    pivotHigh = ta.pivothigh(structure.LeftLength, structure.RightLength)
    pivotLow = ta.pivotlow(structure.LeftLength, structure.RightLength)
    if not na(pivotHigh)
        if structure.Pivots.size() > 5
            structure.Pivots.pop()
        structure.Pivots.unshift(PA_Pivot.new(pivotHigh, bar_index - structure.RightLength, 1, time[structure.RightLength]))
    if not na(pivotLow)
        if structure.Pivots.size() > 5
            structure.Pivots.pop()
        structure.Pivots.unshift(PA_Pivot.new(pivotLow, bar_index - structure.RightLength, -1, time[structure.RightLength]))

pa_PivotLabels(PA_Structure structure) =>
    txt = ''
    for pivot in structure.Pivots
        if pivot.BarIndex == bar_index - structure.RightLength
            for i = 1 to structure.Pivots.size() - 1
                if structure.Pivots.size() == 1
                    break
                previousPivot = structure.Pivots.get(i)
                if previousPivot.Type != pivot.Type or previousPivot.BarIndex == pivot.BarIndex
                    continue
                if pivot.Price == previousPivot.Price
                    txt := 'EQ'
                else if pivot.Price > previousPivot.Price
                    txt := 'H'
                else if pivot.Price < previousPivot.Price
                    txt := 'L'
                break
            transparency = switch structure.Type
                PA_Type.Internal => 60
                PA_Type.Swing => 20
            switch pivot.Type
                -1 => txt += 'L', label.new(pivot.BarIndex, pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.teal, transparency), style = label.style_label_up)
                1 => txt += 'H', label.new(pivot.BarIndex, pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.red, transparency))

pa_EqualHighOrLow(PA_Structure structure) =>
    retestHigh = high < high[1] and high[1] > high[2]
    retestLow = low > low[1] and low[1] < low[2]
    if retestHigh
        for equalPivot in structure.EqualHighs
            price = high[1]
            lowLimit = equalPivot.get_bottom() - (pa_atr * (structure.EqualPivotsFactor / 100.))
            highLimit = equalPivot.get_top()
            if pa_InLimits(highLimit, lowLimit, price)
                if not equalPivot.BrokenByBarZone(1)
                    if price < equalPivot.get_bottom()
                        equalPivot.set_rightbottom(bar_index - 1, price)
                    else
                        equalPivot.set_right(bar_index - 1)
                        equalPivot.set_top(price)
                    label.new(bar_index - 1, price, style = structure.ExtendEqualPivotsStyle, size = structure.FontSize, color = color.new(structure.ExtendEqualPivotsColor, 70))
                    if structure.AlerEqualPivots
                        pa_alertOnce('Added bar to existing equal high')
    if retestLow
        for equalPivot in structure.EqualLows
            price = low[1]
            lowLimit = equalPivot.get_bottom()
            highLimit = equalPivot.get_top() + (pa_atr * (structure.EqualPivotsFactor / 100.))
            if pa_InLimits(highLimit, lowLimit, price)
                if not equalPivot.BrokenByBarZone(-1)
                    if price < equalPivot.get_bottom()
                        equalPivot.set_rightbottom(bar_index - 1, price)
                    else
                        equalPivot.set_right(bar_index - 1)
                        equalPivot.set_top(price)
                    label.new(bar_index - 1, price, style = structure.ExtendEqualPivotsStyle, size = structure.FontSize, color = color.new(structure.ExtendEqualPivotsColor, 70))
                    if structure.AlerEqualPivots
                        pa_alertOnce('Added bar to existing equal low')
    for pivot in structure.Pivots
        price = 0., lowLimit = 0., highLimit = 0.
        switch pivot.Type
            -1 =>
                if not retestLow
                    continue
                price := low[1]
                lowLimit := pivot.Price
                highLimit := pivot.Price + (pa_atr * (structure.EqualPivotsFactor / 100.))
            1 =>
                if not retestHigh
                    continue
                price := high[1]
                lowLimit := pivot.Price - (pa_atr * (structure.EqualPivotsFactor / 100.))
                highLimit := pivot.Price
        if pa_InLimits(highLimit, lowLimit, price)
            if not pivot.BrokenByBar()
                left = pivot.BarIndex, right = bar_index - 1, top = math.max(price, pivot.Price), bottom = math.min(price, pivot.Price)
                exactSamePivotPrice = pivot.Price == price
                equalPivotsBox = box.new(left, top, right, bottom, bgcolor = color.new(structure.ExtendEqualPivotsColor, 70), text = 'Equal low', text_color = structure.ExtendEqualPivotsColor, border_width = exactSamePivotPrice ? 1 : 0, border_color = structure.ExtendEqualPivotsColor, extend = structure.ExtendEqualPivotsZones ? extend.right : extend.none)
                label.new(bar_index - 1, price, size = structure.FontSize, style = structure.ExtendEqualPivotsStyle, color = color.new(structure.ExtendEqualPivotsColor, 70))
                label.new(pivot.BarIndex, pivot.Price, size = structure.FontSize, style = structure.ExtendEqualPivotsStyle, color = color.new(structure.ExtendEqualPivotsColor, 70))
                switch pivot.Type
                    -1 =>
                        equalPivotsBox.set_text('Equal low')
                        structure.EqualLows.unshift(equalPivotsBox)
                        if structure.AlerEqualPivots
                            pa_alertOnce('Equal low appeared')
                    1 =>
                        equalPivotsBox.set_text('Equal high')
                        structure.EqualHighs.unshift(equalPivotsBox)
                        if structure.AlerEqualPivots
                            pa_alertOnce('Equal high appeared')

pa_BreakOfStructure(PA_Structure structure) =>
    var alerMessageFormat = 'BOS on {0} on {1} market structure'
    PA_Pivot breakOfStructureOccured = na
    lineStyle = switch structure.Type
        PA_Type.Swing => line.style_solid
        PA_Type.Internal => line.style_dashed
    for pivot in structure.Pivots
        if structure.Trend == 1 and pivot.Type == 1 and close > pivot.Price and not pivot.BreakOfStructureBroken
            create = true
            for breakOfStructure in structure.BreakOfStructures
                barIndex = breakOfStructure.Line.get_x1()
                if barIndex > pivot.BarIndex
                    price = breakOfStructure.Line.get_y1()
                    if price < pivot.Price
                        breakOfStructure.Line.delete()
                        breakOfStructure.Label.delete()
                    else
                        create := false
                        break
            if create
                structure.BreakOfStructures.unshift(PA_StructureBreak.new(
                  line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.teal, style = lineStyle),
                  label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, 'BOS', size = structure.FontSize, color = color(na), textcolor = color.new(color.teal, 30))))
                pivot.BreakOfStructureBroken := true
                switch structure.Type
                    PA_Type.Internal =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'an uptrend', 'internal'))
                    PA_Type.Swing =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'an uptrend', 'swing'))
                breakOfStructureOccured := pivot
                break
        else if structure.Trend == -1 and pivot.Type == -1 and close < pivot.Price and not pivot.BreakOfStructureBroken
            create = true
            for breakOfStructure in structure.BreakOfStructures
                barIndex = breakOfStructure.Line.get_x1()
                if barIndex > pivot.BarIndex
                    price = breakOfStructure.Line.get_y1()
                    if price > pivot.Price
                        breakOfStructure.Line.delete()
                        breakOfStructure.Label.delete()
                    else
                        create := false
                        break
            if create
                structure.BreakOfStructures.unshift(PA_StructureBreak.new(
                  line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.red, style = lineStyle),
                  label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, 'BOS', size = structure.FontSize, color = color(na), textcolor = color.new(color.red, 30), style = label.style_label_up)))
                pivot.BreakOfStructureBroken := true
                switch structure.Type
                    PA_Type.Internal =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'a downtrend', 'internal'))
                    PA_Type.Swing =>
                        if structure.AlertBreakOfStructure
                            pa_alertOnce(str.format(alerMessageFormat, 'a downtrend', 'swing'))
                breakOfStructureOccured := pivot
                break
    breakOfStructureOccured

pa_ChangeOfCharacter(PA_Structure structure) =>
    var alerMessageFormat = '{0} to {1} on {2} market structure'
    PA_Pivot changeOfCharacterOccured = na
    lineStyle = switch structure.Type
        PA_Type.Internal => line.style_dashed
        PA_Type.Swing => line.style_solid
    for pivot in structure.Pivots
        if structure.Trend <= 0 and pivot.Type == 1 and close > pivot.Price and close[1] < pivot.Price and not(pivot.ChangeOfCharacterBroken)
            pivot.ChangeOfCharacterBroken := true
            txt = 'CHoCH'
            if structure.Pivots.size() >= 2 and structure.Trend != 0
                for i = 0 to structure.Pivots.size() - 2
                    latestPivot = structure.Pivots.get(i)
                    if latestPivot.Type == -1
                        for j = i + 1 to structure.Pivots.size() - 2
                            nextLatestPivot = structure.Pivots.get(j)
                            if nextLatestPivot.Type == -1
                                if latestPivot.Price > nextLatestPivot.Price
                                    txt := 'CHoCH+'
                                break
                        break
            line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.teal, style = lineStyle)
            label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.teal, 30))
            structure.Trend := 1
            structure.EqualHighs.clear(), structure.EqualLows.clear()
            structure.BreakOfStructures.clear()
            remove = array.new<int>()
            for [i, p] in structure.Pivots
                if p.BarIndex <= pivot.BarIndex
                    remove.push(i)
                else
                    p.BreakOfStructureBroken := true
            for [i, r] in remove
                structure.Pivots.remove(r - i)
            for p in structure.Pivots
                if p.BarIndex != pivot.BarIndex
                    p.ChangeOfCharacterBroken := false
            switch structure.Type
                PA_Type.Internal =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'an uptrend', 'internal'))
                PA_Type.Swing =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'an uptrend', 'swing'))
            changeOfCharacterOccured := pivot
            break
        else if structure.Trend >= 0 and pivot.Type == -1 and close < pivot.Price and close[1] > pivot.Price and not(pivot.ChangeOfCharacterBroken)
            pivot.ChangeOfCharacterBroken := true
            txt = 'CHoCH'
            if structure.Pivots.size() >= 2 and structure.Trend != 0
                for i = 0 to structure.Pivots.size() - 2
                    latestPivot = structure.Pivots.get(i)
                    if latestPivot.Type == 1
                        for j = i + 1 to structure.Pivots.size() - 2
                            nextLatestPivot = structure.Pivots.get(j)
                            if nextLatestPivot.Type == 1
                                if latestPivot.Price < nextLatestPivot.Price
                                    txt := 'CHoCH+'
                                break
                        break
            line.new(pivot.BarIndex, pivot.Price, bar_index, pivot.Price, color = color.red, style = lineStyle)
            label.new(bar_index - ((bar_index - pivot.BarIndex) / 2), pivot.Price, txt, size = structure.FontSize, color = color(na), textcolor = color.new(color.red, 30), style = label.style_label_up)
            structure.Trend := -1
            structure.EqualHighs.clear(), structure.EqualLows.clear()
            structure.BreakOfStructures.clear()
            remove = array.new<int>()
            for [i, p] in structure.Pivots
                if p.BarIndex <= pivot.BarIndex
                    remove.push(i)
                else
                    p.BreakOfStructureBroken := true
            for [i, r] in remove
                structure.Pivots.remove(r - i)
            for p in structure.Pivots
                if p.BarIndex != pivot.BarIndex
                    p.ChangeOfCharacterBroken := false
            switch structure.Type
                PA_Type.Internal =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'a downtrend', 'internal'))
                PA_Type.Swing =>
                    if structure.AlertChangeOfCharacter
                        pa_alertOnce(str.format(alerMessageFormat, txt, 'a downtrend', 'swing'))
            changeOfCharacterOccured := pivot
            break
    changeOfCharacterOccured

// ============================================================================
// --- STATE (var-initialised once) ---
// ============================================================================
var PA_PriceAction ts_priceAction = PA_PriceAction.new(Swing = PA_Structure.new(ts_msLeft, ts_msRight, PA_Type.Swing, 0, ts_eqFactor, ts_eqExtend, label.style_label_down, ts_eqColor, array.new<box>(), array.new<box>(), array.new<PA_StructureBreak>(), array.new<PA_Pivot>(), ts_fontSize, ts_alertMS, ts_alertMS, ts_alertEq))
var PA_Liquidity ts_liquidity = PA_Liquidity.new(array.new<PA_Pivot>(), array.new<PA_Pivot>(), ts_liqConfirm, ts_liqLookback, ts_fontSize)
var PA_TurtleSoupSettings ts_settings = PA_TurtleSoupSettings.new(ts_soupLeft, ts_soupRight, ts_soupLookback, ts_soupConfirm, ts_soupColor, ts_screenerKeep, ts_alertFreq)
var PA_TurtleSoups ts_context = PA_TurtleSoups.new(array.new<PA_Pivot>(), array.new<PA_Pivot>(), array.new<PA_TurtleSoup>(), array.new<PA_TurtleSoup>(), array.new<string>())
var PA_Screener ts_screener = PA_Screener.new()

// ============================================================================
// --- HTF pivots fetched UNCONDITIONALLY (request.security cannot be gated) ---
// ============================================================================
[ts_pivotHigh, ts_pivotLow] = request.security(syminfo.tickerid, ts_soupTf, pa_GetPivots(ts_settings))

// ============================================================================
// --- EXECUTION (gated by enableTS) ---
// ============================================================================
var int ts_previousStructureBreakBarIndex = na

if enableTS
    // market-structure pivots + labels
    pa_Pivot(ts_priceAction.Swing)
    if ts_showPivots
        pa_PivotLabels(ts_priceAction.Swing)

    // turtle soups on confirmed bars
    if barstate.isconfirmed
        pa_VisualizeTurtleSoups(ts_context.Highs, ts_context.Bearish, ts_context, ts_settings)
        pa_VisualizeTurtleSoups(ts_context.Lows, ts_context.Bullish, ts_context, ts_settings)

    // structure breaks
    ts_choch = false
    ts_bos   = false
    if barstate.isconfirmed
        if ts_showCHoCH
            ts_choch := not na(pa_ChangeOfCharacter(ts_priceAction.Swing))
        if ts_showBOS
            ts_bos := not na(pa_BreakOfStructure(ts_priceAction.Swing))

    // confirmed turtle-soup validation
    if ts_settings.Confirmation
        if ts_choch and not na(ts_previousStructureBreakBarIndex)
            switch ts_priceAction.Swing.Trend
                -1 => pa_Confirm(ts_context.Bearish, ts_context, ts_settings, ts_previousStructureBreakBarIndex, bar_index, ts_screener)
                1  => pa_Confirm(ts_context.Bullish, ts_context, ts_settings, ts_previousStructureBreakBarIndex, bar_index, ts_screener)
        if ts_choch or ts_bos
            ts_previousStructureBreakBarIndex := bar_index

    // equal high/low zones
    if ts_showEqual
        pa_EqualHighOrLow(ts_priceAction.Swing)

    // liquidity sweeps ($$$)
    if ts_showLiq
        pa_Liqudity(ts_liquidity)

    // register HTF soup pivots
    pa_SetBarIndices(ts_pivotHigh, ts_pivotLow)
    pa_SetPivots(ts_context, ts_settings, ts_pivotHigh, ts_pivotLow)

    // fire queued alerts
    pa_AlertContext(ts_context, ts_settings)

// Pine Screener plot (kept outside the gate — plot() must be top-level)
plot(enableTS and bar_index <= ts_screener.TurtleSoupUntilBarIndex ? 1 : 0, 'Turtle soup', display = display.none, precision = 0)
