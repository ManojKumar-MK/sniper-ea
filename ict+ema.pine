indicator('ICT Suite [SMC + Sniper + HTF + TS + OTE + SFP + ICT extras]', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 5000)
//═════════════════════════════════════════════════════════════════════════════
//                            BASE LAYER  —  LuxAlgo SMC
