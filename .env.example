# Copy to .env and fill in. .env is gitignored - never commit it, never paste
# these into a chat or put them on a command line (shell history keeps them).
#
# Angel One SmartAPI - all four are required for backtest/paper/live.
# API key:  smartapi.angelbroking.com -> My Apps -> Create App (Trading APIs)
# Client:   your Angel One account number
# PIN:      your Angel One login PIN
# TOTP:     My Profile -> External TOTP. Shown ONCE when you scan the QR;
#           if you did not save it you must reset TOTP to get a new one.
ANGEL_API_KEY=
ANGEL_CLIENT=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Telegram - not needed for backtest, required for paper/live
TG_TOKEN=
TG_CHAT=
